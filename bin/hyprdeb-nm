#!/usr/bin/env bash
# hyprdeb managed: root helper for the ifupdown -> NetworkManager switch. Installed to /usr/local/sbin by
# `./install.sh --networkmanager`; not meant for daily use.
#
#   hyprdeb-nm switch IFACE MINUTES   move IFACE from ifupdown (dhcpcd) to NetworkManager. The rollback timer is armed FIRST
#                                     (MINUTES, 0 = no timer); if the checks after the switch fail, it rolls back by itself.
#   hyprdeb-nm rollback               undo it: restore /etc/network/interfaces, disable NetworkManager, bring IFACE up with ifupdown (networking.service)
#
# A long-lived daemon must never be started as a child of a transient unit: systemd kills what is left in the unit's cgroup when
# the unit ends (that killed dhcpcd after the first rollback test). So nothing here starts one: the daemons are started by their own units
# (NetworkManager.service, networking.service, which owns dhcpcd).
# Runs as its own systemd unit (started by install.sh through systemd-run), so a dropped ssh session does not interrupt it.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
STATE=/var/lib/hyprdeb/nm-migration
IFACES=/etc/network/interfaces
BAK=/etc/network/interfaces.hyprdeb-pre-nm
PROFILE_DIR=/etc/NetworkManager/system-connections
TIMER=hyprdeb-nm-rollback
MARK='# hyprdeb managed (NetworkManager)'

say() { printf 'hyprdeb-nm: %s\n' "$*"; }
ipv4() { ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk '{print $4; exit}'; }          # 192.0.2.10/24
gateway() { ip -4 route show default dev "$1" 2>/dev/null | awk '{print $3; exit}'; }
nameservers() { awk '$1=="nameserver" {print $2}' /etc/resolv.conf 2>/dev/null | paste -sd' '; }
# True when dhcpcd runs and every one of its processes lives in networking.service (i.e. not in the transient unit that ran this script).
dhcpcd_owned() { local p n=0; for p in $(pgrep -x dhcpcd); do n=$((n+1)); grep -q 'networking.service' "/proc/$p/cgroup" 2>/dev/null || return 1; done; [ "$n" -gt 0 ]; }
resolv_writer() { sed -n 's/^# Generated by \([A-Za-z]*\).*/\1/p' /etc/resolv.conf 2>/dev/null | head -1; }

# Wait up to 30 s for IFACE to have an IPv4 address (the same one as WANT when given) and a gateway that answers ping.
verify() {
  local iface=$1 want=${2:-} i got g
  for i in $(seq 1 30); do
    got="$(ipv4 "$iface")"; g="$(gateway "$iface")"
    if [ -n "$got" ] && { [ -z "$want" ] || [ "$got" = "$want" ]; } && [ -n "$g" ] && ping -c1 -W1 "$g" >/dev/null 2>&1; then
      say "OK: $iface has $got, gateway $g answers"; return 0
    fi
    sleep 1
  done
  say "CHECK FAILED on $iface: wanted ${want:-any address}, have '${got:-none}', gateway '${g:-none}'"
  return 1
}

# Comment out the auto / allow-* / iface stanza of IFACE (and its indented options) and append the marker. lo and the rest stay.
edit_interfaces() {
  local iface=$1 tmp
  tmp="$(mktemp)"
  awk -v ifc="$iface" '
    function kw(l) { return l ~ /^[ \t]*(auto|allow-[a-z-]+|iface|mapping|source|source-directory|source-line|no-auto-down|no-scripts)([ \t]|$)/ }
    { line = $0
      if (instanza && (line ~ /^[ \t]*$/ || kw(line))) instanza = 0
      if (line ~ ("^[ \t]*(auto|allow-[a-z-]+)[ \t]+" ifc "[ \t]*$")) { print "#hyprdeb-nm# " line; next }
      if (line ~ ("^[ \t]*iface[ \t]+" ifc "[ \t]")) { instanza = 1; print "#hyprdeb-nm# " line; next }
      if (instanza && line !~ /^[ \t]*$/) { print "#hyprdeb-nm# " line; next }
      print line }' "$IFACES" > "$tmp" || { rm -f "$tmp"; return 1; }
  printf '\n%s: %s is managed by NetworkManager (install.sh --networkmanager).\n# The original file is %s; undo with: hyprdeb-nm rollback\n' "$MARK" "$iface" "$BAK" >> "$tmp"
  cat "$tmp" > "$IFACES"      # keeps owner and mode of the original file
  rm -f "$tmp"
}

switch() {
  local iface=${1:-} min=${2:-10} before dns_before dns_after d ok=0
  [ -n "$iface" ] && [ -d "/sys/class/net/$iface" ] || { say "no such interface: '$iface'"; return 2; }
  [ -f "$PROFILE_DIR/hyprdeb-$iface.nmconnection" ] || { say "profile $PROFILE_DIR/hyprdeb-$iface.nmconnection is missing"; return 2; }
  command -v nmcli >/dev/null || { say "nmcli is not installed"; return 2; }
  if grep -q "^$MARK" "$IFACES"; then say "$IFACES is already switched"; return 2; fi
  grep -Eq "^[[:space:]]*iface[[:space:]]+$iface[[:space:]]+inet[[:space:]]+dhcp" "$IFACES" || { say "no 'iface $iface inet dhcp' in $IFACES: only DHCP uplinks are supported"; return 2; }
  before="$(ipv4 "$iface")"
  [ -n "$before" ] || { say "$iface has no IPv4 address now: refusing to switch"; return 2; }
  mkdir -p "$(dirname "$STATE")"
  dns_before="$(nameservers)"
  [ -n "$dns_before" ] || { say "/etc/resolv.conf has no nameserver now ($(resolv_writer)): refusing to switch"; return 2; }
  printf 'IFACE=%s\nBEFORE=%s\n' "$iface" "$before" > "$STATE"
  if [ "$min" -gt 0 ] 2>/dev/null; then
    systemctl stop "$TIMER.timer" "$TIMER.service" 2>/dev/null
    systemd-run --quiet --unit="$TIMER" --on-active="${min}m" --description="hyprdeb: roll back to ifupdown" \
      /usr/local/sbin/hyprdeb-nm rollback || { say "could not arm the rollback timer: nothing changed"; return 2; }
    say "rollback timer armed: in $min min the old setup comes back unless it is stopped (systemctl stop $TIMER.timer)"
  else
    say "WARNING: no rollback timer"
  fi
  cp -p "$IFACES" "$BAK" || { say "could not back up $IFACES: nothing changed"; return 2; }
  say "1/5 ifdown $iface (the address is gone for a few seconds)"
  if ifquery --state "$iface" >/dev/null 2>&1; then ifdown "$iface" || say "ifdown reported an error (continuing)"; fi
  say "2/5 take $iface out of $IFACES (original kept in $BAK)"
  edit_interfaces "$iface" || { say "editing failed"; rollback; return 1; }
  say "3/5 enable and restart NetworkManager"
  systemctl enable NetworkManager.service NetworkManager-wait-online.service >/dev/null 2>&1
  systemctl restart NetworkManager.service || { say "NetworkManager did not start"; rollback; return 1; }
  for _ in $(seq 1 20); do nmcli -t -f RUNNING general 2>/dev/null | grep -q running && break; sleep 0.5; done
  say "4/5 activate hyprdeb-$iface (the link first: the NIC renegotiates after ifdown, about 12 s on a 100 Mb/s port)"
  nmcli connection reload
  for _ in $(seq 1 30); do [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" = 1 ] && break; sleep 1; done
  if ! nmcli -w 30 connection up "hyprdeb-$iface" >/dev/null 2>&1; then
    # On the PC the first `up` came back with an error while the link was still down; NetworkManager's autoconnect then did the job
    st="$(nmcli -g GENERAL.STATE device show "$iface" 2>/dev/null)"
    case "$st" in
      100*|4*|5*|7*|8*|9*) say "nmcli up returned an error, but $iface is already '$st': NetworkManager's autoconnect took over (harmless)" ;;
      *) say "nmcli up reported an error (device state: ${st:-unknown}); the checks below decide" ;;
    esac
  fi
  say "5/5 check: same address as before ($before) and the gateway answers"
  if verify "$iface" "$before"; then
    # resolv.conf must now be written by NetworkManager and still list the DHCP DNS server(s) dhcpcd had
    for _ in $(seq 1 10); do
      dns_after="$(nameservers)"
      for d in $dns_before; do [[ " $dns_after " == *" $d "* ]] && ok=1; done
      [ "$ok" = 1 ] && break
      sleep 1
    done
    if [ "$ok" = 1 ]; then
      say "OK: /etc/resolv.conf ($(resolv_writer)) lists: $dns_after"
      getent ahostsv4 debian.org >/dev/null 2>&1 && say "OK: debian.org resolves" || say "WARNING: debian.org does not resolve (DNS server answering?)"
      say "switched; NetworkManager now manages $iface"
      return 0
    fi
    say "CHECK FAILED: /etc/resolv.conf lists '${dns_after:-nothing}', expected one of: $dns_before"
  fi
  say "rolling back now"
  rollback
  return 1
}

rollback() {
  local IFACE="" BEFORE=""
  [ -f "$STATE" ] && . "$STATE"
  [ -n "$IFACE" ] || { say "no migration state in $STATE: nothing to roll back"; return 1; }
  say "rolling $IFACE back to ifupdown"
  [ -f "$BAK" ] && cp -p "$BAK" "$IFACES" || say "WARNING: $BAK is missing, $IFACES left as it is"
  nmcli device disconnect "$IFACE" >/dev/null 2>&1
  systemctl disable --now NetworkManager-wait-online.service NetworkManager.service >/dev/null 2>&1
  rm -f "$PROFILE_DIR/hyprdeb-$IFACE.nmconnection"
  ip -4 addr flush dev "$IFACE" scope global 2>/dev/null
  # ifupdown's own unit starts dhcpcd (ifup from here would make it a child of this transient unit, and it would die with it)
  systemctl restart networking.service || say "restarting networking.service reported an error (checking anyway)"
  verify "$IFACE"
  local rc=$? w=""
  for _ in $(seq 1 15); do w="$(resolv_writer)"; [ "$w" = dhcpcd ] && break; sleep 1; done
  if [ "$w" = dhcpcd ]; then say "OK: /etc/resolv.conf is written by dhcpcd again: $(nameservers)"
  else say "CHECK FAILED: /etc/resolv.conf is written by '${w:-nobody}', not dhcpcd (sudo systemctl restart networking.service rewrites it)"; rc=1; fi
  if dhcpcd_owned; then say "OK: dhcpcd ($(pgrep -x dhcpcd | wc -l) processes) belongs to networking.service, not to this unit"
  else say "CHECK FAILED: dhcpcd is not running under networking.service: sudo systemctl restart networking.service"; rc=1; fi
  [ "$(ipv4 "$IFACE")" = "$BEFORE" ] || say "note: the address is not the one before the migration ($BEFORE)"
  rm -f "$STATE"
  systemctl stop "$TIMER.timer" 2>/dev/null
  say "rollback finished (rc=$rc); NetworkManager stays installed but disabled"
  return $rc
}

case "${1:-}" in
  switch) shift; switch "$@" ;;
  rollback) rollback ;;
  *) sed -n '2,/^set -u/p' "$0" | sed '$d'; exit 2 ;;
esac
