class SettingsError(Exception):
    pass


def lua_str(s):
    out = []
    for ch in s:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ord(ch) < 32 or ord(ch) == 127:
            raise SettingsError("control characters are not allowed in strings")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def lua_num(x):
    return repr(x) if isinstance(x, float) else str(x)


def load(path, explicit):
    if not os.path.exists(path):
        if explicit:
            raise SettingsError(f"{path}: no such file")
        return {}
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise SettingsError(f"{path}: invalid TOML: {e}")
    except OSError as e:
        raise SettingsError(f"{path}: {e}")


# ---------------------------------------------------------------- validation

def parse_duration(v, where):
    """'off' -> None, '90s' / '10m' / '1h' -> seconds."""
    if not isinstance(v, str):
        raise SettingsError(f"{where}: must be \"off\" or a duration like \"90s\", \"10m\", \"1h\", got {v!r}")
    if v == "off":
        return None
    m = DURATION_RE.match(v)
    if not m:
        raise SettingsError(f"{where}: must be \"off\" or a duration like \"90s\", \"10m\", \"1h\", got {v!r}")
    secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600}[m.group(2)]
    if secs < MIN_IDLE_SECONDS:
        raise SettingsError(f"{where}: {v!r} is shorter than the minimum of {MIN_IDLE_SECONDS}s")
    return secs


def xkb_tables():
    """(layouts, {layout: set(variants)}) from evdev.lst; SettingsError when it cannot be read (reject, not guess)."""
    try:
        with open(XKB_LST, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError as e:
        raise SettingsError(f"cannot validate keyboard layouts offline: {XKB_LST}: {e}")
    layouts, variants, sec = set(), {}, None
    for line in lines:
        if line.startswith("! "):
            sec = line[2:].strip()
            continue
        if not line.startswith("  "):
            continue
        parts = line.split(None, 2)
        if sec == "layout" and parts:
            layouts.add(parts[0])
        elif sec == "variant" and len(parts) >= 2 and parts[1].endswith(":"):
            variants.setdefault(parts[1][:-1], set()).add(parts[0])
    if not layouts:
        raise SettingsError(f"cannot validate keyboard layouts offline: no layouts found in {XKB_LST}")
    return layouts, variants


def validate_keyboard(kb):
    layouts_ok, variants_ok = xkb_tables()
    for k in ("layouts", "variants"):
        if k in kb and (not isinstance(kb[k], list) or not all(isinstance(x, str) for x in kb[k])):
            raise SettingsError(f"[keyboard] {k}: must be a list of strings, got {kb[k]!r}")
    layouts = kb.get("layouts", DEFAULTS["keyboard.layouts"])
    if not layouts:
        raise SettingsError("[keyboard] layouts: at least one layout is required")
    if "variants" in kb:
        variants = kb["variants"]
    elif "layouts" in kb:
        variants = [""] * len(layouts)
    else:
        variants = DEFAULTS["keyboard.variants"]
    if len(variants) != len(layouts):
        raise SettingsError(f"[keyboard] variants must have the same length as layouts ({len(layouts)}), got {len(variants)}; "
                            "set both together: hyprdeb set keyboard.layouts us,ir keyboard.variants ,winkeys")
    for lay, var in zip(layouts, variants):
        if lay not in layouts_ok:
            raise SettingsError(f"[keyboard] unknown layout {lay!r} (not in {XKB_LST})")
        if var and var not in variants_ok.get(lay, set()):
            raise SettingsError(f"[keyboard] unknown variant {var!r} for layout {lay!r} (not in {XKB_LST})")
    if layouts[0] not in LATIN_FIRST:
        raise SettingsError(f"[keyboard] the first layout must be Latin because the lock screen switches to layout 0 "
                            f"(allowed here: {', '.join(LATIN_FIRST)}), got {layouts[0]!r}")
    toggle = kb.get("toggle", DEFAULTS["keyboard.toggle"])
    if not isinstance(toggle, str) or toggle not in TOGGLES:
        raise SettingsError(f"[keyboard] toggle must be one of {', '.join(TOGGLES)}, got {toggle!r}")
    return {"layouts": list(layouts), "variants": list(variants), "toggle": toggle}


def validate_input(data):
    """The mouse/keyboard options present in the file -> {dotted key: validated value}. Absent keys stay absent."""
    out = {}
    for key, (_, typ) in INPUT_KEYS.items():
        sec, name = key.split(".")
        tbl = data.get(sec, {})
        if name not in tbl:
            continue
        v = tbl[name]
        where = f"[{sec}] {name}"
        if typ == "bool":
            if not isinstance(v, bool):
                raise SettingsError(f"{where}: must be true or false, got {v!r}")
        elif typ in ("float", "int"):
            lo, hi, _ = INPUT_LIMITS[key]
            ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
            if typ == "int" and not (isinstance(v, int) and not isinstance(v, bool)):
                ok = False
            if not ok:
                raise SettingsError(f"{where}: must be {'a whole number' if typ == 'int' else 'a number'}, got {v!r}")
            if not lo <= v <= hi:
                raise SettingsError(f"{where}: must be between {lo} and {hi}, got {v!r}")
            if typ == "float":
                v = float(v)
        else:
            choices = {"mouse.acceleration": ACCEL_PROFILES, "mouse.focus_follows": tuple(FOCUS_FOLLOWS)}[key]
            if not isinstance(v, str) or v not in choices:
                raise SettingsError(f"{where}: must be one of {', '.join(choices)}, got {v!r}")
        out[key] = v
    return out


def font_lines(query=""):
    """Lines of `fc-list <query> family` (each: comma separated family names of one font file)."""
    fc = shutil.which("fc-list")
    if not fc:
        raise SettingsError("fc-list (fontconfig) is not installed, so fonts cannot be checked")
    r = subprocess.run([fc, query, "family"], capture_output=True, text=True, timeout=30)
    return r.stdout.splitlines()


def font_families():
    """Installed font family names (lower case), from `fc-list : family` (aliases like "Vazirmatn,Vazirmatn SemiBold"
    are split)."""
    return {part.strip().lower() for line in font_lines(":") for part in line.split(",") if part.strip()}


def persian_families():
    """Installed families that cover Persian (`fc-list :lang=fa family`), main family names, without monospace ones."""
    names = {line.split(",")[0].strip() for line in font_lines(":lang=fa") if line.strip()}
    return sorted(n for n in names if "mono" not in n.lower())


def parse_timeout(v, where):
    """"off" -> 0 (notifications stay), "5s" / "2m" -> milliseconds."""
    if v == "off":
        return 0
    m = TIMEOUT_RE.match(v) if isinstance(v, str) else None
    ms = int(m.group(1)) * (1000 if m.group(2) == "s" else 60000) if m else 0
    if not m or not 1000 <= ms <= 3600000:
        raise SettingsError(f"{where}: must be \"off\" or a time from 1s to 60m like \"5s\" or \"2m\", got {v!r}")
    return ms


def validate_fonts(data):
    """[fonts] -> {"persian": family}; absent = Vazirmatn. A set family must be installed and cover Persian."""
    persian = data.get("fonts", {}).get("persian", FONTS_DEFAULT)
    if not isinstance(persian, str) or not persian.strip() or not FONT_RE.match(persian) or persian != persian.strip():
        raise SettingsError(f"[fonts] persian: must be one installed font family name, got {persian!r}")
    if "persian" in data.get("fonts", {}) and persian.lower() not in {n.lower() for n in persian_families()}:
        raise SettingsError(f"[fonts] persian: no installed font family named {persian!r} that covers Persian "
                            "(see: fc-list :lang=fa family)")
    return {"persian": persian}


def validate_notifications(data, persian=FONTS_DEFAULT):
    """[notifications] -> {"timeout", "timeout_ms", "opacity", "font", "dnd" (None = not set)}. "font" is [notifications] font,
    else fonts.persian."""
    t = data.get("notifications", {})
    timeout = t.get("timeout", NOTIF_DEFAULTS["notifications.timeout"])
    ms = parse_timeout(timeout, "[notifications] timeout")
    opacity = t.get("opacity", NOTIF_DEFAULTS["notifications.opacity"])
    lo, hi, _ = NOTIF_OPACITY
    if isinstance(opacity, bool) or not isinstance(opacity, (int, float)) or not math.isfinite(opacity):
        raise SettingsError(f"[notifications] opacity: must be a number, got {opacity!r}")
    if not lo <= opacity <= hi:
        raise SettingsError(f"[notifications] opacity: must be between {lo} and {hi}, got {opacity!r}")
    font = t.get("font", persian)
    if not isinstance(font, str) or not font.strip() or not FONT_RE.match(font) or font != font.strip():
        raise SettingsError(f"[notifications] font: must be one installed font family name, got {font!r}")
    if "font" in t and font.lower() not in font_families():
        raise SettingsError(f"[notifications] font: no installed font family named {font!r} (see: fc-list : family)")
    dnd = t.get("dnd")
    if dnd is not None and not isinstance(dnd, bool):
        raise SettingsError(f"[notifications] dnd: must be true or false, got {dnd!r}")
    return {"timeout": timeout, "timeout_ms": ms, "opacity": float(opacity), "font": font, "dnd": dnd,
            "font_explicit": "font" in t}


def check_nas_fields(t, where, allowed, out_prefix=""):
    """Validated copy of the string fields of one NAS table (flat [nas] or [nas.NAME])."""
    out = {}
    for name, v in t.items():
        if isinstance(v, dict) and where == "[nas]":
            continue                           # a [nas.NAME] table: see nas_share_list
        here = f"{where} {name}"
        if name not in allowed:
            raise SettingsError(f"{where}: unknown key {name!r} (allowed: {', '.join(sorted(allowed))})")
        if not isinstance(v, str) or not v.strip() or v != v.strip():
            raise SettingsError(f"{here}: must be a non-empty string without leading/trailing spaces, got {v!r}")
        if name == "server":
            try:
                ipaddress.IPv4Address(v)
            except ValueError:
                if not NAS_HOST_RE.match(v) or len(v) > 253 or re.fullmatch(r"[\d.]+", v):
                    raise SettingsError(f"{here}: must be an IPv4 address or a host name, got {v!r}")
        elif name == "share" and not NAS_SHARE_RE.match(v):
            raise SettingsError(f"{here}: letters, digits, '_', '.', '-' only (no spaces), got {v!r}")
        elif name == "username" and not NAS_USER_RE.match(v):
            raise SettingsError(f"{here}: letters, digits, '_', '.', '-' only, got {v!r}")
        elif name == "mountpoint":
            if not NAS_PATH_RE.match(v) or ".." in v.split("/"):
                raise SettingsError(f"{here}: must be an absolute path without spaces (letters, digits, '_', '.', '-'), got {v!r}")
        elif name == "idle_unmount":
            if v != "off" and not (DURATION_RE.match(v) and parse_duration(v, here) <= 86400):
                raise SettingsError(f"{here}: must be \"off\" or a time from 30s to 24h like \"10m\", got {v!r}")
        out[out_prefix + name] = v
    return out


def validate_nas(data):
    """[nas] -> {key: value} for the flat keys that are present (the older single share); absent keys stay absent."""
    return check_nas_fields(data.get("nas", {}), "[nas]", SECTION_KEYS["nas"], "nas.")


def validate_nas_shares(data):
    """The shares in settings order: [{name, server, share, username, idle_unmount, mountpoint, legacy, manageable}].
    The flat [nas] keys (older layout) are the share "nax" (their mountpoint must be /mnt/nax or /mnt/<name>); [nas.NAME] tables are the rest."""
    t = data.get("nas", {})
    shares, seen = [], set()
    flat = validate_nas(data)
    if "nas.server" in flat and "nas.share" in flat:
        mp = flat.get("nas.mountpoint", NAS_DEFAULTS["mountpoint"])
        m = re.fullmatch(r"/mnt/([a-z0-9][a-z0-9-]{0,14})", mp)
        shares.append({"name": m.group(1) if m else os.path.basename(mp), "server": flat["nas.server"], "share": flat["nas.share"],
                       "username": flat.get("nas.username"), "idle_unmount": flat.get("nas.idle_unmount", NAS_DEFAULTS["idle_unmount"]),
                       "mountpoint": mp, "legacy": True, "manageable": bool(m)})
        if m:
            seen.add(m.group(1))
    for name, tab in t.items():
        if not isinstance(tab, dict):
            continue
        where = f"[nas.{name}]"
        if not NAS_NAME_RE.match(name):
            raise SettingsError(f"{where}: the name must be 1 to 15 characters from a-z, 0-9 and '-', starting with a letter or digit")
        if name in seen:
            raise SettingsError(f"{where}: the flat [nas] keys already describe the share {name!r}: move them into [nas.{name}] or remove them")
        f = check_nas_fields(tab, where, NAS_TABLE_KEYS)
        for k in ("server", "share"):
            if k not in f:
                raise SettingsError(f"{where}: {k} is required")
        seen.add(name)
        shares.append({"name": name, "server": f["server"], "share": f["share"], "username": f.get("username"),
                       "idle_unmount": f.get("idle_unmount", NAS_DEFAULTS["idle_unmount"]), "mountpoint": f"/mnt/{name}", "legacy": False, "manageable": True})
    return shares


PRINTER_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$")


PRINT_DRIVERS = ("everywhere", "canon-lbp6030")


def validate_printing(data):
    """[printing] -> {key: value} for the keys that are set. printer_uri is socket://HOST[:port] (raw port 9100), ipp://HOST[:port]/path or
    ipps://...; driver is "everywhere" (driverless IPP, needs ipp/ipps) or "canon-lbp6030" (Canon's own PPD, see install.sh); ppd is the
    absolute path of any vendor's PPD file. Nothing here is installed or contacted: install.sh --printing and `hyprdeb print` use it."""
    out = {}
    for name, v in data.get("printing", {}).items():
        where = f"[printing] {name}"
        if name == "default":
            if not isinstance(v, bool):
                raise SettingsError(f"{where}: must be true or false, got {v!r}")
            out["printing.default"] = v
            continue
        if not isinstance(v, str) or v != v.strip():
            raise SettingsError(f"{where}: must be a string without leading/trailing spaces, got {v!r}")
        if v == "":
            continue
        if name == "printer_name" and not PRINTER_NAME_RE.match(v):
            raise SettingsError(f"{where}: letters, digits, '_' and '-' only (at most 63, no spaces), got {v!r}")
        if name == "printer_uri":
            m = re.fullmatch(r"(socket|ipp|ipps)://([^:/\s]+)(?::(\d{1,5}))?(/[A-Za-z0-9._~/%-]*)?", v)
            if not m or (m.group(3) and not 1 <= int(m.group(3)) <= 65535) or (m.group(1) == "socket" and m.group(4)):
                raise SettingsError(f"{where}: must look like socket://a.b.c.d:9100 or ipp://a.b.c.d/ipp/print, got {v!r}")
            host = m.group(2)
            if re.fullmatch(r"[\d.]+", host):
                net_ipv4(host, where)
            elif not NAS_HOST_RE.match(host) or len(host) > 253:
                raise SettingsError(f"{where}: the host must be an IPv4 address or a host name, got {host!r}")
        if name == "driver" and v not in PRINT_DRIVERS:
            raise SettingsError(f"{where}: must be one of {', '.join(PRINT_DRIVERS)}, got {v!r}")
        if name == "ppd" and (not v.startswith("/") or not re.fullmatch(r"/[A-Za-z0-9._+/-]+\.ppd(\.gz)?", v) or ".." in v.split("/")):
            raise SettingsError(f"{where}: must be the absolute path of a .ppd file (letters, digits, . _ + - /), got {v!r}")
        out["printing." + name] = v
    if out.get("printing.default") and not (out.get("printing.printer_name") and out.get("printing.printer_uri")):
        raise SettingsError("[printing] default = true needs printer_name and printer_uri")
    if bool(out.get("printing.printer_name")) != bool(out.get("printing.printer_uri")):
        raise SettingsError("[printing] printer_name and printer_uri go together: set both or neither")
    if out.get("printing.driver") and out.get("printing.ppd"):
        raise SettingsError("[printing] set either driver or ppd, not both")
    if (out.get("printing.driver") or out.get("printing.ppd")) and not out.get("printing.printer_uri"):
        raise SettingsError("[printing] driver and ppd need printer_name and printer_uri")
    scheme = out.get("printing.printer_uri", "").split(":", 1)[0]
    if out.get("printing.driver") == "everywhere" and scheme == "socket":
        raise SettingsError("[printing] driver = \"everywhere\" needs an ipp:// or ipps:// printer_uri (a socket:// raw port has no driverless mode)")
    if scheme in ("ipp", "ipps") and out.get("printing.driver") == "canon-lbp6030":
        raise SettingsError("[printing] driver = \"canon-lbp6030\" uses the raw port: printer_uri must be socket://HOST:9100")
    return out


VPN_PREFIX = "hyprdeb-wg-"                      # the NetworkManager profile is hyprdeb-wg-NAME, the interface wg-NAME
VPN_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,10}$")   # at most 11 characters: "wg-" + NAME must fit the 15-character interface limit


def validate_vpn(data):
    """[vpn] -> {key: value}. default = "NAME" (the profile `vpn on` uses without an argument), keep_lan_dns = true|false.
    No keys, addresses or endpoints are ever kept in settings.toml: they live only in the NetworkManager profile."""
    out = {}
    for name, v in data.get("vpn", {}).items():
        where = f"[vpn] {name}"
        if name == "keep_lan_dns":
            if not isinstance(v, bool):
                raise SettingsError(f"{where}: must be true or false, got {v!r}")
            out["vpn.keep_lan_dns"] = v
            continue
        if not isinstance(v, str) or v != v.strip():
            raise SettingsError(f"{where}: must be a string without leading/trailing spaces, got {v!r}")
        if v == "":
            continue
        if not VPN_NAME_RE.match(v):
            raise SettingsError(f"{where}: a profile name of 1 to 11 characters from a-z, 0-9 and '-' (not starting with '-'), got {v!r}")
        out["vpn." + name] = v
    return out


NET_METHODS = ("dhcp", "static")
NET_MAX_DNS = 3


def net_ipv4(v, where, what="an IPv4 address"):
    """Strict dotted-quad IPv4Address (no leading zeros, no netmask), or SettingsError."""
    try:
        if not isinstance(v, str) or not re.fullmatch(r"\d{1,3}(\.\d{1,3}){3}", v):
            raise ValueError
        a = ipaddress.IPv4Address(v)
    except ValueError:
        raise SettingsError(f"{where}: must be {what}, got {v!r}")
    if a.is_unspecified or a.is_loopback or a.is_multicast or a.is_link_local or a == ipaddress.IPv4Address("255.255.255.255"):
        raise SettingsError(f"{where}: {v} is not a usable unicast address")
    return a


def net_validate_ipv4(method, address, gateway, dns):
    """The checked ipv4 spec {"method": "dhcp"|"static", "address": "a.b.c.d/nn"|None, "gateway": str|None, "dns": [str]}, or None
    when no method is set (then nothing may be set). One rule set for settings.toml, the command-line overrides and the GUI."""
    if method in (None, ""):
        if address or gateway or dns:
            raise SettingsError("[network] ipv4_address, ipv4_gateway and dns need ipv4_method (\"dhcp\" or \"static\")")
        return None
    if method not in NET_METHODS:
        raise SettingsError(f"[network] ipv4_method: must be \"dhcp\" or \"static\", got {method!r}")
    dns = list(dns or [])
    if len(dns) > NET_MAX_DNS:
        raise SettingsError(f"[network] dns: at most {NET_MAX_DNS} servers, got {len(dns)}")
    for i, d in enumerate(dns):
        net_ipv4(d, "[network] dns")
    if len(set(dns)) != len(dns):
        raise SettingsError("[network] dns: a server is listed twice")
    if method == "dhcp":
        if address or gateway:
            raise SettingsError("[network] ipv4_address and ipv4_gateway only apply to ipv4_method = \"static\" (with \"dhcp\" the router gives them)")
        return {"method": "dhcp", "address": None, "gateway": None, "dns": dns}
    if not address or not gateway:
        raise SettingsError("[network] ipv4_method = \"static\" needs ipv4_address (\"a.b.c.d/nn\") and ipv4_gateway")
    if not dns:
        raise SettingsError("[network] ipv4_method = \"static\" needs at least one dns server (without DHCP nothing else provides one, and names would stop resolving)")
    ip, _, prefix = address.partition("/")
    if not prefix.isdigit() or not 8 <= int(prefix) <= 30:
        raise SettingsError(f"[network] ipv4_address: must look like a.b.c.d/nn with a prefix from 8 to 30, got {address!r}")
    a = net_ipv4(ip, "[network] ipv4_address")
    net = ipaddress.IPv4Network(f"{a}/{prefix}", strict=False)
    if a in (net.network_address, net.broadcast_address):
        raise SettingsError(f"[network] ipv4_address: {a} is the network or broadcast address of {net}")
    g = net_ipv4(gateway, "[network] ipv4_gateway")
    if g not in net or g in (net.network_address, net.broadcast_address):
        raise SettingsError(f"[network] ipv4_gateway: {g} is not a host inside {net}")
    if g == a:
        raise SettingsError("[network] ipv4_gateway: the gateway cannot be the machine's own address")
    return {"method": "static", "address": f"{a}/{int(prefix)}", "gateway": str(g), "dns": dns}


def validate_network(data):
    """[network] -> {key: value} for the keys that are set. An empty string / empty list means "not set" (the check is skipped,
    the default is used, nothing is managed). The ipv4 keys are checked together."""
    out = {}
    for name, v in data.get("network", {}).items():
        where = f"[network] {name}"
        if name == "dns":
            if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
                raise SettingsError(f"{where}: must be a list of IPv4 addresses, got {v!r}")
            if v:
                out["network.dns"] = list(v)
            continue
        if not isinstance(v, str) or v != v.strip():
            raise SettingsError(f"{where}: must be a string without leading/trailing spaces, got {v!r}")
        if v == "":
            continue
        if name == "lan_dns_name":
            if not NAS_HOST_RE.match(v) or len(v) > 253 or re.fullmatch(r"[\d.]+", v):
                raise SettingsError(f"{where}: must be a host name that only your LAN resolver answers (not an IP address), got {v!r}")
        elif name == "internet_check":
            host, _, port = v.rpartition(":")
            if not (host and port.isdigit() and 1 <= int(port) <= 65535) or not NAS_HOST_RE.match(host) or len(host) > 253:
                raise SettingsError(f"{where}: must be \"host:port\" with an IPv4 address or host name, like \"1.1.1.1:443\", got {v!r}")
        out["network." + name] = v
    net_validate_ipv4(out.get("network.ipv4_method"), out.get("network.ipv4_address"), out.get("network.ipv4_gateway"), out.get("network.dns"))
    return out


def parse_interval(v, where):
    """'30s' / '15m' / '1h' -> seconds, 10 s to 24 h."""
    m = DURATION_RE.match(v) if isinstance(v, str) else None
    secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600}[m.group(2)] if m else None
    if secs is None or not INTERVAL_MIN_S <= secs <= INTERVAL_MAX_S:
        raise SettingsError(f"{where}: must be a duration from 10s to 24h like \"30s\", \"15m\", \"1h\", got {v!r}")
    return secs


def is_wallpaper_image(name):
    return name.lower().endswith(WALLPAPER_EXTS)


def folder_images(real):
    """Sorted names of the images directly inside a folder (hyprpaper does not read subfolders unless `recursive` is set,
    which hyprdeb never sets)."""
    return sorted((n for n in os.listdir(real) if is_wallpaper_image(n) and os.path.isfile(os.path.join(real, n))), key=lambda n: (n.lower(), n))


def check_paper_path(path, where):
    """A wallpaper path from settings.toml -> (absolute path, "file" | "dir", warnings). SettingsError when unusable."""
    if not isinstance(path, str) or not path.strip():
        raise SettingsError(f"{where} path must be a non-empty string, got {path!r}")
    real = os.path.expanduser(path)
    if not os.path.isabs(real):
        raise SettingsError(f"{where} path must be absolute or start with ~, got {path!r}")
    # The path is written unquoted into hyprdeb-paper.conf, where hyprlang reads '#' as a comment and '$' as a variable.
    for ch, what in (("#", "'#' (it starts a comment in hyprlang)"), ("$", "'$' (it starts a variable in hyprlang)"),
                     ("\n", "a newline"), ("\r", "a newline")):
        if ch in real:
            raise SettingsError(f"{where} path must not contain {what}: {path!r}")
    exts = ", ".join(e[1:] for e in WALLPAPER_EXTS)
    if os.path.isdir(real):
        if not os.access(real, os.R_OK | os.X_OK):
            raise SettingsError(f"{where} path {real}: the folder is not readable")
        names = folder_images(real)
        if not names:
            raise SettingsError(f"{where} path {real}: the folder has no image ({exts}); subfolders are not read")
        bad = sorted(n for n in os.listdir(real) if n.lower().endswith(UNLOADABLE_EXTS) and os.path.isfile(os.path.join(real, n)))
        warns = [f"{where} folder {real}: hyprpaper cannot load {n} (formats: {exts}); it fails when that file comes up" for n in bad]
        return real, "dir", warns
    if not os.path.isfile(real) or not os.access(real, os.R_OK):
        raise SettingsError(f"{where} path {real}: not a readable image file or folder")
    if not is_wallpaper_image(real):
        raise SettingsError(f"{where} path {real}: hyprpaper loads only {exts}")
    return real, "file", []


def validate_wallpaper(data):
    """[wallpaper]: path (file or slideshow folder), fit, interval, order, lock, lock_blur, plus [[wallpaper.monitor]] overrides.
    Returns the all-monitors target ("path", "fit", "kind", "interval", "interval_s"), "monitors" (each override merged over
    it), "lock", "lock_blur", "order" and "warnings"."""
    wp = data.get("wallpaper", {})
    warnings = []
    fit = wp.get("fit", DEFAULTS["wallpaper.fit"])
    if not isinstance(fit, str) or fit not in FITS:
        raise SettingsError(f"[wallpaper] fit must be one of {', '.join(FITS)}, got {fit!r}")
    interval = wp.get("interval", DEFAULTS["wallpaper.interval"])
    interval_s = parse_interval(interval, "[wallpaper] interval")
    order = wp.get("order", DEFAULTS["wallpaper.order"])
    if order not in WALLPAPER_ORDERS:
        raise SettingsError(f"[wallpaper] order must be {' or '.join(WALLPAPER_ORDERS)} (the only order hyprpaper supports), got {order!r}")
    path = wp.get("path")
    if path is None:
        base = {"path": DEFAULTS["wallpaper.path"], "kind": "file", "explicit": False}
    else:
        real, kind, w = check_paper_path(path, "[wallpaper]")
        warnings += w
        base = {"path": real, "kind": kind, "explicit": True}
    base.update(fit=fit, interval=interval, interval_s=interval_s)
    lock = wp.get("lock", DEFAULTS["wallpaper.lock"])
    if not isinstance(lock, str) or not lock.strip():
        raise SettingsError(f"[wallpaper] lock must be \"same\", \"default\" or an image file, got {lock!r}")
    if lock not in ("same", "default"):
        real = os.path.expanduser(lock)
        if not os.path.isabs(real) or any(c in real for c in "#$\r\n"):
            raise SettingsError(f"[wallpaper] lock must be \"same\", \"default\" or an absolute image path without '#' or '$', got {lock!r}")
        if not os.path.isfile(real) or not os.access(real, os.R_OK) or not is_wallpaper_image(real):
            raise SettingsError(f"[wallpaper] lock {real}: not a readable image file ({', '.join(e[1:] for e in WALLPAPER_EXTS)})")
        lock = real
    blur = wp.get("lock_blur", DEFAULTS["wallpaper.lock_blur"])
    if isinstance(blur, bool) or not isinstance(blur, int) or not 0 <= blur <= LOCK_BLUR_MAX:
        raise SettingsError(f"[wallpaper] lock_blur must be a whole number from 0 to {LOCK_BLUR_MAX}, got {blur!r}")
    raw = wp.get("monitor", [])
    if not isinstance(raw, list) or not all(isinstance(m, dict) for m in raw):
        raise SettingsError("[wallpaper] monitor must be an array of tables ([[wallpaper.monitor]])")
    mons, seen = [], set()
    for i, m in enumerate(raw, 1):
        where = f"[[wallpaper.monitor]] #{i}"
        bad = set(m) - WALLPAPER_MONITOR_KEYS
        if bad:
            raise SettingsError(f"{where}: unknown key(s): {', '.join(sorted(bad))} (allowed: {', '.join(sorted(WALLPAPER_MONITOR_KEYS))})")
        match = m.get("match")
        if not isinstance(match, str) or not match.strip() or match != match.strip():
            raise SettingsError(f"{where}: 'match' is required: \"desc:<description>\" or an output name like DP-1")
        if match in seen:
            raise SettingsError(f"{where}: 'match' {match!r} appears twice")
        seen.add(match)
        if match.startswith("desc:"):
            if not match[5:].strip():
                raise SettingsError(f"{where}: 'desc:' needs a description")
            if any(c in match for c in "#$\r\n"):
                raise SettingsError(f"{where}: 'match' must not contain '#' or '$' (hyprlang special characters): {match!r}")
        elif not re.fullmatch(r"[A-Za-z0-9_.-]+", match):
            raise SettingsError(f"{where}: 'match' must be 'desc:<description>' or an output name like DP-1, got {match!r}")
        t = dict(base, match=match, overridden=sorted(k for k in m if k != "match"))
        if "fit" in m:
            if not isinstance(m["fit"], str) or m["fit"] not in FITS:
                raise SettingsError(f"{where}: fit must be one of {', '.join(FITS)}, got {m['fit']!r}")
            t["fit"] = m["fit"]
        if "interval" in m:
            t["interval_s"] = parse_interval(m["interval"], f"{where}: interval")
            t["interval"] = m["interval"]
        if "path" in m:
            t["path"], t["kind"], w = check_paper_path(m["path"], where)
            t["explicit"] = True
            warnings += w
        mons.append(t)
    return {**base, "order": order, "lock": lock, "lock_blur": blur, "monitors": mons, "warnings": warnings}


def validate(data):
    """Return the validated settings dict, or raise SettingsError.

    {"monitors": [...], "idle": {...}, "wallpaper": {...}, "keyboard": {...} | None, "input": {...}}
    "keyboard" is None unless [keyboard] has layouts, variants or toggle (then the generated Lua overrides kb_*).
    "input" holds the mouse/keyboard options that are set; the generated Lua writes only those."""
    unknown = set(data) - {"monitors", *SECTION_KEYS}
    if unknown:
        raise SettingsError(f"unknown top-level key(s): {', '.join(sorted(unknown))} "
                            f"(allowed: monitors, {', '.join(sorted(SECTION_KEYS))})")
    for sec, allowed in SECTION_KEYS.items():
        if sec in data:
            if not isinstance(data[sec], dict):
                raise SettingsError(f"'{sec}' must be a table ([{sec}])")
            bad = {k for k in data[sec] if k not in allowed and not (sec == "nas" and isinstance(data[sec][k], dict))}
            if bad:
                raise SettingsError(f"[{sec}]: unknown key(s): {', '.join(sorted(bad))} (allowed: {', '.join(sorted(allowed))})")
    mons = data.get("monitors", [])
    if not isinstance(mons, list) or not all(isinstance(m, dict) for m in mons):
        raise SettingsError("'monitors' must be an array of tables ([[monitors]])")
    out, seen = [], set()
    for i, m in enumerate(mons, 1):
        where = f"[[monitors]] #{i}"
        bad = set(m) - MONITOR_KEYS
        if bad:
            raise SettingsError(f"{where}: unknown key(s): {', '.join(sorted(bad))} (allowed: {', '.join(sorted(MONITOR_KEYS))})")
        match = m.get("match")
        if not isinstance(match, str) or not match.strip():
            raise SettingsError(f"{where}: 'match' is required and must be a non-empty string")
        if match != match.strip():
            raise SettingsError(f"{where}: 'match' has leading/trailing spaces")
        if match in seen:
            raise SettingsError(f"{where}: 'match' {match!r} appears twice")
        seen.add(match)
        if match.startswith("desc:"):
            if not match[5:].strip():
                raise SettingsError(f"{where}: 'desc:' needs a description")
        elif not re.fullmatch(r"[A-Za-z0-9_.-]+", match):
            raise SettingsError(f"{where}: 'match' must be 'desc:<description>' or an output name like DP-1, got {match!r}")
        mode = m.get("mode", "preferred")
        if not isinstance(mode, str) or not MODE_RE.match(mode):
            raise SettingsError(f"{where}: 'mode' must be preferred, highres, highrr, WxH or WxH@R, got {mode!r}")
        pos = m.get("position", "auto")
        if not isinstance(pos, str) or not POSITION_RE.match(pos):
            raise SettingsError(f"{where}: 'position' must be \"auto\" or \"XxY\" like \"1920x0\", got {pos!r}")
        scale = m.get("scale")
        if scale is not None:
            if isinstance(scale, bool) or not isinstance(scale, (int, float)):
                raise SettingsError(f"{where}: 'scale' must be a number, got {scale!r}")
            if not math.isfinite(scale) or scale <= 0:
                raise SettingsError(f"{where}: 'scale' must be a finite number > 0, got {scale!r}")
        disabled = m.get("disabled", False)
        if not isinstance(disabled, bool):
            raise SettingsError(f"{where}: 'disabled' must be true or false, got {disabled!r}")
        out.append({"match": match, "mode": mode, "position": pos, "scale": scale, "disabled": disabled})

    idle = data.get("idle", {})
    lock_raw = idle.get("lock_after", DEFAULTS["idle.lock_after"])
    off_raw = idle.get("screen_off_after", DEFAULTS["idle.screen_off_after"])
    lock = parse_duration(lock_raw, "[idle] lock_after")
    off = parse_duration(off_raw, "[idle] screen_off_after")
    if lock is not None and off is not None and off <= lock:
        raise SettingsError(f"[idle] screen_off_after ({off_raw}) must be longer than lock_after ({lock_raw}) "
                            "when both are on")
    idle_v = {"lock_after": lock_raw, "screen_off_after": off_raw, "lock_s": lock, "screen_off_s": off}

    wall = validate_wallpaper(data)

    fonts = validate_fonts(data)
    kb = {k: v for k, v in data.get("keyboard", {}).items() if k in ("layouts", "variants", "toggle")}
    keyboard = validate_keyboard(kb) if kb else None
    return {"monitors": out, "idle": idle_v, "wallpaper": wall, "keyboard": keyboard, "input": validate_input(data),
            "notifications": validate_notifications(data, fonts["persian"]), "nas": validate_nas(data), "nas_shares": validate_nas_shares(data), "network": validate_network(data), "printing": validate_printing(data), "vpn": validate_vpn(data), "fonts": fonts}


# ---------------------------------------------------------------- generation

def generate_lua(st):
    lines = [
        "-- hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + ". Do not edit; changes are overwritten.",
    ]
    if not st["monitors"] and not st["keyboard"] and not st["input"]:
        lines.append("-- (no monitor rules, no keyboard override)")
    for m in st["monitors"]:
        lines.append("hl.monitor({")
        lines.append(f"    output   = {lua_str(m['match'])},")
        if m["disabled"]:
            lines.append("    disabled = true,")
        else:
            lines.append(f"    mode     = {lua_str(m['mode'])},")
            lines.append(f"    position = {lua_str(m['position'])},")
            lines.append("    scale    = " + (lua_num(m["scale"]) if m["scale"] is not None else '"auto"') + ",")
        lines.append("})")
    kb = st["keyboard"]
    if kb or st["input"]:
        # One input block with only the keys that are set. Later hl.config blocks merge per key, so nothing else is reset.
        lines.append("hl.config({")
        lines.append("  input = {")
        if kb:
            lines.append(f"    kb_layout = {lua_str(','.join(kb['layouts']))},")
            lines.append(f"    kb_variant = {lua_str(','.join(kb['variants']))},")
            # one layout: nothing to toggle, and grp:caps_toggle would take Caps Lock away
            lines.append(f"    kb_options = {lua_str(TOGGLES[kb['toggle']] if len(kb['layouts']) > 1 else '')},")
        for key, v in st["input"].items():
            lname, typ = INPUT_KEYS[key]
            if key == "mouse.focus_follows":
                lit = str(FOCUS_FOLLOWS[v])
            elif typ == "bool":
                lit = "true" if v else "false"
            elif typ == "str":
                lit = lua_str(v)
            else:
                lit = lua_num(v)
            lines.append(f"    {lname} = {lit},")
        lines.append("  },")
        lines.append("})")
    return "\n".join(lines) + "\n"


def generate_idle(st):
    i = st["idle"]
    lines = [
        "# hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + ". Do not edit; changes are overwritten.",
        "# Sourced by hypridle.conf. A missing file here means hypridle has no rules at all (no idle lock).",
    ]
    if i["lock_s"] is None:
        lines.append("# lock_after = off: no lock listener")
    else:
        lines += ["", "listener {", f"    timeout = {i['lock_s']}                                  # {i['lock_after']}",
                  "    on-timeout = loginctl lock-session", "}"]
    if i["screen_off_s"] is None:
        lines.append("# screen_off_after = off: no screen-off listener")
    else:
        lines += ["", "listener {", f"    timeout = {i['screen_off_s']}                                  # {i['screen_off_after']}",
                  "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({action = \"off\"})'",
                  "    on-resume = hyprctl dispatch 'hl.dsp.dpms({action = \"on\"})'", "}"]
    return "\n".join(lines) + "\n"


def paper_block(monitor, t):
    lines = ["wallpaper {", (f"    monitor = {monitor}").rstrip(), f"    path = {t['path']}", f"    fit_mode = {t['fit']}"]
    if t["kind"] == "dir":     # a folder is a slideshow; without `order` hyprpaper would use the raw directory order
        lines += [f"    timeout = {t['interval_s']}", f"    order = {t['order']}"]
    return lines + ["}"]


def generate_paper(st):
    w = st["wallpaper"]
    lines = [
        "# hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + ". Do not edit; changes are overwritten.",
        "# Sourced by hyprpaper.conf. Empty monitor = fallback for every monitor without its own block.",
        "",
    ]
    for m in w["monitors"]:
        lines += paper_block(m["match"], dict(m, order=w["order"])) + [""]
    lines += paper_block("", dict(w))
    return "\n".join(lines) + "\n"


LOCK_EXTS = WALLPAPER_EXTS   # formats given to hyprlock; narrow this if a format turns out not to load there


def lock_image(t):
    """(path for hyprlock, None) for a wallpaper target, or (None, reason): a file as it is, a slideshow folder = its first image
    by name (stable: the lock screen must not change between two locks)."""
    path = t["path"]
    if t["kind"] == "dir":
        names = [n for n in folder_images(path) if n.lower().endswith(LOCK_EXTS) and not any(c in n for c in "#$")]
        if not names:
            return None, f"no image in {path} that the lock screen can use"
        return os.path.join(path, names[0]), None
    if not path.lower().endswith(LOCK_EXTS):
        return None, f"the lock screen cannot load {os.path.basename(path)}"
    return path, None


def lock_plan(st):
    """([(monitor, image, zindex or None)], warnings) for hyprdeb-lock.conf. A failed load would leave a plain colour, so an image
    the lock screen is not known to load is replaced by the shipped default (with a warning)."""
    w = st["wallpaper"]
    default = DEFAULTS["wallpaper.path"]
    if w["lock"] == "default":
        return [("", default, None)], []
    if w["lock"] != "same":
        return [("", w["lock"], None)], []
    warns, blocks = [], []
    targets = [("", w)] + [(m["match"], m) for m in w["monitors"]]
    for mon, t in targets:
        img, why = lock_image(t) if t["explicit"] else (t["path"], None)
        if img is None:
            warns.append(f"lock screen{' on ' + mon if mon else ''}: {why}; using the default image")
            img = default
        blocks.append((mon, img, (-2 if mon == "" else -1) if w["monitors"] else None))
    # fallback first (lowest zindex), then the monitors with their own wallpaper on top
    return blocks, warns


def generate_lock(st):
    blocks, _ = lock_plan(st)
    blur = st["wallpaper"]["lock_blur"]
    lines = [
        "# hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + ". Do not edit; changes are overwritten.",
        "# Sourced by hyprlock.conf. Empty monitor = every monitor; a block with a monitor is drawn over it (higher zindex).",
    ]
    for mon, img, z in blocks:
        lines += ["", "background {", (f"    monitor = {mon}").rstrip(), f"    path = {img}", f"    blur_passes = {blur}"]
        if z is not None:
            lines.append(f"    zindex = {z}")
        lines.append("}")
    return "\n".join(lines) + "\n"


def wallpaper_warnings(st):
    return st["wallpaper"]["warnings"] + lock_plan(st)[1]


def warn_wallpaper(st):
    for w in wallpaper_warnings(st):
        print(f"warning: {w}", file=sys.stderr)


def generate_mako(st):
    n = st["notifications"]
    alpha = format(round(n["opacity"] * 255), "02x")
    family = n["font"]
    if not n["font_explicit"]:
        font = "sans-serif"    # follow the fontconfig order (Latin: Noto Sans, Persian: [fonts] persian, then Vazirmatn)
    else:
        font = family if family.lower() == FALLBACK_FONT.lower() else f"{family}, {FALLBACK_FONT}"
    low = min(NOTIF_LOW_MS, n["timeout_ms"]) if n["timeout_ms"] else 0
    lines = [
        "# hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + ". Do not edit; changes are overwritten.",
        "# Included by ~/.config/mako/config (include= is parsed first there, so its sections keep their order).",
        f"font={font} 11",
        f"background-color=#1e2028{alpha}",
        f"default-timeout={n['timeout_ms']}",
        "",
        "[urgency=low]",
        f"default-timeout={low}",
    ]
    return "\n".join(lines) + "\n"


def generate_fontconf(st):
    """fontconfig snippet: sans-serif = Noto Sans, then the Persian family, then Vazirmatn; monospace = Noto Sans Mono, then the
    same two (per-character fallback does the rest)."""
    from xml.sax.saxutils import escape
    fams = [FALLBACK_FONT_LATIN, st["fonts"]["persian"]]
    if st["fonts"]["persian"].lower() != FONTS_DEFAULT.lower():
        fams.append(FONTS_DEFAULT)
    return "\n".join([
        '<?xml version="1.0"?>',
        '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">',
        "<!-- hyprdeb managed: generated by `hyprdeb apply` from " + SETTINGS_FRIENDLY + " ([fonts] persian). Do not edit; changes are overwritten.",
        "     Latin stays in " + FALLBACK_FONT_LATIN + " (no Arabic glyphs there); Persian/Arabic script falls through to the next family.",
        "     Running apps read fontconfig at start: restart them to see a change. -->",
        "<fontconfig>",
        '  <alias binding="same">',
        "    <family>sans-serif</family>",
        "    <prefer>" + "".join(f"<family>{escape(f)}</family>" for f in fams) + "</prefer>",
        "  </alias>",
        "  <!-- monospace (editors, Kate, VS Code): Latin code stays fixed-width, Persian is joined proportional text from the next family -->",
        '  <alias binding="same">',
        "    <family>monospace</family>",
        "    <prefer>" + "".join(f"<family>{escape(f)}</family>" for f in [FALLBACK_MONO_LATIN] + fams[1:]) + "</prefer>",
        "  </alias>",
        "</fontconfig>", ""])


def build_outputs(st, outdir, lua_path):
    mako = MAKO_INC if lua_path == DEFAULT_OUT else os.path.join(outdir, MAKO_INC_TEST)
    fontconf = FONTCONF if lua_path == DEFAULT_OUT else os.path.join(outdir, FONTCONF_TEST)
    return {lua_path: generate_lua(st),
            os.path.join(outdir, IDLE_NAME): generate_idle(st),
            os.path.join(outdir, PAPER_NAME): generate_paper(st),
            os.path.join(outdir, LOCK_NAME): generate_lock(st),
            mako: generate_mako(st),
            fontconf: generate_fontconf(st)}


def load_validated(args):
    explicit = args.settings is not None
    path = args.settings or DEFAULT_SETTINGS
    return validate(load(path, explicit))


def idle_missing_warnings(outdir):
    """The sourced idle file is what gives hypridle its listeners: without it nothing locks on idle."""
    path = os.path.join(outdir, IDLE_NAME)
    if not os.path.exists(path):
        return [f"idle lock disabled: {path} is missing; run: hyprdeb apply"]
    return []


def warn_idle_missing(outdir):
    for w in idle_missing_warnings(outdir):
        print(f"warning: {w}", file=sys.stderr)


def plan(args):
    st = load_validated(args)
    lua_path = args.out or DEFAULT_OUT
    return st, build_outputs(st, os.path.dirname(lua_path), lua_path)


# ---------------------------------------------------------------- hyprland side effects

def in_hyprland():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl") is not None


def hyprctl(*a):
    r = subprocess.run(["hyprctl", *a], capture_output=True, text=True, timeout=10)
    return (r.stdout + r.stderr).strip()


def unmatched_warnings(monitors, wallpaper_monitors=()):
    """Rules that match no known output (not an error): a typo, or the monitor is unplugged."""
    try:
        known = json.loads(hyprctl("monitors", "all", "-j"))
    except ValueError:
        return ["could not read 'hyprctl monitors all -j'; rule matching not checked"]
    names = {m.get("name") for m in known}
    descs = {"desc:" + m.get("description", "") for m in known}
    return ([f"monitor rule {m['match']!r} matches no known output (typo, or not connected); see 'hyprctl monitors all'"
             for m in monitors if m["match"] not in names and m["match"] not in descs]
            + [f"wallpaper for {m['match']!r}: matches no connected output (typo, or not connected); it is kept and used when that monitor is back"
               for m in wallpaper_monitors if not monitor_connected(m["match"], names, known)])


def monitor_connected(match, names, known):
    """Same matching as hyprpaper and hyprlock: an output name, or "desc:" followed by the start of the description."""
    if match in names:
        return True
    return match.startswith("desc:") and any(m.get("description", "").startswith(match[5:]) for m in known)


def warn_unmatched(monitors, wallpaper_monitors=()):
    for w in unmatched_warnings(monitors, wallpaper_monitors):
        print(f"warning: {w}", file=sys.stderr)


def session_pids(name):
    """PIDs of `name` (exact process name) owned by us that belong to this Wayland session (same WAYLAND_DISPLAY in
    /proc/<pid>/environ), so another session's daemon is never touched. Empty when WAYLAND_DISPLAY is unset."""
    wd = os.environ.get("WAYLAND_DISPLAY")
    if not wd:
        return None
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), name], capture_output=True, text=True)
    pids = []
    for tok in r.stdout.split():
        try:
            with open(f"/proc/{tok}/environ", "rb") as f:
                env = f.read().split(b"\0")
        except OSError:
            continue
        if f"WAYLAND_DISPLAY={wd}".encode() in env:
            pids.append(int(tok))
    return pids


def restart_session_daemon(name):
    """Restart this session's hypridle/hyprpaper. Only if it is running: a daemon that is not running is not started
    (hyprland.start does that; e.g. hyprpaper crashes on the VM). Returns a status string."""
    pids = session_pids(name)
    if pids is None:
        return f"{name}: WAYLAND_DISPLAY is not set, cannot tell which one is this session's; restart it by hand"
    if not pids:
        return f"{name}: not running in this session, not started"
    for pid in pids:
        try:
            os.kill(pid, 15)
        except ProcessLookupError:
            pass
    deadline = time.time() + 3
    while time.time() < deadline and any(os.path.exists(f"/proc/{p}") for p in pids):
        time.sleep(0.1)
    for p in pids:
        if os.path.exists(f"/proc/{p}"):
            try:
                os.kill(p, 9)
            except ProcessLookupError:
                pass
    answer = hyprctl("dispatch", f'hl.dsp.exec_cmd("{name}")')
    deadline = time.time() + 4
    new = []
    while time.time() < deadline:
        new = [p for p in (session_pids(name) or []) if p not in pids]
        if new:
            break
        time.sleep(0.2)
    if new:
        return f"{name}: restarted (pid {new[0]}; hyprctl: {answer})"
    return f"{name}: did NOT come back after the restart (hyprctl: {answer}); start it by hand"


_ICONS_OK = None


def icons_available():
    """Is the icon font installed (fontconfig knows the family)? Without it no glyph is shown anywhere: a plain fallback could land on
    another font's glyph for the same codepoint (Material Icons)."""
    global _ICONS_OK
    if _ICONS_OK is None:
        try:
            r = subprocess.run(["fc-list", ICON_FONT_FC, "family"], capture_output=True, text=True, timeout=10)
            _ICONS_OK = ICON_FONT in r.stdout.replace("\\", "")
        except (OSError, subprocess.SubprocessError):
            _ICONS_OK = False
    return _ICONS_OK


def icon(meaning):
    """The glyph for a meaning ("" when the icon font is not installed)."""
    return chr(int(ICONS[meaning][1], 16)) if icons_available() else ""


def makoctl(*a):
    """(exit status, output) of makoctl; (None, message) when it is missing or hangs."""
    try:
        r = subprocess.run(["makoctl", *a], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        return None, str(e)
    return r.returncode, (r.stdout + r.stderr).strip()


def live_dnd():
    """True/False: is mako's do-not-disturb mode on right now; None when mako is not running (or makoctl is missing)."""
    rc, out = makoctl("mode")
    return None if rc != 0 else DND_MODE in out.split()


def signal_waybar_dnd():
    """Tell this session's waybar to re-read the custom/dnd module (SIGRTMIN+8); no polling."""
    for pid in session_pids("waybar") or []:
        try:
            os.kill(pid, signal.SIGRTMIN + WAYBAR_DND_SIGNAL)
        except ProcessLookupError:
            pass


DND_STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "hyprdeb-dnd.json")


def mako_pid():
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), "mako"], capture_output=True, text=True)
    return int(r.stdout.split()[0]) if r.stdout.split() else None


def mako_ids(cmd):
    """Notification ids from `makoctl list` / `makoctl history`, newest first."""
    return [int(i) for i in re.findall(r"^Notification (\d+):", makoctl(cmd)[1], re.M)]


def dnd_state():
    """{"pid", "from" (newest id when the mode went on), "hidden", "done"}. "hidden" = ids that were created during
    do-not-disturb AND were already in the history when it went off, i.e. never shown on screen (one that was still active
    then is shown normally and is a plain notification afterwards). Only valid for the mako that wrote it (ids restart)."""
    try:
        with open(DND_STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        return {}
    return st if st.get("pid") == mako_pid() else {}


def note_dnd_change(on):
    pid = mako_pid()
    top = max(mako_ids("list") + mako_ids("history") + [0])
    st = dnd_state()
    if on or not st:
        st = {"pid": pid, "from": top, "hidden": [], "done": []}
    else:
        st["hidden"] = [i for i in mako_ids("history") if i > st["from"]]
    try:
        write_atomic(DND_STATE, json.dumps(st))
    except OSError:
        pass


def sync_dnd(want):
    """Make mako's do-not-disturb mode match settings.toml (`want`: True/False, None = leave it alone). Returns a status
    line, or None when there is nothing to say."""
    if want is None:
        return None
    live = live_dnd()
    if live is None:
        # not running (e.g. install.sh run at the greeter): mako starts with DND off, so only "on" has something left to apply
        return "mako is not running: do-not-disturb not applied (hyprdeb dnd sync, once it runs)" if want else None
    msg = None
    if live != want:
        rc, out = makoctl("mode", "-a" if want else "-r", DND_MODE)
        if rc != 0:
            return f"makoctl mode failed: {out}"
        msg = f"do-not-disturb {'on' if want else 'off'}"
        note_dnd_change(want)
    signal_waybar_dnd()
    return msg


def write_atomic(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".hyprdeb.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def read_or_none(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None


def diff_text(old, new, label):
    return "".join(difflib.unified_diff((old or "").splitlines(True), new.splitlines(True),
                                        fromfile=label if old is not None else "/dev/null", tofile=label + " (new)"))


def apply_outputs(st, outputs, dry_run, live=True):
    """Write the changed generated files, then reload / restart (only when `live`: a custom --out is a test mode
    and must never touch the running session). Returns an exit code."""
    changed = {p: t for p, t in outputs.items() if read_or_none(p) != t}
    if not changed:
        for p in outputs:
            print(f"{p} is up to date")
        if live and in_hyprland():
            warn_unmatched(st["monitors"], st["wallpaper"]["monitors"])
        if live and not dry_run:
            msg = sync_dnd(st["notifications"]["dnd"])
            if msg:
                print(msg)
        return 0
    if dry_run:
        for p, t in changed.items():
            sys.stdout.write(diff_text(read_or_none(p), t, p))
        print("dry run: nothing written")
        return 0
    for p, t in changed.items():
        write_atomic(p, t)
        print(f"{p} updated")
    lua_path = next(p for p in outputs if p.endswith("hyprdeb-settings.lua") or p.endswith(".lua"))
    idle_path = next(p for p in outputs if p.endswith(IDLE_NAME))
    mako_path = next(p for p in outputs if p.endswith("hyprdeb-settings") or p.endswith(MAKO_INC_TEST))
    font_path = next(p for p in outputs if p.endswith("hyprdeb-persian.conf"))
    paper_path = next(p for p in outputs if p.endswith(PAPER_NAME))
    if font_path in changed:
        print("fontconfig changed: running apps keep their old font until they are restarted "
              "(Chrome, Claude Desktop, Kate, Thunar, ...; waybar and mako are done here)")
    if not live:
        print("custom --out: nothing reloaded or restarted")
        return 0
    rc = 0
    if mako_path in changed:
        # mako is only reloaded, never killed; a missing/broken include makes the reload fail (the old config stays).
        mrc, mout = makoctl("reload")
        if mrc is None or (mrc != 0 and live_dnd() is None):
            print("mako: not running, picks the new settings up at its next start")
        elif mrc != 0:
            print(f"mako: reload failed: {mout}", file=sys.stderr)
            rc = 1
        else:
            print("mako: reloaded")
    msg = sync_dnd(st["notifications"]["dnd"])
    if msg:
        print(msg)
    if not in_hyprland():
        print("not inside a running Hyprland: nothing reloaded or restarted (picked up at the next start or reload)")
        return rc
    if lua_path in changed:
        # Errors that were already there (nothing to do with settings) must not fail this run: only new lines count.
        before = set(hyprctl("configerrors").splitlines())
        print("hyprctl reload:", hyprctl("reload"))
        after = hyprctl("configerrors").splitlines()
        new = [l for l in after if l.strip() and l not in before]
        warn_unmatched(st["monitors"], st["wallpaper"]["monitors"])
        if new:
            print("Hyprland reports new config errors after the reload:\n" + "\n".join(new), file=sys.stderr)
            rc = 1
        else:
            print("configerrors: no new errors" + (f" ({len(after)} line(s) pre-existing)" if any(l.strip() for l in after) else ""))
    if idle_path in changed:
        msg = restart_session_daemon("hypridle")
        print(msg)
        if "did NOT come back" in msg:
            rc = 1
    if font_path in changed:
        msg = restart_session_daemon("waybar")
        print(msg)
        if "did NOT come back" in msg:
            rc = 1
    if paper_path in changed:
        msg = restart_session_daemon("hyprpaper")
        print(msg)
        if "did NOT come back" in msg:
            rc = 1
    return rc


# ---------------------------------------------------------------- commands

def cmd_check(args):
    st, outputs = plan(args)
    for p, t in outputs.items():
        print(f"### {p}")
        sys.stdout.write(t)
    print("settings OK", file=sys.stderr)
    warn_wallpaper(st)
    warn_idle_missing(os.path.dirname(args.out or DEFAULT_OUT))
    if args.out is None and in_hyprland():
        warn_unmatched(st["monitors"], st["wallpaper"]["monitors"])
    return 0


def cmd_apply(args):
    st, outputs = plan(args)
    warn_wallpaper(st)
    return apply_outputs(st, outputs, args.dry_run, live=args.out is None)


def effective(st):
    """Dotted key -> effective value (defaults filled in)."""
    kb = st["keyboard"] or {"layouts": DEFAULTS["keyboard.layouts"], "variants": DEFAULTS["keyboard.variants"],
                            "toggle": DEFAULTS["keyboard.toggle"]}
    return {
        "idle.lock_after": st["idle"]["lock_after"],
        "idle.screen_off_after": st["idle"]["screen_off_after"],
        "wallpaper.path": st["wallpaper"]["path"],
        "wallpaper.fit": st["wallpaper"]["fit"],
        "wallpaper.interval": st["wallpaper"]["interval"],
        "wallpaper.order": st["wallpaper"]["order"],
        "wallpaper.lock": st["wallpaper"]["lock"],
        "wallpaper.lock_blur": st["wallpaper"]["lock_blur"],
        "keyboard.layouts": kb["layouts"],
        "keyboard.variants": kb["variants"],
        "keyboard.toggle": kb["toggle"],
        **{k: st["input"].get(k) for k in INPUT_KEYS},   # None = not set: Hyprland keeps its own value
        "notifications.timeout": st["notifications"]["timeout"],
        "notifications.opacity": st["notifications"]["opacity"],
        "notifications.font": st["notifications"]["font"],
        "notifications.dnd": st["notifications"]["dnd"],   # None = not set: mako keeps its current mode
        **{k: st["nas"].get(k) for k in NAS_KEYS},
        **{k: st["network"].get(k) for k in NETWORK_KEYS},
        **{k: st["printing"].get(k) for k in PRINTING_KEYS},
        **{k: st["vpn"].get(k) for k in VPN_KEYS},
        "fonts.persian": st["fonts"]["persian"],
    }


def live_input():
    """Current value of each such option as Hyprland reports it, plus notifications.dnd from mako ({} outside a session).
    None = unset/empty."""
    out = {}
    if not in_hyprland():
        dnd = live_dnd()
        return {} if dnd is None else {"notifications.dnd": dnd}
    for key, (lname, typ) in INPUT_KEYS.items():
        try:
            j = json.loads(hyprctl("getoption", "-j", "input:" + lname))
        except (SettingsError, ValueError, subprocess.SubprocessError, OSError):
            continue
        v = next((j[t] for t in ("int", "float", "bool", "str") if t in j), None)
        if key == "mouse.focus_follows":
            v = next((n for n, i in FOCUS_FOLLOWS.items() if i == v), v)
        elif v == "[[EMPTY]]" or v == "":
            v = None
        out[key] = v
    dnd = live_dnd()
    if dnd is not None:
        out["notifications.dnd"] = dnd
    return out


def shown_input(eff, live):
    """Value to display per optional key: settings.toml, else what Hyprland / mako has now, else the documented default."""
    return {k: (eff[k] if eff[k] is not None else live.get(k, INPUT_DEFAULTS[k])) for k in OPTIONAL_KEYS}


def toml_literal(v):
    if isinstance(v, list):
        return "[" + ", ".join(json.dumps(x) for x in v) + "]"
    return json.dumps(v)


def persian_choices(current):
    """Installed families that cover Persian, plus the current one if it is not among them."""
    try:
        names = persian_families()
    except SettingsError:
        names = []
    return names + ([current] if current not in names else [])


def preset_choices(current, presets=None):
    """The duration presets (the menu's by default), plus the current value when it is not one of them (e.g. "90s")."""
    presets = MENU_DURATIONS if presets is None else presets
    return list(presets) + ([current] if current not in presets else [])


WALLPAPER_INTERVALS = ("5m", "15m", "30m", "1h", "3h")


def wallpaper_targets(st):
    """What the Wallpaper page edits: "All monitors" first, then each connected monitor (by its description), then saved
    overrides whose monitor is not connected (so they can still be edited or removed). Each: label, match ("" = all), the
    effective path / fit / interval / kind, whether it has its own settings, and which keys are its own."""
    w = st["wallpaper"]
    def row(label, match, t, connected, own):
        return {"label": label, "match": match, "path": t["path"], "file": os.path.expanduser(t["path"]), "kind": t["kind"],
                "fit": t["fit"], "interval": t["interval"], "connected": connected, "own": own is not None,
                "overridden": t.get("overridden", []) if own is not None else []}
    rows = [row("All monitors", "", w, True, None)]
    own_left = {m["match"]: m for m in w["monitors"]}
    known = []
    if in_hyprland():
        try:
            known = json.loads(hyprctl("monitors", "all", "-j"))
        except (ValueError, subprocess.SubprocessError, OSError):
            known = []
    for mon in known:
        name, desc = mon.get("name", ""), mon.get("description", "")
        hit = next((k for k in own_left if k == name or (k.startswith("desc:") and desc.startswith(k[5:]))), None)
        t = own_left.pop(hit) if hit else w
        label = f"{desc} ({name})" if desc else name
        rows.append(row(label, hit or ("desc:" + desc if desc else name), t, True, t if hit else None))
    for k, t in own_left.items():
        rows.append(row(f"{k[5:] if k.startswith('desc:') else k} (not connected)", k, t, False, t))
    return rows


def show_json(args):
    """`show --json`: everything the settings window needs, so it needs no logic of its own. Always valid JSON; if
    settings.toml is invalid: {"ok": false, "error": ...} and exit status 1."""
    try:
        st = load_validated(args)
    except SettingsError as e:
        print(json.dumps({"ok": False, "error": str(e), "warnings": []}, indent=2))
        return 1
    eff = effective(st)
    warnings = idle_missing_warnings(os.path.dirname(DEFAULT_OUT))
    if in_hyprland():
        warnings += unmatched_warnings(st["monitors"], st["wallpaper"]["monitors"])
    warnings += wallpaper_warnings(st)
    d, names = wallpaper_candidates()
    cur = os.path.expanduser(eff["wallpaper.path"])
    default = os.path.expanduser(DEFAULTS["wallpaper.path"])
    cands = [{"label": "Default wallpaper", "path": DEFAULTS["wallpaper.path"], "file": default, "current": cur == default,
              "default": True}]
    seen = {default}
    for n in names:
        path = os.path.join(d, n)
        cands.append({"label": n, "path": path, "file": path, "current": path == cur, "default": False})
        seen.add(path)
    if cur not in seen:
        cands.insert(1, {"label": os.path.basename(cur) + " (current)", "path": cur, "file": cur, "current": True,
                                "default": False})
    live = live_input()
    settings = dict(eff, **shown_input(eff, live))
    print(json.dumps({
        "ok": True,
        "settings": settings,
        "input_set": {k: eff[k] is not None for k in OPTIONAL_KEYS},
        "notifications_font_explicit": st["notifications"]["font_explicit"],
        "icons": {sec: icon(m) for sec, m in SECTION_ICONS.items()},
        "limits": {**{k: {"min": lo, "max": hi, "step": step} for k, (lo, hi, step) in INPUT_LIMITS.items()},
                   "notifications.opacity": dict(zip(("min", "max", "step"), NOTIF_OPACITY))},
        "choices": {
            "mouse.acceleration": list(ACCEL_PROFILES),
            "mouse.focus_follows": list(FOCUS_FOLLOWS),
            "idle.lock_after": preset_choices(eff["idle.lock_after"]),
            "idle.screen_off_after": preset_choices(eff["idle.screen_off_after"]),
            "wallpaper.fit": list(FITS),
            "wallpaper.interval": preset_choices(eff["wallpaper.interval"], WALLPAPER_INTERVALS),
            "keyboard.toggle": list(TOGGLES),
            "notifications.timeout": preset_choices(eff["notifications.timeout"], NOTIF_TIMEOUTS),
            "fonts.persian": persian_choices(eff["fonts.persian"]),
        },
        "wallpaper": {"folder": d, "candidates": cands, "targets": wallpaper_targets(st),
                      "extensions": list(WALLPAPER_EXTS), "interval": {"min": INTERVAL_MIN_S, "max": INTERVAL_MAX_S},
                      "interval_presets": list(WALLPAPER_INTERVALS), "lock_blur_max": LOCK_BLUR_MAX},
        "monitors": st["monitors"],
        "monitors_hint": f"edit {SETTINGS_FRIENDLY}, then run: hyprdeb apply",
        "warnings": warnings,
    }, indent=2))
    return 0


def cmd_show(args):
    if args.json:
        return show_json(args)
    st = load_validated(args)
    warn_idle_missing(os.path.dirname(DEFAULT_OUT))
    eff = effective(st)
    live = live_input()
    for k, v in eff.items():
        if v is None:
            cur = live.get(k, INPUT_DEFAULTS[k])
            if k.startswith(("nas.", "network.")):
                print(f"# {k}: not set")
                continue
            who = "mako" if k.startswith("notifications.") else "Hyprland"
            print(f"# {k}: not set ({who}: {cur if cur is not None else 'its default'})")
        else:
            print(f"{k} = {toml_literal(v)}")
    print(f"# monitors: {len(st['monitors'])} [[monitors]] block(s) (edit {SETTINGS_FRIENDLY} for those)")
    return 0


def cmd_get(args):
    st = load_validated(args)
    eff = effective(st)
    if args.key not in eff:
        raise SettingsError(f"unknown key {args.key!r} (keys: {', '.join(eff)})")
    v = eff[args.key]
    if v is None:
        v = shown_input(eff, live_input())[args.key]
        if args.key.startswith(("nas.", "network.")):
            print(f"hyprdeb: {args.key} is not set in settings.toml", file=sys.stderr)
            return 0
        who = "mako's" if args.key.startswith("notifications.") else "Hyprland's"
        print(f"hyprdeb: {args.key} is not set in settings.toml; {who} value:", file=sys.stderr)
        if v is None:
            return 0
    print(str(v).lower() if isinstance(v, bool) else ",".join(v) if isinstance(v, list) else v)
    return 0


def parse_cli_value(key, raw):
    t = KEY_TYPES[key]
    if t == "list":
        return [x.strip() for x in raw.split(",")] if raw.strip() else []
    if t == "bool":
        if raw.lower() not in ("true", "false"):
            raise SettingsError(f"{key}: must be true or false, got {raw!r}")
        return raw.lower() == "true"
    try:
        if t == "int":
            return int(raw)
        if t == "float":
            return float(raw)
    except ValueError:
        raise SettingsError(f"{key}: must be {'a whole number' if t == 'int' else 'a number'}, got {raw!r}")
    return raw


def wallpaper_monitor_edit(args, op, match, fields):
    """Add / change / remove one [[wallpaper.monitor]] with tomlkit (comments kept), validate the whole new document, write it
    (settings.toml.bak the first time), then apply like `set`."""
    try:
        import tomlkit
    except ImportError:
        raise SettingsError("this needs python3-tomlkit (sudo apt install python3-tomlkit); settings.toml was not touched")
    path = args.settings or DEFAULT_SETTINGS
    old_text = read_or_none(path)
    doc = tomlkit.parse(old_text or "")
    if "wallpaper" not in doc:
        if op != "set":
            print(f"no wallpaper settings for {match} (nothing to remove)")
            return 0
        doc["wallpaper"] = tomlkit.table()
    wall = doc["wallpaper"]
    arr = wall.get("monitor")
    entry = next((t for t in arr if t.get("match") == match), None) if arr is not None else None
    if op == "set":
        if entry is None:
            if arr is None:
                wall["monitor"] = tomlkit.aot()
                arr = wall["monitor"]
            entry = tomlkit.table()
            entry["match"] = match
            for k, v in fields.items():
                entry[k] = v
            entry.add(tomlkit.nl())       # a blank line before the next table
            arr.append(entry)
            fields = {}
        for k, v in fields.items():
            entry[k] = v
    elif entry is not None:
        arr.remove(entry)
        if len(arr) == 0:
            del wall["monitor"]
        if len(wall) == 0:
            del doc["wallpaper"]
    elif op == "clear":
        print(f"no wallpaper settings for {match} (nothing to remove)")
    new_text = tomlkit.dumps(doc)
    try:
        st = validate(tomllib.loads(new_text))
    except tomllib.TOMLDecodeError as e:
        raise SettingsError(f"internal error: new document is not valid TOML: {e}")
    lua_path = args.out or DEFAULT_OUT
    outputs = build_outputs(st, os.path.dirname(lua_path), lua_path)
    warn_wallpaper(st)
    if args.dry_run:
        sys.stdout.write(diff_text(old_text, new_text, path))
        apply_outputs(st, outputs, True, live=args.out is None)
        return 0
    if new_text != (old_text or ""):
        bak = path + ".bak"
        if old_text is not None and not os.path.exists(bak):
            write_atomic(bak, old_text)
            print(f"{bak} written (first change by hyprdeb)")
        write_atomic(path, new_text)
        print(f"{path} updated")
    else:
        print(f"{path} unchanged")
    return apply_outputs(st, outputs, False, live=args.out is None)


def cmd_wallpaper(args):
    """hyprdeb wallpaper pick file|folder | monitor set MATCH [--path P] [--fit F] [--interval I] | monitor clear MATCH. Never uses the
    hyprpaper IPC (`hyprctl hyprpaper`): in 0.8.4 it hangs and kills hyprpaper. Changes are applied by `apply`, which restarts hyprpaper."""
    if args.action == "pick":
        exts = [e for x in WALLPAPER_EXTS for e in ("*" + x, "*" + x.upper(), "*" + x.capitalize())]
        start = wallpaper_candidates()[0]
        try:
            if args.kind == "folder":
                path = portal_pick("Choose a wallpaper folder", directory=True, start=start)
            else:
                path = portal_pick("Choose a wallpaper", [("Images (" + ", ".join(x[1:] for x in WALLPAPER_EXTS) + ")", exts)], start=start)
        except VpnError as e:
            print(f"hyprdeb: error: {e}", file=sys.stderr)
            return VPN_EXIT["error"]
        if path is None:
            return VPN_EXIT["cancelled"]
        print(path)
        return 0
    match = args.match
    if args.op == "clear":
        return wallpaper_monitor_edit(args, "clear", match, {})
    fields = {}
    for k in ("path", "fit", "interval"):
        v = getattr(args, k)
        if v is not None:
            fields[k] = v
    return wallpaper_monitor_edit(args, "set", match, fields)


def cmd_set(args):
    pairs = args.pairs
    if len(pairs) % 2:
        raise SettingsError("set needs KEY VALUE pairs")
    try:
        import tomlkit
    except ImportError:
        raise SettingsError("'set' needs python3-tomlkit (sudo apt install python3-tomlkit); settings.toml was not touched")
    path = args.settings or DEFAULT_SETTINGS
    old_text = read_or_none(path)
    doc = tomlkit.parse(old_text or "")
    for key, raw in zip(pairs[0::2], pairs[1::2]):
        if key not in KEY_TYPES:
            if key.startswith("monitors"):
                raise SettingsError("[[monitors]] cannot be changed with 'set'; edit " + SETTINGS_FRIENDLY)
            raise SettingsError(f"unknown key {key!r} (settable: {', '.join(KEY_TYPES)})")
        sec, name = key.split(".")
        if sec not in doc:
            doc[sec] = tomlkit.table()
        val = parse_cli_value(key, raw)
        if isinstance(val, list):
            arr = tomlkit.array()
            for x in val:
                arr.append(x)
            val = arr
        doc[sec][name] = val
    new_text = tomlkit.dumps(doc)
    # Validate the whole new document before anything is written.
    try:
        st = validate(tomllib.loads(new_text))
    except tomllib.TOMLDecodeError as e:
        raise SettingsError(f"internal error: new document is not valid TOML: {e}")
    lua_path = args.out or DEFAULT_OUT
    outputs = build_outputs(st, os.path.dirname(lua_path), lua_path)
    warn_wallpaper(st)
    if args.dry_run:
        sys.stdout.write(diff_text(old_text, new_text, path))
        apply_outputs(st, outputs, True, live=args.out is None)
        return 0
    if new_text != (old_text or ""):
        bak = path + ".bak"
        if old_text is not None and not os.path.exists(bak):
            write_atomic(bak, old_text)
            print(f"{bak} written (first change by hyprdeb set)")
        write_atomic(path, new_text)
        print(f"{path} updated")
    else:
        print(f"{path} unchanged")
    return apply_outputs(st, outputs, False, live=args.out is None)


# ---------------------------------------------------------------- NAS (CIFS, systemd automount)

def nas_unit_base(mountpoint):
    """systemd unit base name for a mountpoint ("/mnt/nax" -> "mnt-nax"), from systemd-escape (never hard-coded)."""
    r = subprocess.run(["systemd-escape", "-p", "--suffix=mount", mountpoint], capture_output=True, text=True)
    if r.returncode != 0:
        raise SettingsError(f"systemd-escape failed: {r.stderr.strip()}")
    return r.stdout.strip()[:-len(".mount")]


# ---------------------------------------------------------------- NAS status and actions (several shares)
# Status, Connect, Open and Disconnect need no password (Disconnect asks polkit through systemd). Adding, changing, testing and removing a
# share is done by the root helper /usr/local/sbin/hyprdeb-nas through its socket (see NAS management below).

NAS_PORT = 445
NAS_CONNECT_TIMEOUT = 1.0     # seconds for the "is the NAS answering" check
NAS_MOUNT_WAIT = 20           # seconds `nas mount` waits for the first access (the mount unit itself gives up after 10)
NAS_EXIT = {"mounted": 0, "not_mounted": 1, "not_set_up": 2, "error": 3}


def tcp_open(host, port=NAS_PORT, timeout=NAS_CONNECT_TIMEOUT):
    try:
        socket.create_connection((host, port), timeout=timeout).close()
        return True
    except OSError:
        return False


def systemctl_props(units, props):
    """{unit id: {prop: value}} from one `systemctl show` call (blocks are separated by a blank line)."""
    r = subprocess.run(["systemctl", "show", *units, "-p", ",".join(props)], capture_output=True, text=True, timeout=5)
    out = {}
    for block in r.stdout.strip().split("\n\n"):
        d = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        if d.get("Id"):
            out[d["Id"]] = d
    return out


def since_text(ts):
    """"Sat 2026-10-10 19:24:25 +0330" -> "19:24" (with the date when it is not today)."""
    parts = ts.split()
    if len(parts) < 3:
        return ts
    date, clock = parts[1], parts[2][:5]
    return clock if date == time.strftime("%Y-%m-%d") else f"{date} {clock}"


def nas_cred_file(c):
    """(path, still_legacy) of a share's credentials file on this machine: existence only, the file is root-only and never read.
    Until it is migrated, the share whose mount unit still says credentials=/etc/hyprdeb/nas-credentials (older layout) uses that file."""
    new = f"{NAS_ETC}/nas-{c['name']}.credentials"
    if os.path.exists(new):
        return new, False
    try:
        with open(f"/etc/systemd/system/{nas_unit_base(c['mountpoint'])}.mount") as f:
            unit = f.read()
    except OSError:
        unit = ""
    if NAS_CREDENTIALS + "," in unit and os.path.exists(NAS_CREDENTIALS):
        return NAS_CREDENTIALS, True
    return new, False


def nas_share_status(c):
    """Status dict of one share for `nas status` / the settings window. Fast (the only wait is the 1 s port check), never mounts."""
    mp = c["mountpoint"]
    base = nas_unit_base(mp)
    auto_id, mnt_id = base + ".automount", base + ".mount"
    units = systemctl_props([auto_id, mnt_id], ["Id", "LoadState", "ActiveState", "SubState", "ActiveEnterTimestamp", "Result"])
    auto, mnt = units.get(auto_id, {}), units.get(mnt_id, {})
    installed = auto.get("LoadState") == "loaded" and mnt.get("LoadState") == "loaded"
    mounted = mnt.get("ActiveState") == "active"
    waiting = auto.get("ActiveState") == "active" and not mounted
    reachable = tcp_open(c["server"])
    idle = c["idle_unmount"]
    idle_txt = "stays connected until you disconnect" if idle == "off" else f"disconnects after {idle} without use"
    if mounted:
        state, head = "mounted", f"Connected since {since_text(mnt.get('ActiveEnterTimestamp', ''))}; {idle_txt}."
    elif not installed:
        state, head = "units_missing", "In settings.toml, but not set up on this machine: run ./install.sh --nas"
    elif waiting:
        state, head = "waiting", f"Not connected. It connects when you open {mp}; {idle_txt}."
    else:
        state, head = "inactive", "Not connected, and the automount is not running: run ./install.sh --nas"
    lines = [head, "NAS answers on port %d: %s" % (NAS_PORT, "yes" if reachable else f"NO ({c['server']} does not answer)")]
    if not mounted and mnt.get("Result") not in (None, "", "success"):
        lines.append(f"The last connection attempt failed ({mnt['Result']}).")
    cred, legacy_cred = nas_cred_file(c)
    cred_ok = os.path.exists(cred)
    if not cred_ok:
        lines.append(f"The password file {cred} is missing: Edit the NAS and type the password, or run ./install.sh --nas")
    return {"ok": True, "set_up": True, "name": c["name"], "state": state, "mounted": mounted, "reachable": reachable, "unit": base,
            "server": c["server"], "share": c["share"], "mountpoint": mp, "username": c["username"],
            "idle_unmount": idle, "since": since_text(mnt.get("ActiveEnterTimestamp", "")) if mounted else None,
            "last_result": mnt.get("Result"), "lines": lines, "code": NAS_EXIT["mounted" if mounted else "not_mounted"],
            "detail": f"//{c['server']}/{c['share']} on {mp}" + (f", user {c['username']}" if c["username"] else ""),
            "hint": "Manage it on the NAS page of the settings window, or with: hyprdeb nas add|edit|remove|test NAME",
            "manageable": c["manageable"], "credentials_ok": cred_ok, "legacy_credentials": legacy_cred,
            "can_connect": installed and not mounted, "can_open": installed, "can_disconnect": mounted}


def nas_status(st):
    """{"ok", "set_up", "shares": [per-share status]} plus the first share's fields at the top level (the original shape)."""
    shares = st["nas_shares"]
    if not shares:
        return {"ok": True, "set_up": False, "state": "not_set_up", "mounted": False, "code": NAS_EXIT["not_set_up"], "shares": [],
                "lines": ["Not set up."], "hint": "Add one on the NAS page of the settings window, or: hyprdeb nas add NAME --server S --share SH --username U",
                "can_connect": False, "can_open": False, "can_disconnect": False}
    import concurrent.futures
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, len(shares))) as ex:   # one 1 s port check each, in parallel
        items = list(ex.map(nas_share_status, shares))
    return {**items[0], "shares": items}


def nas_pick(st, name):
    """The share called NAME, or the first one when NAME is not given."""
    shares = st["nas_shares"]
    if not shares:
        raise SettingsError("no NAS is set up: add one with the NAS page or `hyprdeb nas add NAME ...`")
    if name is None:
        return shares[0]
    for c in shares:
        if c["name"] == name:
            return c
    raise SettingsError(f"no NAS called {name!r} (known: {', '.join(c['name'] for c in shares)})")


def cmd_nas_ctl(args):
    """hyprdeb nas status [NAME] [--json] | mount | unmount | open [NAME] | add | edit | remove | test | migrate | list | install.
    Exit codes of status: 0 mounted, 1 not mounted (waiting), 2 not set up, 3 error. Without NAME the first share is used."""
    act = args.action
    if act in NAS_MANAGE_ACTIONS:
        return cmd_nas_manage(args)
    try:
        st_all = load_validated(args)
        st = nas_status(st_all)
        if act != "status" or args.name is not None:
            c = nas_pick(st_all, args.name) if st_all["nas_shares"] else None
            if c is not None:
                st = next(s for s in st["shares"] if s["name"] == c["name"])
    except (SettingsError, subprocess.SubprocessError, OSError) as e:
        if act == "status" and args.json:
            print(json.dumps({"ok": False, "error": str(e), "code": NAS_EXIT["error"]}))
        else:
            print(f"hyprdeb: error: {e}", file=sys.stderr)
        return NAS_EXIT["error"]
    if act == "status":
        if args.json:
            print(json.dumps(st, indent=2))
        elif not st["set_up"]:
            print("\n".join(st["lines"]))
            print(st["hint"])
        else:
            items = [st] if args.name is not None else st["shares"]
            for i, s in enumerate(items):
                if i:
                    print()
                print(f"{s['name']}: {s['detail']}" if len(items) > 1 else s["detail"])
                print("\n".join(s["lines"]))
            print(st["hint"])
        return st["code"]
    if not st["set_up"]:
        print("hyprdeb: error: no NAS is set up: " + st["hint"], file=sys.stderr)
        return NAS_EXIT["not_set_up"]
    mp, base = st["mountpoint"], st["unit"]
    if act == "open":
        if not shutil.which("thunar"):
            print("hyprdeb: error: thunar is not installed", file=sys.stderr)
            return NAS_EXIT["error"]
        subprocess.Popen(["thunar", mp], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        print(f"Opening {mp} in Thunar (it connects the NAS if needed).")
        return 0
    if act == "mount":
        if st["mounted"]:
            print(f"Already connected: {st['detail']}")
            return 0
        if not st["can_connect"]:
            print("hyprdeb: error: " + st["lines"][0], file=sys.stderr)
            return NAS_EXIT["error"]
        if not st["reachable"]:
            print(f"hyprdeb: error: the NAS {st['server']} does not answer on port {NAS_PORT} (is it on, and on the same network?)", file=sys.stderr)
            return NAS_EXIT["error"]
        try:
            r = subprocess.run(["ls", mp], capture_output=True, text=True, timeout=NAS_MOUNT_WAIT)
        except subprocess.TimeoutExpired:
            print(f"hyprdeb: error: connecting timed out after {NAS_MOUNT_WAIT} s", file=sys.stderr)
            return NAS_EXIT["error"]
        if r.returncode != 0:
            err = r.stderr.strip()
            if "Permission denied" in err:
                why = (f"the NAS refused the login (CIFS error 13): Edit {st['name']} and type the user name and password again "
                       f"(the Test button checks them without mounting)")
            else:
                why = f"{err or 'ls failed'} (details: journalctl -u {base}.mount)"
            print("hyprdeb: error: could not connect: " + why, file=sys.stderr)
            return NAS_EXIT["error"]
        print(f"Connected: {st['detail']}")
        return 0
    if act == "unmount":
        if not st["mounted"]:
            print("Already disconnected.")
            return 0
        # Needs root: polkit asks for the password through the session's agent (hyprpolkitagent); nothing hidden behind this command.
        try:
            r = subprocess.run(["systemctl", "stop", base + ".mount"], capture_output=True, text=True, timeout=90)
        except subprocess.TimeoutExpired:
            print("hyprdeb: error: disconnecting timed out (the password dialog was not answered?)", file=sys.stderr)
            return NAS_EXIT["error"]
        err = r.stderr.strip()
        now = systemctl_props([base + ".mount"], ["Id", "ActiveState"]).get(base + ".mount", {})
        if now.get("ActiveState") != "active":
            print("Disconnected. It connects again when you open " + mp + ".")
            return 0
        if "authentication" in err.lower() or "denied" in err.lower() or "not authorized" in err.lower():
            why = "administrator authentication was cancelled or denied"
        elif "busy" in err.lower() or "job failed" in err.lower():
            why = "the share is probably still in use: close the file manager windows and programs that have it open, then try again"
        else:
            why = err or "systemctl stop failed"
        print("hyprdeb: error: could not disconnect: " + why, file=sys.stderr)
        return NAS_EXIT["error"]
    return NAS_EXIT["error"]


# ---------------------------------------------------------------- NAS management : add, edit, remove, test, migrate, install
# The user side validates, asks for the password (no-echo prompt, or ONE line on stdin when stdin is not a terminal: this is how the
# settings window passes it) and hands everything to the root helper over /run/hyprdeb-nas.sock; polkit shows the password dialog
# in the helper. The password goes nowhere else: not an argument, not the environment, not settings.toml, not a log. Only after the
# helper has succeeded is settings.toml changed (keeping its comments): the helper's files are the truth for what is mounted.

NAS_MANAGE_ACTIONS = ("add", "edit", "remove", "test", "migrate", "list", "install")
NAS_SOCKET = "/run/hyprdeb-nas.sock"
NAS_HELPER = "/usr/local/sbin/hyprdeb-nas"
NAS_REPLY_WAIT = 200          # seconds for the whole helper conversation (the password dialog may stay open this long)


class NasError(Exception):
    pass


def nas_call(req, use_sudo=False):
    """One request to the root helper -> its reply dict. Over the socket by default; use_sudo runs the helper directly (install.sh)."""
    data = (json.dumps(req) + "\n").encode()
    if use_sudo:
        argv = ([] if os.getuid() == 0 else ["sudo"]) + [NAS_HELPER]
        try:
            r = subprocess.run(argv, input=data, stdout=subprocess.PIPE, timeout=NAS_REPLY_WAIT + 200)
        except FileNotFoundError:
            raise NasError("sudo is not installed")
        except subprocess.TimeoutExpired:
            raise NasError("the helper took too long")
        return nas_parse_reply(r.stdout)
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        # the polkit dialog is about to ask for the administrator password and shows no layout: type it in the first (Latin) one
        # (the same call hyprdeb-lock makes); best effort, a failure changes nothing
        try:
            subprocess.run(["hyprctl", "-q", "switchxkblayout", "all", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except (OSError, subprocess.SubprocessError):
            pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(NAS_REPLY_WAIT)
    try:
        s.connect(NAS_SOCKET)
    except FileNotFoundError:
        raise NasError("the NAS helper is not installed: run ./install.sh --nas in a terminal")
    except PermissionError:
        raise NasError("this user may not use the NAS helper (its socket is for the sudo group)")
    except ConnectionRefusedError:
        raise NasError("the NAS helper is not running: run ./install.sh --nas in a terminal")
    except OSError as e:
        raise NasError(f"cannot reach the NAS helper: {e}")
    try:
        s.sendall(data)
        buf = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
            if len(buf) > 1 << 20:
                break
    except socket.timeout:
        raise NasError("the NAS helper did not answer in time (was the password dialog left open?)")
    except (ConnectionResetError, BrokenPipeError):
        raise NasError("the NAS helper is busy with other requests: wait a moment and try again")
    except OSError as e:
        raise NasError(f"the NAS helper connection failed: {e}")
    finally:
        s.close()
    return nas_parse_reply(buf)


def nas_parse_reply(raw):
    for line in reversed(raw.decode("utf-8", "replace").splitlines()):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if isinstance(d, dict) and "ok" in d:
            return d
    raise NasError("the NAS helper gave no answer (see: journalctl -u 'hyprdeb-nas@*')")


def nas_read_password(prompt, required=True):
    """No-echo prompt on a terminal; otherwise ONE line from stdin (an empty line = no password given)."""
    if sys.stdin.isatty():
        import getpass
        try:
            pw = getpass.getpass(prompt)
        except (EOFError, KeyboardInterrupt):
            raise NasError("no password given")
    else:
        pw = sys.stdin.readline().rstrip("\r\n")
    if required and not pw:
        raise NasError("no password given")
    return pw


def nas_bookmark(mp, label, add):
    """The Thunar sidebar line for the mount point: appended once, or removed again; other lines are never touched."""
    path = os.path.join(HOME, ".config", "gtk-3.0", "bookmarks")
    old = read_or_none(path)
    lines = (old or "").splitlines()
    mine = [l for l in lines if l == f"file://{mp}" or l.startswith(f"file://{mp} ")]
    if add and not mine:
        write_atomic(path, "\n".join(lines + [f"file://{mp} {label}"]) + "\n")
    elif not add and mine:
        write_atomic(path, "".join(l + "\n" for l in lines if l not in mine))


def nas_settings_edit(args, op, name, fields=None):
    """Change settings.toml with tomlkit (comments kept): op "set" writes [nas.NAME], op "remove" deletes it. The flat [nas] keys of
    the first share (older layout) are moved into [nas.nax] the first time. The whole new document is validated before it is written."""
    try:
        import tomlkit
    except ImportError:
        raise NasError("settings.toml could not be updated: python3-tomlkit is missing (sudo apt install python3-tomlkit)")
    path = args.settings or DEFAULT_SETTINGS
    old = read_or_none(path)
    doc = tomlkit.parse(old or "")
    if "nas" not in doc:
        doc["nas"] = tomlkit.table()
    nas = doc["nas"]
    flat = [k for k in ("server", "share", "mountpoint", "username", "idle_unmount") if k in nas]
    if flat:                                              # the older layout: it is the share named by its mount point
        mp = str(nas["mountpoint"]) if "mountpoint" in nas else NAS_DEFAULTS["mountpoint"]
        m = re.fullmatch(r"/mnt/([a-z0-9][a-z0-9-]{0,14})", mp)
        if not m:
            raise NasError(f"the NAS in [nas] uses the mount point {mp}, which hyprdeb cannot manage: change it by hand in {SETTINGS_FRIENDLY}")
        tab = tomlkit.table()
        for k in ("server", "share", "username", "idle_unmount"):
            if k in nas:
                tab[k] = nas[k]
        tab.add(tomlkit.nl())
        for k in flat:
            del nas[k]
        nas[m.group(1)] = tab
    if op == "set":
        if name in nas:
            for k, v in fields.items():
                nas[name][k] = v
        else:
            tab = tomlkit.table()
            for k in ("server", "share", "username", "idle_unmount"):
                tab[k] = fields[k]
            tab.add(tomlkit.nl())
            nas[name] = tab
    elif name in nas:
        del nas[name]
        if len(nas) == 0:                                 # the last share is gone: no empty [nas] header left behind
            del doc["nas"]
    if "nas" in doc and hasattr(doc["nas"], "_is_super_table"):
        # [nas] holding only [nas.NAME] tables needs no header of its own; one with a comment keeps its header
        kinds = {type(i).__name__ for _, i in doc["nas"].value.body}
        if kinds <= {"Whitespace", "Null", "Table"}:
            doc["nas"]._is_super_table = True
    new = tomlkit.dumps(doc)
    try:
        validate(tomllib.loads(new))
    except (tomllib.TOMLDecodeError, SettingsError) as e:
        raise NasError(f"settings.toml would not be valid ({e}); it was not changed")
    if new != (old or ""):
        bak = path + ".bak"
        if old is not None and not os.path.exists(bak):
            write_atomic(bak, old)
        write_atomic(path, new)


def nas_result(args, ok, text, notes=(), warning=None):
    """Print the outcome (plain text or --json) and return the exit code."""
    if getattr(args, "json", False):
        print(json.dumps({"ok": ok, ("message" if ok else "error"): text, "notes": list(notes), **({"warning": warning} if warning else {})}))
    elif ok:
        print(text)
        for n in notes:
            print("  " + n)
        if warning:
            print("hyprdeb: warning: " + warning, file=sys.stderr)
    else:
        print("hyprdeb: error: " + text, file=sys.stderr)
    return 0 if ok else NAS_EXIT["error"]


def nas_fields(args, cur=None):
    """The non-secret fields from the flags, over the current values (edit/test), validated like settings.toml."""
    cur = cur or {}
    f = {"server": args.server or cur.get("server"), "share": args.share or cur.get("share"),
         "username": args.username or cur.get("username"), "idle_unmount": args.idle or cur.get("idle_unmount") or NAS_DEFAULTS["idle_unmount"]}
    for k in ("server", "share", "username"):
        if not f[k]:
            raise NasError(f"--{k} is required")
    check_nas_fields(f, "NAS", NAS_TABLE_KEYS)
    return f


def nas_uid_fields():
    """"uid" for a request sent to the helper directly as root (the mount owner): the user who ran sudo."""
    if os.getuid() != 0:
        return {"uid": os.getuid()}
    try:
        return {"uid": int(os.environ["SUDO_UID"])}
    except (KeyError, ValueError):
        raise NasError("run this as your own user (it asks for sudo itself), not as root")


def cmd_nas_manage(args):
    act = args.action
    try:
        return nas_manage(args, act)
    except (NasError, SettingsError, OSError, subprocess.SubprocessError) as e:
        if act in ("list", "install"):
            print(f"hyprdeb: error: {e}", file=sys.stderr)
            return NAS_EXIT["error"]
        return nas_result(args, False, str(e))


def nas_manage(args, act):
    st = load_validated(args)
    shares = st["nas_shares"]
    if act == "list":
        items = nas_status(st)["shares"]
        if args.json:
            print(json.dumps({"ok": True, "shares": items}, indent=2))
        for s in ([] if args.json else items):
            print(f"{s['name']:<16} //{s['server']}/{s['share']} -> {s['mountpoint']}  {s['state']}"
                  + (f"  user {s['username']}" if s["username"] else "") + ("" if s["credentials_ok"] else "  (no password file)"))
        if not items and not args.json:
            print("No NAS is set up.")
        return 0
    if act == "install":
        return nas_install(args, st)
    name = args.name
    if act in ("add",):
        if not name or not NAS_NAME_RE.match(name):
            raise NasError("name: 1 to 15 characters from a-z, 0-9 and '-', starting with a letter or digit (the share is mounted on /mnt/NAME)")
        if any(c["name"] == name for c in shares):
            raise NasError(f"a NAS called {name} is already in settings.toml: use `hyprdeb nas edit {name}`")
        f = nas_fields(args)
        if args.dry_run:
            return nas_result(args, True, f"[dry-run] would add {name}: //{f['server']}/{f['share']} on /mnt/{name}, user {f['username']}, "
                                          f"idle {f['idle_unmount']}; the root helper writes the password file and units, settings.toml gets [nas.{name}]")
        pw = nas_read_password(f"NAS password for {f['username']} (not shown): ")
        r = nas_call({"verb": "add", "name": name, **f, "password": pw})
        pw = None
        if not r["ok"]:
            return nas_result(args, False, r["error"])
        return nas_finish(args, st, "set", name, f, r)
    if act in ("edit", "test", "migrate", "remove") and (name is not None or act in ("edit", "remove", "migrate")):
        c = nas_pick(st, name) if (name or shares) else None
        if c is None:
            raise NasError("no NAS is set up")
        name = c["name"]
        if not c["manageable"]:
            raise NasError(f"the NAS on {c['mountpoint']} cannot be managed here (only /mnt/NAME mount points): edit {SETTINGS_FRIENDLY}")
    if act == "edit":
        f = nas_fields(args, c)
        if args.dry_run:
            return nas_result(args, True, f"[dry-run] would change {name} to //{f['server']}/{f['share']}, user {f['username']}, idle {f['idle_unmount']}")
        pw = nas_read_password(f"New password for {f['username']} (empty = keep the stored one): ", required=False)
        r = nas_call({"verb": "edit", "name": name, **f, **({"password": pw} if pw else {})})
        pw = None
        if not r["ok"]:
            return nas_result(args, False, r["error"])
        return nas_finish(args, st, "set", name, f, r)
    if act == "remove":
        if args.dry_run:
            return nas_result(args, True, f"[dry-run] would remove {name}: disconnect it, delete its units and password file, drop [nas.{name}]")
        if not args.yes:
            if not sys.stdin.isatty():
                raise NasError("remove needs --yes when it is not run from a terminal")
            if input(f"Remove NAS {name}? The files on the NAS are not touched. [y/N] ").strip().lower() != "y":
                return nas_result(args, True, "Nothing removed.")
        r = nas_call({"verb": "remove", "name": name})
        if not r["ok"] and r.get("code") != "missing":
            return nas_result(args, False, r["error"])
        note = ["It was not set up on this machine; only settings.toml was changed."] if not r["ok"] else r.get("notes", [])
        try:
            nas_settings_edit(args, "remove", name)
            nas_bookmark(c["mountpoint"], name, False)
        except (NasError, OSError) as e:
            return nas_result(args, False, f"{name} was removed, but settings.toml could not be updated: {e}")
        return nas_result(args, True, r.get("message") or f"NAS {name} removed.", note)
    if act == "migrate":
        r = nas_call({"verb": "migrate", "name": name})
        return nas_result(args, r["ok"], r.get("message") or r.get("error"), r.get("notes", []))
    if act == "test":
        if name is None and not (args.server and args.share and args.username):
            c = nas_pick(st, None)
            name = c["name"]
        cur = next((c for c in shares if c["name"] == name), None)
        f = nas_fields(args, cur)
        pw = nas_read_password("NAS password (empty = test with the stored one): " if cur else "NAS password (not shown): ", required=cur is None)
        r = nas_call({"verb": "test", **({"name": name} if cur else {}), "server": f["server"], "share": f["share"], "username": f["username"],
                      **({"password": pw} if pw else {})})
        pw = None
        return nas_result(args, r["ok"], r.get("message") or r.get("error"))
    return NAS_EXIT["error"]


def nas_finish(args, st, op, name, fields, r):
    """After the helper succeeded: settings.toml (+ the Thunar bookmark), then the outcome."""
    warning = None
    try:
        nas_settings_edit(args, op, name, fields)
        nas_bookmark(f"/mnt/{name}", name, True)
    except (NasError, OSError) as e:
        warning = f"the NAS is set up, but settings.toml could not be updated ({e}): add [nas.{name}] there by hand"
    return nas_result(args, warning is None, r["message"] if warning is None else warning, r.get("notes", []))


def nas_install(args, st):
    """For install.sh --nas: every share of settings.toml is made to exist on this machine through the helper (run with sudo).
    A share that is already there is only re-checked (edit without a password; the older share is migrated); a new one asks for its password."""
    shares = st["nas_shares"]
    if not shares:
        print("No NAS in settings.toml ([nas.NAME] with server and share): the helper is installed, add shares on the NAS page of the settings window.")
        return 0
    failed = 0
    for c in shares:
        if not c["manageable"]:
            print(f"hyprdeb: {c['mountpoint']} is not a /mnt/NAME mount point: left alone (edit {SETTINGS_FRIENDLY} and the units by hand)", file=sys.stderr)
            continue
        base = nas_unit_base(c["mountpoint"])
        have_units = all(os.path.exists(f"/etc/systemd/system/{base}.{x}") for x in ("mount", "automount"))
        cred, _ = nas_cred_file(c)
        have_cred = os.path.exists(cred)
        user = c["username"]
        f = {"server": c["server"], "share": c["share"], "idle_unmount": c["idle_unmount"]}
        if have_units and have_cred and user:
            plan, req = "check/update (no password needed)", {"verb": "edit", "name": c["name"], **f, "username": user}
        else:
            plan, req = "create" if not have_units else "set the password again", None
        if args.dry_run:
            print(f"  [dry-run] NAS {c['name']}: would {plan}")
            continue
        if req is None:
            if not sys.stdin.isatty():
                raise NasError(f"need a terminal to ask for the password of NAS {c['name']}: run ./install.sh --nas from a terminal")
            if not user:
                user = input(f"NAS {c['name']} user name: ").strip()
            pw = nas_read_password(f"NAS password for {user} (not shown, kept only in the root-only password file): ")
            req = {"verb": "edit" if have_units else "add", "name": c["name"], **f, "username": user, "password": pw}
        r = nas_call({**req, **nas_uid_fields()}, use_sudo=True)
        req = pw = None
        if r["ok"]:
            print(f"  NAS {c['name']}: {r['message']}")
            for n in r.get("notes", []):
                print("    " + n)
            try:
                nas_bookmark(c["mountpoint"], "NAS" if c["name"] == "nax" else c["name"], True)
            except OSError:
                pass
        else:
            failed += 1
            print(f"hyprdeb: error: NAS {c['name']}: {r['error']}", file=sys.stderr)
    return NAS_EXIT["error"] if failed else 0



# ---------------------------------------------------------------- printing
# [printing] in settings.toml: printer_name, printer_uri = "socket://a.b.c.d:9100", default = true. The Canon LBP6030w has no IPP, so
# the queue uses Canon's own PPD (from the user's own .deb, never shipped here) over the raw port. `print status` only reads;
# `print config` is for install.sh --printing. Nothing here needs root.

PRINT_CANON_PKG = "cnrdrvcups-ufr2lt-uk"
PRINT_CANON_PPD = "/usr/share/cups/model/CNRCUPSLBP6030ZNK.ppd"
PRINT_CANON_FILTER = "/usr/lib/cups/filter/rastertosfp"


def print_config(args):
    """The validated [printing] values, or None when printer_name/printer_uri are not set. "driver" is what the queue uses:
    "ppd" (the ppd key), "everywhere" or "canon-lbp6030"; with neither key set it follows the address: ipp/ipps = everywhere, a
    socket:// raw port = canon-lbp6030 (the behaviour before the driver key existed)."""
    p = load_validated(args)["printing"]
    name, uri = p.get("printing.printer_name"), p.get("printing.printer_uri")
    if not name or not uri:
        return None
    m = re.fullmatch(r"(socket|ipp|ipps)://([^:/]+)(?::(\d+))?(?:/.*)?", uri)
    scheme = m.group(1)
    ppd = p.get("printing.ppd", "")
    driver = "ppd" if ppd else p.get("printing.driver") or ("canon-lbp6030" if scheme == "socket" else "everywhere")
    port = int(m.group(3) or {"socket": 9100, "ipp": 631, "ipps": 631}[scheme])
    return {"name": name, "uri": uri, "host": m.group(2), "port": port, "default": bool(p.get("printing.default")), "driver": driver, "ppd": ppd}


PRINT_TIMEOUT = 3          # seconds for each lpstat / dpkg / systemctl call: a stuck CUPS must not hang the status
PRINT_JOB_STATES = {"pending": "waiting", "pending-held": "held", "processing": "printing", "processing-stopped": "stopped",
                    "canceled": "canceled", "aborted": "aborted", "completed": "done"}      # ipptool -c prints the IPP keyword, not the number
PRINT_JOBS_TEST = """{
	NAME "Get pending jobs"
	OPERATION Get-Jobs
	GROUP operation-attributes-tag
	ATTR charset attributes-charset utf-8
	ATTR language attributes-natural-language en
	ATTR uri printer-uri $uri
	ATTR name requesting-user-name $user
	ATTR keyword which-jobs not-completed
	ATTR keyword requested-attributes job-id,job-name,job-state,job-k-octets,time-at-creation,job-originating-user-name
	STATUS successful-ok
	DISPLAY job-id
	DISPLAY job-name
	DISPLAY job-state
	DISPLAY job-k-octets
	DISPLAY time-at-creation
	DISPLAY job-originating-user-name
}
"""


def print_run(argv, timeout=PRINT_TIMEOUT):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


def print_status(args):
    """{"ok", "lines", "checks", "code"}: configured? driver? cups? queue? printer reachable? jobs? Each check is ok/fail/skip."""
    checks = []

    def add(label, state, detail):
        checks.append({"label": label, "state": state, "detail": detail})

    cfg = print_config(args)
    if cfg is None:
        add("settings", "skip", "not set: add printer_name and printer_uri under [printing] in settings.toml, then run ./install.sh --printing")
        return print_result(checks)
    add("settings", "ok", f"{cfg['name']} -> {cfg['uri']}")
    if cfg["driver"] == "canon-lbp6030":
        rc, out = print_run(["dpkg-query", "-W", "-f=${Status}", PRINT_CANON_PKG])
        pkg_ok = rc == 0 and out.endswith("installed") and "not-installed" not in out
        ppd_ok = os.path.isfile(PRINT_CANON_PPD)
        add("Canon driver", "ok" if pkg_ok and ppd_ok else "fail",
            f"{PRINT_CANON_PKG} installed, PPD present" if pkg_ok and ppd_ok
            else f"{PRINT_CANON_PKG} or {PRINT_CANON_PPD} missing: install Canon's .deb yourself (it is never downloaded or shipped here)")
    elif cfg["driver"] == "ppd":
        ppd_ok = os.path.isfile(cfg["ppd"])
        add("PPD", "ok" if ppd_ok else "fail", cfg["ppd"] + (" present" if ppd_ok else " is missing: install the driver that ships it, or fix [printing] ppd"))
    else:
        add("driver", "ok", "driverless IPP (lpadmin -m everywhere)")
    rc, _ = print_run(["systemctl", "is-active", "--quiet", "cups.service"])
    cups_ok = rc == 0
    add("CUPS", "ok" if cups_ok else "fail", "cups.service active" if cups_ok else "cups.service is not running: ./install.sh --printing")
    if cups_ok:
        rc, out = print_run(["lpstat", "-p", cfg["name"]])
        if rc != 0:
            add("queue", "fail", f"queue {cfg['name']} does not exist: ./install.sh --printing")
        else:
            state = "disabled" if "disabled" in out else "idle" if "idle" in out else "printing" if "now printing" in out else out.splitlines()[0]
            rc2, uri_out = print_run(["lpstat", "-v", cfg["name"]])
            uri_now = uri_out.rsplit(" ", 1)[-1] if rc2 == 0 else ""
            if "disabled" in out:
                add("queue", "fail", f"{cfg['name']} is disabled (cupsenable {cfg['name']})")
            elif uri_now and uri_now != cfg["uri"]:
                add("queue", "fail", f"{cfg['name']} points at {uri_now}, settings.toml says {cfg['uri']}: ./install.sh --printing")
            else:
                add("queue", "ok", f"{cfg['name']} {state}")
            pj = print_jobs(args)
            if pj["ok"]:
                held = len([j for j in pj["jobs"] if j["state"] == "held"])
                waiting = len(pj["jobs"]) - held
                parts = ([f"{waiting} waiting (they print when the printer is reachable)"] if waiting else []) + \
                        ([f"{held} held (they print only when released)"] if held else [])
                add("jobs", "info" if parts else "ok", ", ".join(parts) if parts else "none waiting")
            else:    # IPP did not answer: fall back to the plain count
                rc3, jobs = print_run(["lpstat", "-o", cfg["name"]])
                n = len([l for l in jobs.splitlines() if l.strip()]) if rc3 == 0 else 0
                add("jobs", "ok" if n == 0 else "info", "none waiting" if n == 0 else f"{n} not finished (they print when the printer is reachable)")
    try:
        socket.create_connection((cfg["host"], cfg["port"]), timeout=NET_CHECK_TIMEOUT).close()
        add("printer", "ok", "answers on its print port")
    except OSError:
        add("printer", "fail", "does not answer (off, asleep or not on the network): jobs wait in the queue")
    return print_result(checks)


def print_result(checks):
    marks = {"ok": "OK  ", "fail": "FAIL", "skip": "--  ", "info": "..  "}
    lines = [f"{marks[c['state']]} {c['label']}: {c['detail']}" for c in checks]
    failed = any(c["state"] == "fail" for c in checks)
    return {"ok": not failed, "checks": checks, "lines": lines, "code": 1 if failed else 0}


def print_jobs(args):
    """{"ok", "name", "jobs": [{"id", "title", "state", "kib", "age_s", "user"}], "error"?, "code"}: the jobs not yet completed in the
    [printing] queue, asked of CUPS over IPP with ipptool (the Get-Jobs test comes on stdin: no temp file). Titles are the senders' text:
    they are data, never code, and the caller must show them as plain text."""
    import csv
    import io
    cfg = print_config(args)
    if cfg is None:
        return {"ok": False, "name": None, "jobs": [], "error": "[printing] is not set", "code": 3}
    if not shutil.which("ipptool"):
        return {"ok": False, "name": cfg["name"], "jobs": [], "error": "ipptool is not installed (cups-client)", "code": 3}
    try:
        r = subprocess.run(["ipptool", "-c", f"ipp://localhost/printers/{cfg['name']}", "/dev/stdin"], input=PRINT_JOBS_TEST,
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        return {"ok": False, "name": cfg["name"], "jobs": [], "error": f"could not ask CUPS: {e}", "code": 3}
    if r.returncode != 0:
        return {"ok": False, "name": cfg["name"], "jobs": [], "error": "CUPS did not answer (is cups.service running?)", "code": 3}
    jobs, now = [], time.time()
    for row in csv.DictReader(io.StringIO(r.stdout)):
        try:
            jid = int(row["job-id"])
            created = int(row["time-at-creation"])
            state = row["job-state"]
            kib = int(row["job-k-octets"] or 0)
        except (KeyError, ValueError):
            continue
        jobs.append({"id": jid, "title": row.get("job-name", ""), "state": PRINT_JOB_STATES.get(state, state), "kib": kib,
                     "age_s": max(0, int(now - created)), "user": row.get("job-originating-user-name", "")})
    return {"ok": True, "name": cfg["name"], "jobs": jobs, "code": 0}


def print_cancel(args):
    cfg = print_config(args)
    if cfg is None:
        raise SettingsError("[printing] is not set")
    if not args.arg or not re.fullmatch(r"[0-9]{1,9}", args.arg):
        raise SettingsError("usage: hyprdeb print cancel JOB_ID (a number from: hyprdeb print jobs)")
    jid = int(args.arg)
    st = print_jobs(args)
    if not st["ok"]:
        raise SettingsError(st["error"])
    if jid not in [j["id"] for j in st["jobs"]]:
        raise SettingsError(f"no waiting job {jid} in {cfg['name']}")
    rc, out = print_run(["cancel", str(jid)], timeout=10)
    if rc != 0:
        raise SettingsError(f"could not cancel job {jid}: {out or 'cancel failed'}")
    print(f"job {jid} canceled")
    return 0


def print_testpage(args):
    """One sheet of paper: only with --yes. CUPS's own test page, queued on the [printing] queue."""
    cfg = print_config(args)
    if cfg is None:
        raise SettingsError("[printing] is not set")
    if not args.yes:
        raise SettingsError("the test page uses one sheet of paper: pass --yes to print it")
    rc, out = print_run(["lp", "-d", cfg["name"], "/usr/share/cups/data/testprint"], timeout=10)
    if rc != 0:
        raise SettingsError(f"could not queue the test page: {out or 'lp failed'}")
    print(out or "test page queued")
    return 0


def cmd_print(args):
    """hyprdeb print status [--json]: exit 0 fine (or not configured), 1 a check failed, 3 error. hyprdeb print config: name=, uri=,
    default=, host=, port=, driver=, ppd= for install.sh (exit 3 when [printing] is not set). jobs [--json]: the waiting jobs. cancel ID: cancel one
    of them. testpage --yes: print CUPS's test page (one sheet)."""
    try:
        if args.action == "config":
            cfg = print_config(args)
            if cfg is None:
                print("hyprdeb: [printing] has no printer_name and printer_uri: nothing to install", file=sys.stderr)
                return 3
            for k in ("name", "uri", "host", "port", "driver", "ppd"):
                print(f"{k}={cfg[k]}")
            print(f"default={1 if cfg['default'] else 0}")
            return 0
        if args.action == "jobs":
            st = print_jobs(args)
            if args.json:
                print(json.dumps(st, indent=2, ensure_ascii=False))
            elif not st["ok"]:
                print(f"hyprdeb: {st['error']}", file=sys.stderr)
            else:
                for j in st["jobs"]:
                    print(f"{j['id']}\t{j['state']}\t{j['kib']} KiB\t{j['age_s']} s\t{j['title']}")
            return st["code"]
        if args.action == "cancel":
            return print_cancel(args)
        if args.action == "testpage":
            return print_testpage(args)
        st = print_status(args)
    except (SettingsError, OSError) as e:
        print(f"hyprdeb: error: {e}", file=sys.stderr)
        return 3
    if args.json:
        print(json.dumps(st, indent=2))
    else:
        print("\n".join(st["lines"]))
    return st["code"]


# ---------------------------------------------------------------- VPN / WireGuard
# A WireGuard profile is imported once into NetworkManager as hyprdeb-wg-NAME (interface wg-NAME, autoconnect no: never at boot), then
# switched on and off with `hyprdeb vpn on|off`. The keys live only in the NM system profile (root-only); nothing here prints, logs
# or copies the .conf or any key: the file is parsed only to check its shape, and every message from nmcli is scrubbed of the
# secrets read from the file before it is shown. NM does the routing (own table + fwmark + suppress_prefixlength 0 for a /0 peer, so
# LAN routes stay direct). No wireguard-tools: "does traffic pass" is a route check + a TCP connect + rx/tx bytes.

VPN_EXIT = {"ok": 0, "no_traffic": 1, "error": 3, "exists": 4, "cancelled": 5, "busy": 6}
VPN_CONF_MAX = 65536
VPN_PROBE_SECONDS = 10
VPN_LAN_DNS_PRIORITY = 200      # above the 100 of an ethernet profile (and the 50 of a VPN): the LAN resolver is asked first
VPN_UNSUPPORTED_KEYS = ("preup", "postup", "predown", "postdown", "saveconfig")


class VpnError(Exception):
    def __init__(self, msg, code=3):
        super().__init__(msg)
        self.code = code


def vpn_nm(*args, timeout=30):
    """(returncode, stdout, stderr) of nmcli; timeouts and a missing nmcli become VpnError."""
    try:
        r = subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        raise VpnError("nmcli is not installed (NetworkManager is needed: ./install.sh --networkmanager)")
    except subprocess.TimeoutExpired:
        raise VpnError(f"nmcli {args[0]} timed out")
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def vpn_scrub(text, secrets):
    for sec in secrets:
        if sec:
            text = text.replace(sec, "***")
    return text


def vpn_read_conf(path):
    """The text of a .conf file, after the size and type checks."""
    try:
        st = os.stat(path)
    except OSError as e:
        raise VpnError(f"{path}: {e.strerror}")
    if not os.path.isfile(path):
        raise VpnError(f"{path}: not a regular file")
    if st.st_size > VPN_CONF_MAX:
        raise VpnError(f"{path}: too large for a WireGuard configuration")
    if st.st_mode & 0o077:
        print(f"hyprdeb: warning: {path} can be read by other users: chmod 600 it", file=sys.stderr)
    try:
        return open(path, encoding="utf-8", errors="replace").read()
    except OSError as e:
        raise VpnError(f"{path}: {e.strerror}")


def vpn_read_stdin():
    """The configuration text from stdin (the GUI paste box, or a pipe): at most VPN_CONF_MAX bytes, UTF-8, CRLF turned into LF."""
    data = sys.stdin.buffer.read(VPN_CONF_MAX + 1)
    if len(data) > VPN_CONF_MAX:
        raise VpnError("the text is too large for a WireGuard configuration (64 KiB at most)")
    if not data.strip():
        raise VpnError("nothing to import: the text is empty")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise VpnError("the text is not valid UTF-8")
    if "\0" in text:
        raise VpnError("not a WireGuard configuration (binary data)")
    return text.replace("\r\n", "\n").replace("\r", "\n")


def vpn_parse_conf(path):
    """Check that the file `path` is a WireGuard configuration this feature supports (see vpn_parse_text)."""
    return vpn_parse_text(vpn_read_conf(path))


def vpn_parse_text(text):
    """Check that `text` is a WireGuard configuration this feature supports, WITHOUT returning or printing any secret.
    Returns {"secrets": set, "endpoint_host", "addresses", "allowed", "has_dns"}; raises VpnError("not supported: ...")."""
    sections, cur = [], None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            cur = (line[1:-1].strip().lower(), {})
            sections.append(cur)
            continue
        if cur is None or "=" not in line:
            raise VpnError("not a WireGuard configuration (unexpected line outside a section)")
        k, v = line.split("=", 1)
        cur[1][k.strip().lower()] = v.strip()
    ifaces = [d for n, d in sections if n == "interface"]
    peers = [d for n, d in sections if n == "peer"]
    if len(ifaces) != 1 or any(n not in ("interface", "peer") for n, _ in sections):
        raise VpnError("not a WireGuard configuration (needs one [Interface] section)")
    ifc = ifaces[0]
    secrets = {ifc.get("privatekey", "")} | {d.get("presharedkey", "") for d in peers}
    secrets.discard("")
    if "privatekey" not in ifc:
        raise VpnError("not a WireGuard configuration (the [Interface] has no PrivateKey)")
    if len(peers) == 0:
        raise VpnError("not supported: the configuration has no [Peer]")
    if len(peers) > 1:
        raise VpnError(f"not supported: {len(peers)} [Peer] sections (exactly one is supported)")
    bad = [k for k in VPN_UNSUPPORTED_KEYS if k in ifc]
    if bad:
        raise VpnError("not supported: wg-quick scripts/options in [Interface] (PreUp, PostUp, PreDown, PostDown, SaveConfig)")
    if ifc.get("table", "auto").lower() != "auto":
        raise VpnError("not supported: a Table setting other than auto (NetworkManager does the routing)")
    peer = peers[0]
    ep = peer.get("endpoint", "")
    if not ep:
        raise VpnError("not supported: the [Peer] has no Endpoint")
    if "publickey" not in peer or not peer.get("allowedips"):
        raise VpnError("not a WireGuard configuration (the [Peer] needs PublicKey and AllowedIPs)")
    host = ep.rsplit(":", 1)[0].strip("[]") if ":" in ep else ep
    addresses = [a.strip() for a in ifc.get("address", "").split(",") if a.strip()]
    if not addresses:
        raise VpnError("not supported: the [Interface] has no Address")
    allowed = [a.strip() for a in peer["allowedips"].split(",") if a.strip()]
    return {"secrets": secrets, "endpoint_host": host, "addresses": addresses, "allowed": allowed, "has_dns": "dns" in ifc}


def vpn_name_from_file(path):
    stem = os.path.basename(path)
    stem = stem[:-5] if stem.endswith(".conf") else stem
    name = re.sub(r"[^a-z0-9-]", "-", stem.lower()).strip("-")
    if not VPN_NAME_RE.match(name):
        raise VpnError(f"cannot make a profile name from the file name {os.path.basename(path)!r} (1 to 11 characters from a-z, 0-9, '-'): use --name NAME")
    return name


def vpn_check_name(name):
    if not isinstance(name, str) or not VPN_NAME_RE.match(name):
        raise VpnError(f"profile name {name!r}: 1 to 11 characters from a-z, 0-9 and '-', not starting with '-' (the interface is wg-NAME and Linux limits it to 15 characters)")
    return name


def vpn_split(line):
    return [p.replace("\\:", ":").replace("\\\\", "\\") for p in re.split(r"(?<!\\):", line)]


def vpn_profiles():
    """[{"name", "short", "uuid", "iface", "active"}] for every hyprdeb-wg-* WireGuard profile, sorted by name."""
    rc, out, err = vpn_nm("-t", "-f", "NAME,UUID,TYPE,DEVICE", "connection", "show")
    if rc != 0:
        raise VpnError(f"nmcli: {err or 'failed'}")
    rows = []
    for line in out.splitlines():
        f = vpn_split(line)
        if len(f) >= 4 and f[2] == "wireguard" and f[0].startswith(VPN_PREFIX):
            rows.append({"name": f[0], "short": f[0][len(VPN_PREFIX):], "uuid": f[1], "iface": f[3] if f[3] not in ("", "--") else None,
                         "active": f[3] not in ("", "--")})
    return sorted(rows, key=lambda r: r["name"])


def vpn_active_names():
    """Names of the active hyprdeb-wg-* profiles; [] when NetworkManager cannot be asked. (net status uses this too.)"""
    try:
        rc, out, _ = vpn_nm("-t", "-f", "NAME,TYPE", "connection", "show", "--active", timeout=5)
    except VpnError:
        return []
    names = []
    for line in out.splitlines() if rc == 0 else []:
        f = vpn_split(line)
        if len(f) >= 2 and f[1] == "wireguard" and f[0].startswith(VPN_PREFIX):
            names.append(f[0])
    return names


def vpn_settings(args):
    try:
        return load_validated(args)["vpn"]
    except (SettingsError, OSError):
        return {}


def vpn_pick(args, profiles, want):
    """The profile for `vpn on|off|remove [NAME]`: the argument, else [vpn] default, else the only one, else (off) the active one."""
    if not profiles:
        raise VpnError("no VPN profile: import one with  hyprdeb vpn import FILE.conf")
    if want:
        want = vpn_check_name(want)
        for p in profiles:
            if p["short"] == want:
                return p
        raise VpnError(f"no VPN profile {want!r} (have: {', '.join(p['short'] for p in profiles)})")
    d = vpn_settings(args).get("vpn.default")
    if d:
        for p in profiles:
            if p["short"] == d:
                return p
        raise VpnError(f"[vpn] default = {d!r} does not exist (have: {', '.join(p['short'] for p in profiles)})")
    if len(profiles) == 1:
        return profiles[0]
    raise VpnError(f"more than one VPN profile ({', '.join(p['short'] for p in profiles)}): give the name, or set default under [vpn]")


def vpn_apply_dns(args, prof):
    """Make ipv4/ipv6 dns-priority match [vpn] keep_lan_dns (true: the LAN resolver is asked first; false: NM's default, the tunnel DNS first)."""
    want = str(VPN_LAN_DNS_PRIORITY if vpn_settings(args).get("vpn.keep_lan_dns") else 0)
    rc, out, _ = vpn_nm("-g", "ipv4.dns-priority,ipv6.dns-priority", "connection", "show", "uuid", prof["uuid"])
    if rc == 0 and out.split("\n") == [want, want]:
        return
    rc, _, err = vpn_nm("connection", "modify", "uuid", prof["uuid"], "ipv4.dns-priority", want, "ipv6.dns-priority", want)
    if rc != 0:
        raise VpnError(f"could not set the DNS priority: {err}")


def vpn_check_target():
    try:
        v = load_validated(argparse.Namespace(settings=DEFAULT_SETTINGS))["network"].get("network.internet_check")
    except (SettingsError, OSError):
        v = None
    host, _, port = (v or NET_INTERNET_DEFAULT).rpartition(":")
    return host, int(port)


def vpn_bytes(iface, which):
    try:
        return int(open(f"/sys/class/net/{iface}/statistics/{which}_bytes").read())
    except (OSError, ValueError):
        return None


def vpn_probe(iface, timeout=2.0):
    """{"iface_up", "route_dev", "tcp", "rx", "tx", "split"}: does the check target go through the tunnel and answer?
    A TCP connect can only succeed through the tunnel after the handshake, so it also proves the handshake without root."""
    res = {"iface_up": os.path.isdir(f"/sys/class/net/{iface}"), "route_dev": None, "tcp": None, "rx": vpn_bytes(iface, "rx"),
           "tx": vpn_bytes(iface, "tx"), "split": False}
    if not res["iface_up"]:
        return res
    host, port = vpn_check_target()
    try:
        ip = str(ipaddress.ip_address(host))
    except ValueError:
        try:
            ip = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
        except OSError:
            ip = None
    if ip:
        try:
            routes = net_ip("route", "get", ip)
            res["route_dev"] = routes[0].get("dev") if routes else None
        except (OSError, ValueError):
            pass
    if res["route_dev"] not in (None, iface):
        res["split"] = True         # a split tunnel: the check target does not use it, so traffic cannot be shown this way
        return res
    if ip:
        try:
            socket.create_connection((ip, port), timeout=timeout).close()
            res["tcp"] = True
        except OSError:
            res["tcp"] = False
    res["rx"], res["tx"] = vpn_bytes(iface, "rx"), vpn_bytes(iface, "tx")
    return res


def vpn_human(n):
    if n is None:
        return "n/a"
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def vpn_tmpdir():
    """A fresh 0700 directory on tmpfs ($XDG_RUNTIME_DIR) for the one file nmcli reads."""
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if not os.path.isdir(base):
        raise VpnError("no $XDG_RUNTIME_DIR (tmpfs) for the temporary file: import from a desktop session")
    return tempfile.mkdtemp(prefix="hyprdeb-vpn-", dir=base)


def vpn_clipboard_scrub(secrets):
    """Remove every clipboard-history entry that holds one of the configuration's key values, and clear the clipboard and the
    primary selection when they still hold one. Returns {"history": n, "clipboard": bool, "primary": bool}; prints and returns
    nothing secret. Failures of the helpers (no cliphist, no Wayland) just leave that part undone."""
    keys = [k.encode() for k in secrets if len(k) >= 16]
    res = {"history": 0, "clipboard": False, "primary": False}
    if not keys:
        return res

    def holds(data):
        return any(k in data for k in keys)

    for flag, field in ((None, "clipboard"), ("--primary", "primary")):
        try:
            r = subprocess.run(["wl-paste", "--no-newline"] + ([flag] if flag else []), capture_output=True, timeout=3)
            if r.returncode == 0 and holds(r.stdout):
                if subprocess.run(["wl-copy", "--clear"] + ([flag] if flag else []), capture_output=True, timeout=3).returncode == 0:
                    res[field] = True
        except (OSError, subprocess.TimeoutExpired):
            pass
    try:
        lst = subprocess.run(["cliphist", "list"], capture_output=True, timeout=10)
        if lst.returncode == 0:
            for line in lst.stdout.split(b"\n"):
                if not line.strip():
                    continue
                dec = subprocess.run(["cliphist", "decode"], input=line, capture_output=True, timeout=10)
                if dec.returncode == 0 and holds(dec.stdout):
                    if subprocess.run(["cliphist", "delete"], input=line, capture_output=True, timeout=10).returncode == 0:
                        res["history"] += 1
    except (OSError, subprocess.TimeoutExpired):
        pass
    return res


def vpn_import(args):
    from_stdin = args.arg == "-"
    if not args.arg:
        raise VpnError("usage: hyprdeb vpn import FILE.conf [--name NAME] [--replace]   or   hyprdeb vpn import - --name NAME (text on stdin)")
    path = text = None
    if from_stdin:
        if not args.name:
            raise VpnError("importing from stdin needs --name NAME")
        text = vpn_read_stdin()
        info = vpn_parse_text(text)
    else:
        path = os.path.abspath(os.path.expanduser(args.arg))
        info = vpn_parse_conf(path)
    name = vpn_check_name(args.name) if args.name else vpn_name_from_file(path)
    profile, iface = VPN_PREFIX + name, "wg-" + name
    old = [p for p in vpn_profiles() if p["name"] == profile]
    if old and not args.replace:
        raise VpnError(f"the profile {profile} already exists: use --replace to import over it, or --name for another one", code=VPN_EXIT["exists"])
    # nmcli takes the interface name from the file name, so it reads wg-NAME.conf in a private directory on tmpfs: a symlink to the
    # user's file (nothing is copied), or, for text from stdin, a 0600 file that is deleted together with the directory below.
    tmp = vpn_tmpdir()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))      # the finally block below must run on a kill too
    link = os.path.join(tmp, iface + ".conf")
    uuid = None
    try:
        if from_stdin:
            fd = os.open(link, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
        else:
            os.symlink(path, link)
        rc, out, err = vpn_nm("connection", "import", "type", "wireguard", "file", link)
        if rc != 0:
            raise VpnError("nmcli could not import the file: " + vpn_scrub(err or out or "failed", info["secrets"]))
        m = re.search(r"\(([0-9a-fA-F-]{36})\)", out)
        if not m:
            raise VpnError("imported, but nmcli did not report the new profile")
        uuid = m.group(1)
        if old:
            for o in old:
                if o["active"]:
                    vpn_nm("connection", "down", "uuid", o["uuid"])
                vpn_nm("connection", "delete", "uuid", o["uuid"])
        rc, _, err = vpn_nm("connection", "modify", "uuid", uuid, "connection.id", profile, "connection.interface-name", iface,
                            "connection.autoconnect", "no")
        if rc != 0:
            raise VpnError("could not rename the profile: " + vpn_scrub(err, info["secrets"]))
        vpn_apply_dns(args, {"uuid": uuid})
        rc, flags, _ = vpn_nm("-g", "connection.autoconnect,connection.interface-name,wireguard.private-key-flags", "connection", "show", "uuid", uuid)
        got = flags.split("\n") if rc == 0 else []
        if got[:2] != ["no", iface]:
            raise VpnError("the imported profile does not have the expected settings (autoconnect no, interface " + iface + ")")
        pk_flags = got[2] if len(got) > 2 else "?"
        # nmcli activates a WireGuard profile as soon as it is imported (seen on NM 1.52.1): the tunnel must stay off until asked for.
        vpn_nm("connection", "down", "uuid", uuid)
        for _ in range(10):
            if not os.path.isdir(f"/sys/class/net/{iface}"):
                break
            time.sleep(0.5)
    except BaseException:
        if uuid:       # a half-made profile is removed, not left behind
            vpn_nm("connection", "delete", "uuid", uuid)
        raise
    finally:
        try:
            os.unlink(link)
        except OSError:
            pass
        try:
            os.rmdir(tmp)
        except OSError:
            pass
    full = any(a in ("0.0.0.0/0", "::/0") for a in info["allowed"])
    print(f"imported: {profile}  (interface {iface}, autoconnect no)")
    print(f"endpoint host: {info['endpoint_host']}")
    print(f"address: {', '.join(info['addresses'])}")
    print("routes: " + ("full tunnel (all traffic)" if full else "only " + ", ".join(info["allowed"])))
    print("DNS: " + ("from the configuration (used while the tunnel is on)" if info["has_dns"] else "none in the configuration"))
    print(f"private key: stored in the NetworkManager system profile (secret flags {pk_flags}); no key is shown anywhere")
    if args.scrub_clipboard:
        res = vpn_clipboard_scrub(info["secrets"])
        parts = [f"clipboard history: {res['history']} {'entry' if res['history'] == 1 else 'entries'} removed",
                 "clipboard cleared" if res["clipboard"] else "clipboard did not hold it",
                 "primary selection cleared" if res["primary"] else "primary selection did not hold it"]
        print("; ".join(parts) + " (removed from history and clipboard, not securely wiped)")
    if from_stdin:
        print(f"Nothing was kept on disk. Turn on with: hyprdeb vpn on {name}")
    else:
        print(f"You can delete {path} now. Turn on with: hyprdeb vpn on {name}")
    return 0


def portal_pick(title, filters=None, directory=False, start=None):
    """Ask the desktop portal (GTK file chooser) for a file (a filter is (name, [globs]); no filter = every file) or a folder.
    Returns the chosen path, or None when cancelled. VpnError (exit 3) when no chooser is available. Shared by `vpn pick-file`
    and `wallpaper pick`."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except (ImportError, ValueError):
        raise VpnError("no file chooser: python3-gi is not installed")
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except GLib.Error as e:
        raise VpnError("no file chooser: no session bus")
    token = "hyprdeb" + str(os.getpid())
    sender = bus.get_unique_name()[1:].replace(".", "_")
    request = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    out = {}

    def on_response(_c, _s, _p, _i, _sig, params):
        out["code"], results = params.unpack()
        out["uris"] = results.get("uris", [])
        loop.quit()

    sub = bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response", request, None,
                               Gio.DBusSignalFlags.NONE, on_response)
    opts = {"handle_token": GLib.Variant("s", token), "modal": GLib.Variant("b", True)}
    if directory:
        opts["directory"] = GLib.Variant("b", True)
    elif filters:
        opts["filters"] = GLib.Variant("a(sa(us))", [(name, [(0, g) for g in globs]) for name, globs in filters])
    if start and os.path.isdir(start):
        opts["current_folder"] = GLib.Variant("ay", os.fsencode(start) + b"\0")
    try:
        bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop", "org.freedesktop.portal.FileChooser", "OpenFile",
                      GLib.Variant("(ssa{sv})", ("", title, opts)), None, Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error:
        bus.signal_unsubscribe(sub)
        raise VpnError("no file chooser: the desktop portal did not answer")
    GLib.timeout_add_seconds(600, loop.quit)
    loop.run()
    bus.signal_unsubscribe(sub)
    if out.get("code") != 0 or not out.get("uris"):
        return None
    uri = out["uris"][0]
    if not uri.startswith("file://"):
        raise VpnError("the chosen item is not a local file")
    return urllib.parse.unquote(uri[len("file://"):])


def vpn_pick_file():
    """Ask the desktop portal for a .conf file; print only the chosen path. Exit 0 chosen, 5 cancelled, 3 unavailable."""
    try:
        path = portal_pick("Choose a WireGuard configuration", [("WireGuard configuration (*.conf)", ["*.conf"]), ("All files", ["*"])])
    except VpnError as e:
        raise VpnError(f"{e} (paste the text instead)")
    if path is None:
        return VPN_EXIT["cancelled"]
    print(path)
    return 0


def vpn_on(args):
    profiles = vpn_profiles()
    prof = vpn_pick(args, profiles, args.arg)
    if prof["active"]:
        print(f"{prof['name']} is already on ({prof['iface']})")
        return VPN_EXIT["ok"]
    other = [p for p in profiles if p["active"]]
    if other:
        raise VpnError(f"only one tunnel at a time: {other[0]['short']} is on, turn it off first (hyprdeb vpn off {other[0]['short']})", code=VPN_EXIT["busy"])
    vpn_apply_dns(args, prof)
    rc, _, err = vpn_nm("-w", "20", "connection", "up", "uuid", prof["uuid"], timeout=40)
    if rc != 0:
        raise VpnError(f"could not turn {prof['name']} on: {err or 'nmcli failed'}")
    iface = "wg-" + prof["short"]
    deadline = time.monotonic() + VPN_PROBE_SECONDS
    pr = vpn_probe(iface)
    while not (pr["tcp"] or pr["split"]) and time.monotonic() < deadline:
        time.sleep(1)
        pr = vpn_probe(iface)
    if pr["tcp"] or pr["split"]:
        note = "" if pr["tcp"] else " (a split tunnel: the check target does not use it, so traffic was not tested)"
        print(f"{prof['name']} is on via {iface}: traffic passes{note}" if pr["tcp"] else f"{prof['name']} is on via {iface}{note}")
        return VPN_EXIT["ok"]
    msg = (f"{prof['name']} is connected but no traffic got through in {VPN_PROBE_SECONDS} s (no handshake: the endpoint is "
           f"unreachable or blocked, or the keys do not match)")
    if args.keep:
        print(msg + "; it stays on (--keep)", file=sys.stderr)
    else:
        vpn_nm("connection", "down", "uuid", prof["uuid"])
        print(msg + "; turned off again (use --keep to leave it on)", file=sys.stderr)
    return VPN_EXIT["no_traffic"]


def vpn_off(args):
    profiles = vpn_profiles()
    active = [p for p in profiles if p["active"]]
    if args.arg:
        prof = vpn_pick(args, profiles, args.arg)
        active = [prof] if prof["active"] else []
    elif not active and not profiles:
        raise VpnError("no VPN profile: import one with  hyprdeb vpn import FILE.conf")
    if not active:
        print("VPN is off")
        return VPN_EXIT["ok"]
    for p in active:
        rc, _, err = vpn_nm("connection", "down", "uuid", p["uuid"])
        if rc != 0:
            raise VpnError(f"could not turn {p['name']} off: {err or 'nmcli failed'}")
        iface = "wg-" + p["short"]
        for _ in range(10):
            if not os.path.isdir(f"/sys/class/net/{iface}"):
                break
            time.sleep(0.5)
        print(f"{p['name']} is off")
    return VPN_EXIT["ok"]


def vpn_status(args):
    profiles = vpn_profiles()
    d = vpn_settings(args)
    st = {"profiles": [], "active": None, "default": d.get("vpn.default"), "keep_lan_dns": bool(d.get("vpn.keep_lan_dns")), "code": 0}
    for p in profiles:
        st["profiles"].append({"name": p["short"], "profile": p["name"], "active": p["active"], "iface": p["iface"]})
    lines = []
    if not profiles:
        lines.append("VPN: no profile. Import a WireGuard configuration once:  hyprdeb vpn import FILE.conf")
    for p in profiles:
        if not p["active"]:
            lines.append(f"VPN {p['short']}: off" + ("  (default)" if p["short"] == st["default"] else ""))
            continue
        pr = vpn_probe(p["iface"], timeout=1.5)
        ok = bool(pr["tcp"]) or pr["split"]
        st["active"] = {"name": p["short"], "iface": p["iface"], "traffic": pr["tcp"], "split": pr["split"], "route_dev": pr["route_dev"],
                        "rx": pr["rx"], "tx": pr["tx"]}
        if not ok:
            st["code"] = 1
        word = "traffic passes" if pr["tcp"] else "split tunnel (not tested)" if pr["split"] else "NO traffic (no handshake? endpoint unreachable or blocked)"
        lines.append(f"VPN {p['short']}: on via {p['iface']}, {word}; received {vpn_human(pr['rx'])}, sent {vpn_human(pr['tx'])}")
    if st["keep_lan_dns"]:
        lines.append("DNS: the LAN resolver is asked first (keep_lan_dns); names are then NOT resolved through the tunnel")
    st["lines"] = lines
    return st


def vpn_set_default(args, value):
    """Set (or, with "", remove) [vpn] default in settings.toml, keeping its comments. Only that key changes and nothing is regenerated
    (no generated file depends on it). A failure is reported on stderr and does not undo the profile change."""
    path = args.settings or DEFAULT_SETTINGS
    try:
        import tomlkit
        old = read_or_none(path)
        doc = tomlkit.parse(old or "")
        if value:
            if "vpn" not in doc:
                doc["vpn"] = tomlkit.table()
            doc["vpn"]["default"] = value
        elif "vpn" in doc and "default" in doc["vpn"]:
            del doc["vpn"]["default"]
        new = tomlkit.dumps(doc)
        validate(tomllib.loads(new))
        if new != (old or ""):
            write_atomic(path, new)
    except (ImportError, OSError, SettingsError, tomllib.TOMLDecodeError) as e:
        print(f"hyprdeb: could not update [vpn] default in {path}: {e}", file=sys.stderr)


def vpn_remove(args):
    profiles = vpn_profiles()
    prof = vpn_pick(args, profiles, args.arg) if args.arg else None
    if prof is None:
        raise VpnError("usage: hyprdeb vpn remove NAME")
    if not args.yes:
        if not sys.stdin.isatty():
            raise VpnError("remove asks for a confirmation in a terminal; pass --yes to skip it")
        if input(f"Delete the VPN profile {prof['name']} (its key is deleted with it)? [y/N] ").strip().lower() not in ("y", "yes"):
            print("kept")
            return VPN_EXIT["ok"]
    if prof["active"]:
        vpn_nm("connection", "down", "uuid", prof["uuid"])
    rc, _, err = vpn_nm("connection", "delete", "uuid", prof["uuid"])
    if rc != 0:
        raise VpnError(f"could not delete {prof['name']}: {err}")
    print(f"{prof['name']} removed")
    if vpn_settings(args).get("vpn.default") == prof["short"]:      # the default must not point at a profile that is gone
        rest = [p["short"] for p in profiles if p["uuid"] != prof["uuid"]]
        vpn_set_default(args, rest[0] if len(rest) == 1 else "")
        print("[vpn] default: " + (f"now {rest[0]} (the only one left)" if len(rest) == 1 else "cleared"))
    return VPN_EXIT["ok"]


def vpn_rename(args):
    if not args.arg or not args.arg2:
        raise VpnError("usage: hyprdeb vpn rename OLD NEW")
    profiles = vpn_profiles()
    prof = vpn_pick(args, profiles, args.arg)
    new = vpn_check_name(args.arg2)
    if new == prof["short"]:
        raise VpnError(f"{prof['name']} already has that name")
    if any(p["short"] == new for p in profiles):
        raise VpnError(f"the profile {VPN_PREFIX + new} already exists", code=VPN_EXIT["exists"])
    was_on = prof["active"]
    if was_on:      # the interface name changes, so the tunnel goes down first
        rc, _, err = vpn_nm("connection", "down", "uuid", prof["uuid"])
        if rc != 0:
            raise VpnError(f"could not turn {prof['name']} off: {err or 'nmcli failed'}")
        for _ in range(10):
            if not os.path.isdir(f"/sys/class/net/{prof['iface']}"):
                break
            time.sleep(0.5)
    rc, _, err = vpn_nm("connection", "modify", "uuid", prof["uuid"], "connection.id", VPN_PREFIX + new, "connection.interface-name", "wg-" + new)
    if rc != 0:
        raise VpnError(f"could not rename {prof['name']}: {err or 'nmcli failed'}")
    rc, got, _ = vpn_nm("-g", "connection.id,connection.interface-name,connection.autoconnect", "connection", "show", "uuid", prof["uuid"])
    if got.split("\n")[:3] != [VPN_PREFIX + new, "wg-" + new, "no"]:
        raise VpnError("the renamed profile does not have the expected settings")
    print(f"renamed {prof['name']} to {VPN_PREFIX + new} (interface wg-{new})" + ("; it was turned off first, turn it on again if you want it" if was_on else ""))
    if vpn_settings(args).get("vpn.default") == prof["short"]:
        vpn_set_default(args, new)
        print(f"[vpn] default: now {new}")
    return VPN_EXIT["ok"]


def vpn_waybar_json(names):
    """The JSON line of the waybar custom/vpn module: empty (module hidden) while no hyprdeb-wg profile is active."""
    if not names:
        return json.dumps({"text": "", "class": "", "tooltip": ""})
    short = names[0][len(VPN_PREFIX):]
    return json.dumps({"text": chr(int("ed58", 16)), "class": "vpn", "tooltip": f"VPN {short} is on\nClick: open settings"}, ensure_ascii=False)


def vpn_waybar():
    print(vpn_waybar_json(vpn_active_names()))


VPN_FOLLOW_COALESCE_MS = 200       # NM sends a burst of property changes per up/down: one refresh after the burst
VPN_FOLLOW_PPID_SECONDS = 30       # backstop: exit when the original parent is gone


def vpn_follow(watch):
    """Long-running: print the waybar JSON line at start and again whenever the set of active hyprdeb-wg profiles changes
    (watch=True: print "changed" instead, and nothing at start). The event source is NetworkManager's D-Bus signal
    PropertiesChanged on /org/freedesktop/NetworkManager (property ActiveConnections): no polling, no root, ~0 CPU while idle.
    It never exits on a transient error (NM restarts are followed by the bus name watch). It DOES exit when its reader is gone
    (an idle follower writes nothing, so it would never notice by itself): PR_SET_PDEATHSIG, an error/hangup watch on stdout and a
    getppid() check every VPN_FOLLOW_PPID_SECONDS."""
    import ctypes
    ppid = os.getppid()
    try:
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)       # PR_SET_PDEATHSIG
    except OSError:
        pass
    if os.getppid() != ppid:      # the parent died before prctl took effect
        return 0

    def emit(names):
        try:
            print("changed" if watch else vpn_waybar_json(names), flush=True)
        except (BrokenPipeError, OSError):
            raise SystemExit(0)

    state = {"names": vpn_active_names()}
    if not watch:
        emit(state["names"])
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:             # no python3-gi or no system bus: keep the first line, stay quiet, still exit with the reader
        while os.getppid() == ppid:
            time.sleep(VPN_FOLLOW_PPID_SECONDS)
        return 0
    loop = GLib.MainLoop()
    timer = {"id": 0}

    def refresh():
        timer["id"] = 0
        names = vpn_active_names()
        if names != state["names"]:
            state["names"] = names
            emit(names)
        return False

    def schedule(*_):
        if timer["id"]:
            GLib.source_remove(timer["id"])
        timer["id"] = GLib.timeout_add(VPN_FOLLOW_COALESCE_MS, refresh)

    bus.signal_subscribe("org.freedesktop.NetworkManager", "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         "/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager", Gio.DBusSignalFlags.NONE, schedule)
    Gio.bus_watch_name_on_connection(bus, "org.freedesktop.NetworkManager", Gio.BusNameWatcherFlags.NONE, schedule, schedule)   # NM (re)started or went away
    GLib.io_add_watch(sys.stdout.fileno(), GLib.IO_ERR | GLib.IO_HUP, lambda *_: loop.quit() or False)
    GLib.timeout_add_seconds(VPN_FOLLOW_PPID_SECONDS, lambda: (loop.quit() if os.getppid() != ppid else None) or True)
    signal.signal(signal.SIGTERM, lambda *_: loop.quit())
    schedule()       # state may have changed between the first read and the subscription
    loop.run()
    return 0


def cmd_vpn(args):
    """hyprdeb vpn import FILE|-|pick-file|rename OLD NEW|on|off|status|list|remove|waybar [--follow]|watch. status exit: 0 off or traffic passes, 1 on but no traffic, 3 error; on: 6 another tunnel is already on (only one at a time); import: 4 profile exists, 5 pick-file cancelled."""
    try:
        if args.action == "waybar":
            return vpn_follow(False) if args.follow else (vpn_waybar() or 0)
        if args.action == "watch":
            return vpn_follow(True)
        if args.action == "import":
            return vpn_import(args)
        if args.action == "rename":
            return vpn_rename(args)
        if args.action == "pick-file":
            return vpn_pick_file()
        if args.action == "on":
            code = vpn_on(args)
        elif args.action == "off":
            code = vpn_off(args)
        elif args.action == "remove":
            return vpn_remove(args)
        elif args.action == "list":
            ps = vpn_profiles()
            d = vpn_settings(args).get("vpn.default")
            for p in ps:
                print(f"{p['short']}\t{'on' if p['active'] else 'off'}\t{'default' if p['short'] == d else ''}".rstrip("\t"))
            return 0
        else:
            st = vpn_status(args)
            if args.json:
                print(json.dumps(st, indent=2))
            else:
                print("\n".join(st["lines"]))
            return st["code"]
        if args.notify:
            notify("VPN", "on" if args.action == "on" else "off")
        return code
    except VpnError as e:
        if args.json and args.action == "status":
            print(json.dumps({"ok": False, "error": str(e), "code": VPN_EXIT["error"]}))
        else:
            print(f"hyprdeb: {e}", file=sys.stderr)
        if args.notify:
            notify("VPN: " + args.action + " failed", str(e), critical=True)
        return e.code


# ---------------------------------------------------------------- network status
# Read-only. The facts come from the kernel (`ip -j`, /sys/class/net), so they stay right when the backend changes
# (ifupdown today, NetworkManager later); only the backend name and the DNS source are looked up per backend.
# Nothing here needs root or changes anything. [network] in settings.toml has two optional keys (lan_dns_name, internet_check).

NET_EXIT = {"ok": 0, "check_failed": 1, "error": 3}
NET_DNS_NAME = "debian.org"            # a public name for the "DNS works" check
NET_INTERNET_DEFAULT = "1.1.1.1:443"   # an IP, so this check does not depend on DNS
NET_CHECK_TIMEOUT = 1.5                # seconds; all checks run in parallel, so the whole status takes about this at worst
NET_TEST_LAN_ENV = "HYPRDEB_NET_TEST_LAN_NAME"   # test only: overrides [network] lan_dns_name
NET_BACKENDS = (("NetworkManager", "NetworkManager.service"), ("systemd-networkd", "systemd-networkd.service"),
                ("ifupdown", "networking.service"))
NET_HINT = "To change IP/DNS: set ipv4_method (and the rest) under [network] in settings.toml, then run: hyprdeb net apply"


def net_ip(*args):
    r = subprocess.run(["ip", "-j", *args], capture_output=True, text=True, timeout=3)
    if r.returncode != 0:
        raise OSError(f"ip {' '.join(args)}: {r.stderr.strip() or 'failed'}")
    return json.loads(r.stdout or "[]")


def net_sys(ifname, name):
    try:
        with open(f"/sys/class/net/{ifname}/{name}") as f:
            return f.read().strip()
    except OSError:
        return None


def net_backend():
    """ifupdown / NetworkManager / systemd-networkd by which service is active; 'unknown' when none is."""
    r = subprocess.run(["systemctl", "is-active", *[u for _, u in NET_BACKENDS]], capture_output=True, text=True, timeout=3)
    for (name, _), state in zip(NET_BACKENDS, r.stdout.split()):
        if state == "active":
            return name
    return "unknown"


def net_dns_servers(path="/etc/resolv.conf"):
    """({'servers': [...], 'source': text}) from resolv.conf: a symlink names its target, else the 'Generated by X' header."""
    servers, source = [], "a plain file"
    try:
        if os.path.islink(path):
            source = "link to " + os.readlink(path)
        with open(path) as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[0] == "nameserver":
                    servers.append(parts[1])
                elif not source.startswith("link") and (m := re.match(r"#\s*Generated by (\S+)", line)):
                    source = "written by " + m.group(1)
    except OSError as e:
        source = f"unreadable ({e.strerror})"
    return {"servers": servers, "source": source}


def net_facts():
    """Uplink = the interface of the default route with the lowest metric (None without a default route)."""
    routes = [r for r in net_ip("route", "show", "default") if r.get("dev")]
    routes.sort(key=lambda r: r.get("metric", 0))
    links = {l["ifname"]: l for l in net_ip("link")}
    addrs = {a["ifname"]: a for a in net_ip("addr")}
    ifaces = []
    for name, l in links.items():
        if name == "lo":
            continue
        kind = "wifi" if os.path.isdir(f"/sys/class/net/{name}/wireless") else "ethernet"
        ifaces.append({"ifname": name, "kind": kind, "state": (l.get("operstate") or "UNKNOWN").lower(), "uplink": False})
    up = None
    if routes:
        r = routes[0]
        name = r["dev"]
        l, a = links.get(name, {}), addrs.get(name, {}).get("addr_info", [])
        speed = net_sys(name, "speed")
        speed = int(speed) if speed and re.fullmatch(r"\d+", speed) and int(speed) > 0 else None   # -1 or unreadable: n/a
        duplex = net_sys(name, "duplex")
        v4 = [x for x in a if x.get("family") == "inet"]
        proto = r.get("protocol")
        method = "DHCP" if proto == "dhcp" else "static" if proto in ("static", "boot", "kernel") else \
            "DHCP" if any(x.get("dynamic") for x in v4) else "unknown"
        up = {"ifname": name, "kind": "wifi" if os.path.isdir(f"/sys/class/net/{name}/wireless") else "ethernet",
              "link": (l.get("operstate") or "UNKNOWN").lower(), "mac": l.get("address"), "speed_mbps": speed,
              "duplex": duplex if duplex in ("full", "half") else None, "method": method, "gateway": r.get("gateway"),
              "ipv4": [{"addr": x["local"], "prefix": x["prefixlen"]} for x in v4],
              "ipv6": [{"addr": x["local"], "prefix": x["prefixlen"], "scope": x.get("scope")}
                       for x in a if x.get("family") == "inet6"]}
        for i in ifaces:
            i["uplink"] = i["ifname"] == name
    return up, ifaces


def net_timed(fn):
    """Run fn() in a daemon thread with a hard timeout: (result, ms); result None on timeout. getaddrinfo cannot be interrupted."""
    box, t0 = [], time.monotonic()
    t = threading.Thread(target=lambda: box.append(fn()), daemon=True)
    t.start()
    t.join(NET_CHECK_TIMEOUT)
    return (box[0] if box else None), int((time.monotonic() - t0) * 1000)


def net_check_dns(check_id, label, name):
    def look():
        try:
            return socket.getaddrinfo(name, None, socket.AF_INET)[0][4][0]
        except OSError:
            return ""
    res, ms = net_timed(look)
    if res:
        return {"id": check_id, "label": label, "state": "ok", "ms": ms, "detail": f"{name} -> {res}"}
    return {"id": check_id, "label": label, "state": "fail", "ms": ms,
            "detail": f"{name}: " + ("no answer within %.1f s" % NET_CHECK_TIMEOUT if res is None else "does not resolve")}


def net_check_gateway(gw):
    label = "Gateway"
    if not gw:
        return {"id": "gateway", "label": label, "state": "fail", "ms": 0, "detail": "no default route"}
    if not shutil.which("ping"):
        return {"id": "gateway", "label": label, "state": "unknown", "ms": 0, "detail": "ping is not installed"}
    t0 = time.monotonic()
    try:
        r = subprocess.run(["ping", "-c1", "-W1", gw], capture_output=True, timeout=NET_CHECK_TIMEOUT + 0.5)
        ok = r.returncode == 0
    except subprocess.TimeoutExpired:
        ok = False
    ms = int((time.monotonic() - t0) * 1000)
    return {"id": "gateway", "label": label, "state": "ok" if ok else "fail", "ms": ms,
            "detail": gw if ok else f"{gw} does not answer ping (ICMP may be blocked)"}


def net_check_internet(target):
    host, _, port = target.rpartition(":")

    def conn():
        try:
            socket.create_connection((host, int(port)), timeout=NET_CHECK_TIMEOUT - 0.3).close()
            return True
        except OSError:
            return False
    res, ms = net_timed(conn)
    return {"id": "internet", "label": "Internet", "state": "ok" if res else "fail", "ms": ms,
            "detail": f"TCP {target} " + ("connects (some route to the internet works)" if res else "does not connect")}


def net_checks(up, net_cfg):
    """All checks in parallel; returns them in a fixed order. Skipped = not configured (not a failure)."""
    lan = os.environ.get(NET_TEST_LAN_ENV) or net_cfg.get("network.lan_dns_name")
    target = net_cfg.get("network.internet_check") or NET_INTERNET_DEFAULT
    jobs = [lambda: net_check_gateway(up["gateway"] if up else None),
            lambda: net_check_dns("dns", "DNS", NET_DNS_NAME),
            (lambda: net_check_dns("lan_dns", "LAN DNS", lan)) if lan else
            (lambda: {"id": "lan_dns", "label": "LAN DNS", "state": "skipped", "ms": 0,
                      "detail": "not set (add lan_dns_name under [network] in settings.toml)"}),
            lambda: net_check_internet(target)]
    out = [None] * len(jobs)

    def run(i):
        out[i] = jobs[i]()
    ts = [threading.Thread(target=run, args=(i,), daemon=True) for i in range(len(jobs))]
    for t in ts:
        t.start()
    for t in ts:
        t.join(NET_CHECK_TIMEOUT + 1)
    return out


def net_text(st):
    up = st["uplink"]
    if up is None:
        lines = ["No default route: this machine has no network connection."]
    else:
        spd = "n/a" if up["speed_mbps"] is None else f"{up['speed_mbps']} Mb/s" + (f", {up['duplex']} duplex" if up["duplex"] else "")
        v4 = ", ".join(f"{a['addr']}/{a['prefix']}" for a in up["ipv4"]) or "none"
        v6 = ", ".join(f"{a['addr']}/{a['prefix']}" for a in up["ipv6"] if a["scope"] == "global") or \
            ("link-local only" if up["ipv6"] else "none")
        lines = [f"{up['ifname']} ({up['kind']}): link {up['link']}, speed {spd}",
                 f"MAC {up['mac']}", f"IPv4 {v4} ({up['method']})", f"IPv6 {v6}", f"Gateway {up['gateway']}"]
    d = st["dns"]
    lines.append("DNS " + (", ".join(d["servers"]) or "none") + f" ({d['source']})")
    lines.append(f"Managed by {st['backend']}")
    lines.append("")
    for c in st["checks"]:
        mark = {"ok": "OK  ", "fail": "FAIL", "skipped": "--  ", "unknown": "??  "}[c["state"]]
        t = f" ({c['ms']} ms)" if c["state"] in ("ok", "fail") else ""
        lines.append(f"{mark} {c['label']}: {c['detail']}{t}")
    lines.extend(st.get("warnings", []))
    return lines


def net_status(args):
    """Status dict for `net status` / the settings window. Raises OSError / SubprocessError / ValueError on a broken system."""
    warnings = []
    try:
        net_cfg = load_validated(args)["network"]
    except SettingsError as e:    # a broken settings.toml must not hide the network state
        net_cfg = {}
        warnings.append(f"settings.toml was ignored for the optional checks: {e}")
    t0 = time.monotonic()
    up, ifaces = net_facts()
    st = {"ok": True, "backend": net_backend(), "uplink": up, "interfaces": ifaces, "dns": net_dns_servers(),
          "checks": net_checks(up, net_cfg), "warnings": warnings, "hint": NET_HINT}
    failed = [c["id"] for c in st["checks"] if c["state"] == "fail"]
    st.update(failed=failed, code=NET_EXIT["check_failed" if failed else "ok"], total_ms=int((time.monotonic() - t0) * 1000))
    st["lines"] = net_text(st)
    st["vpn"] = [n[len(VPN_PREFIX):] for n in vpn_active_names()]   # hyprdeb vpn profiles that are on (the uplink above is unchanged: NM routes the tunnel through its own table)
    if st["vpn"]:
        st["lines"].append("VPN on: " + ", ".join(st["vpn"]) + "  (the internet check above goes through the tunnel; the LAN stays direct; see: hyprdeb vpn status)")
    st["pending"] = net_pending_info()
    diff = net_differs(args, net_cfg, up) if st["backend"] == "NetworkManager" else None
    st["settings_differ"] = bool(diff)
    st["profile"] = None
    if st["backend"] == "NetworkManager" and up is not None and up["kind"] == "ethernet":
        try:
            st["profile"] = (net_live("hyprdeb-" + up["ifname"])[1])
        except (OSError, subprocess.SubprocessError):
            pass
    if st["pending"]:
        st["lines"].append(f"A change is waiting for confirmation ({st['pending']['remaining']} s left): hyprdeb net confirm  /  hyprdeb net revert")
    if diff:
        st["lines"].append(diff)
    return st


def cmd_net(args):
    """hyprdeb net status [--json]. Exit 0 all checks OK (skipped ones do not count), 1 a check failed, 3 error. Read-only, no root.
    net apply / confirm / revert: see net_apply."""
    if args.action == "apply":
        return net_apply(args)
    if args.action in ("confirm", "revert"):
        try:
            return (net_confirm if args.action == "confirm" else net_revert)(args)
        except (OSError, SettingsError) as e:
            print(f"hyprdeb: error: {e}", file=sys.stderr)
            return NET_EXIT["error"]
    try:
        st = net_status(args)
    except (subprocess.SubprocessError, OSError, ValueError, KeyError) as e:
        if args.json:
            print(json.dumps({"ok": False, "error": str(e), "code": NET_EXIT["error"]}))
        else:
            print(f"hyprdeb: error: {e}", file=sys.stderr)
        return NET_EXIT["error"]
    if args.json:
        print(json.dumps(st, indent=2))
    else:
        print("\n".join(st["lines"]))
        print(NET_HINT)
    return st["code"]


# ---------------------------------------------------------------- change IPv4 settings through NetworkManager
# settings.toml [network] ipv4_method / ipv4_address / ipv4_gateway / dns -> the hyprdeb-<if> profile (and nothing else; never the DHCP
# client-id, never Wi-Fi). Every change is armed with an automatic revert FIRST: a token in /run/hyprdeb-net is read by the root
# service hyprdeb-net-guard (installed by ./install.sh --networkmanager), which puts the old values back at the deadline unless the
# token was removed (= confirmed). It survives a dead GUI, terminal or session. The token is data only: the guard validates it.

NET_GUARD_DIR = "/run/hyprdeb-net"
NET_TOKEN = NET_GUARD_DIR + "/pending.json"
NET_TIMEOUT = {"default": 60, "min": 10, "max": 300}
NET_PENDING_STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "hyprdeb", "net-pending.json")


def nmcli(*args, timeout=30):
    return subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)


def net_split(v):
    return [x.strip() for x in re.split(r"[,|]", v) if x.strip()]


def net_live(profile):
    """The profile's current ipv4 values as (old, spec): `old` is what the guard restores ({"method": "auto"|"manual", ...}); `spec`
    is the same in settings terms, or None when the profile uses something hyprdeb does not manage (several addresses, shared, ...)."""
    r = nmcli("-g", "ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns,ipv4.ignore-auto-dns", "connection", "show", profile)
    if r.returncode != 0:
        raise OSError(f"nmcli: {r.stderr.strip() or 'cannot read ' + profile}")
    lines = (r.stdout.split("\n") + [""] * 5)[:5]
    method, addrs, gw, dns, ign = (x.strip() for x in lines)
    old = {"method": method, "addresses": net_split(addrs), "gateway": gw if gw != "--" else "", "dns": net_split(dns),
           "ignore_auto_dns": ign == "yes"}
    if method == "auto" and not old["addresses"] and not old["gateway"]:
        spec = {"method": "dhcp", "address": None, "gateway": None, "dns": old["dns"] if old["ignore_auto_dns"] else []}
    elif method == "manual" and len(old["addresses"]) == 1 and old["gateway"]:
        spec = {"method": "static", "address": old["addresses"][0], "gateway": old["gateway"], "dns": old["dns"]}
    else:
        spec = None
    return old, spec


def net_modify_args(profile, spec):
    """nmcli arguments (a list, never a shell string) that make the profile's ipv4 match spec."""
    dns = ",".join(spec["dns"])
    if spec["method"] == "dhcp":
        return ["connection", "modify", profile, "ipv4.method", "auto", "ipv4.addresses", "", "ipv4.gateway", "",
                "ipv4.dns", dns, "ipv4.ignore-auto-dns", "yes" if spec["dns"] else "no"]
    return ["connection", "modify", profile, "ipv4.method", "manual", "ipv4.addresses", spec["address"], "ipv4.gateway", spec["gateway"],
            "ipv4.dns", dns, "ipv4.ignore-auto-dns", "no"]


def net_spec_text(spec):
    if spec is None:
        return "(settings hyprdeb does not manage)"
    dns = ", ".join(spec["dns"]) or "from DHCP"
    if spec["method"] == "dhcp":
        return f"DHCP, DNS: {dns}"
    return f"static {spec['address']} via {spec['gateway']}, DNS: {dns}"


def net_wanted(args, cfg):
    """The wanted spec: command-line overrides (all four or none are used together) or settings.toml; None = nothing configured."""
    ov = {"method": getattr(args, "method", None), "address": getattr(args, "address", None), "gateway": getattr(args, "gateway", None),
          "dns": getattr(args, "dns", None)}
    if any(v is not None for v in ov.values()):
        dns = [x.strip() for x in ov["dns"].split(",") if x.strip()] if ov["dns"] else []
        return net_validate_ipv4(ov["method"], ov["address"] or None, ov["gateway"] or None, dns), True
    return net_validate_ipv4(cfg.get("network.ipv4_method"), cfg.get("network.ipv4_address"), cfg.get("network.ipv4_gateway"),
                             cfg.get("network.dns")), False


def net_guard_ready():
    """None when the root guard is installed and listening, else the reason."""
    if not os.path.isdir(NET_GUARD_DIR):
        return f"{NET_GUARD_DIR} is missing"
    if not os.access(NET_GUARD_DIR, os.W_OK):
        return f"{NET_GUARD_DIR} is not writable for you (are you in the netdev group?)"
    if subprocess.run(["systemctl", "is-active", "--quiet", "hyprdeb-net-guard.path"]).returncode != 0:
        return "hyprdeb-net-guard.path is not active"
    return None


def net_token():
    """The pending token as a dict, None when nothing is pending."""
    try:
        with open(NET_TOKEN) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def net_token_write(doc):
    tmp = os.path.join(NET_GUARD_DIR, f".pending.{os.getpid()}")
    with open(tmp, "w") as f:
        json.dump(doc, f)
    os.chmod(tmp, 0o660)
    os.rename(tmp, NET_TOKEN)


def net_wait_ready(iface, spec, seconds=15):
    """Wait until the interface has the wanted address (static) or any address and a default route (DHCP)."""
    end = time.time() + seconds
    while time.time() < end:
        try:
            up, _ = net_facts()
        except (OSError, ValueError, subprocess.SubprocessError):
            up = None
        if up and up["ifname"] == iface and up["ipv4"] and up["gateway"] and (
                spec["method"] == "dhcp" or any(f"{a['addr']}/{a['prefix']}" == spec["address"] for a in up["ipv4"])):
            return True
        time.sleep(0.5)
    return False


def net_activate(iface, profile, spec, new_address=False, budget=25):
    """Make the running connection follow the modified profile: reapply (no reconnect) first, a full `up` if that is not enough.
    A static address that is new to this machine always takes the full `up`: only an activation runs the duplicate-address check
    (NetworkManager refuses an address that answers an ARP probe), a reapply is not documented to."""
    r = None
    if not new_address:
        r = nmcli("device", "reapply", iface, timeout=30)
        if r.returncode == 0 and net_wait_ready(iface, spec, 12):
            return "reapply"
    r2 = nmcli("-w", str(max(5, min(25, budget))), "connection", "up", profile, timeout=45)
    # success = the wanted address is really there (a `up` that returns 0 after a refused address, e.g. a duplicate, is not a success)
    if net_wait_ready(iface, spec, 5):
        return "reconnect"
    raise OSError("NetworkManager did not configure the new settings" +
                  (" (the address may already be in use on the network)" if spec["method"] == "static" else "") + ": " +
                  (r2.stderr.strip() or (r.stderr.strip() if r else "") or "no error text"))


def net_pending_info():
    t = net_token()
    if not t:
        return None
    return {"deadline": t.get("deadline"), "remaining": max(0, int(t.get("deadline", 0) - time.time())), "profile": t.get("profile")}


def net_differs(args, cfg, up):
    """(text or None): settings.toml wants something other than the live profile. Only a report, never a change."""
    try:
        spec, _ = net_wanted(argparse.Namespace(), cfg)
        if spec is None or up is None:
            return None
        _, live = net_live("hyprdeb-" + up["ifname"])
    except (SettingsError, OSError, subprocess.SubprocessError):
        return None
    if live == spec:
        return None
    return "settings.toml differs from the live profile (" + net_spec_text(live) + "): run hyprdeb net apply"


def net_apply(args):
    """hyprdeb net apply [--dry-run] [--timeout N] [--no-wait] [--json] [--method M --address A --gateway G --dns D]. Exit 0 applied (and
    confirmed, or pending with --no-wait), 1 applied but a check failed or reverted, 3 refused/error. Changes only the hyprdeb-<if> profile."""
    def out(doc, rc, text=None):
        if args.json:
            print(json.dumps(dict(doc, code=rc), indent=2))
        elif text:
            print(text)
        return rc

    try:
        cfg = load_validated(args)["network"]
        spec, overrides = net_wanted(args, cfg)
    except SettingsError as e:
        return out({"ok": False, "error": str(e)}, NET_EXIT["error"], f"hyprdeb: error: {e}")
    if spec is None:
        return out({"ok": True, "changed": False, "message": "no ipv4_method in [network]: nothing to apply"}, 0,
                   "[network] has no ipv4_method: nothing to apply (see README: Network)")
    timeout = args.timeout if args.timeout is not None else NET_TIMEOUT["default"]
    if not NET_TIMEOUT["min"] <= timeout <= NET_TIMEOUT["max"]:
        e = f"--timeout must be from {NET_TIMEOUT['min']} to {NET_TIMEOUT['max']} seconds"
        return out({"ok": False, "error": e}, NET_EXIT["error"], f"hyprdeb: error: {e}")
    try:
        backend = net_backend()
        if backend != "NetworkManager":
            e = f"the network is managed by {backend}, not NetworkManager: run ./install.sh --networkmanager first (docs/recovery.md)"
            return out({"ok": False, "error": e}, NET_EXIT["error"], f"hyprdeb: error: {e}")
        up, _ = net_facts()
        if up is None:
            raise OSError("no default route: cannot tell which interface is the uplink")
        if up["kind"] != "ethernet":
            raise OSError(f"the uplink {up['ifname']} is Wi-Fi: hyprdeb only manages the wired profile")
        iface, profile = up["ifname"], "hyprdeb-" + up["ifname"]
        if nmcli("-g", "NAME", "connection", "show").stdout.split("\n").count(profile) != 1:
            raise OSError(f"the NetworkManager profile {profile} does not exist: run ./install.sh --networkmanager")
        old, live = net_live(profile)
        if live is None:
            raise OSError(f"{profile} uses ipv4 settings hyprdeb does not manage (method {old['method']}, {len(old['addresses'])} addresses): change them with nmcli first")
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        return out({"ok": False, "error": str(e)}, NET_EXIT["error"], f"hyprdeb: error: {e}")
    doc = {"ok": True, "profile": profile, "old": live, "new": spec, "timeout": timeout}
    if live == spec:
        return out(dict(doc, changed=False), 0, f"Already as configured: {net_spec_text(spec)}")
    text = f"{profile}:\n  now:  {net_spec_text(live)}\n  new:  {net_spec_text(spec)}"
    if args.dry_run:
        return out(dict(doc, changed=False, dry_run=True), 0, text + f"\n(dry-run: nothing changed; a real run reverts by itself after {timeout} s unless confirmed)")
    why = net_guard_ready()
    if why:
        e = f"the automatic-revert guard is not ready ({why}): run ./install.sh --networkmanager once (it installs the guard); nothing was changed"
        return out(dict(doc, ok=False, error=e), NET_EXIT["error"], f"hyprdeb: error: {e}")
    if net_token():
        e = "another change is still waiting for confirmation: hyprdeb net confirm  or  hyprdeb net revert"
        return out(dict(doc, ok=False, error=e), NET_EXIT["error"], f"hyprdeb: error: {e}")
    if not args.json:
        print(text)
    deadline = int(time.time()) + timeout
    try:   # 1. arm the revert FIRST
        net_token_write({"version": 1, "profile": profile, "iface": iface, "deadline": deadline, "old": old})
        end = time.time() + 5
        while time.time() < end and subprocess.run(["systemctl", "is-active", "--quiet", "hyprdeb-net-guard.service"]).returncode != 0:
            time.sleep(0.2)
        if subprocess.run(["systemctl", "is-active", "--quiet", "hyprdeb-net-guard.service"]).returncode != 0:
            os.unlink(NET_TOKEN)
            raise OSError("the guard did not start: nothing was changed (journalctl -u hyprdeb-net-guard)")
        # 2. change the profile
        r = nmcli(*net_modify_args(profile, spec))
        if r.returncode != 0:
            os.unlink(NET_TOKEN)
            err = r.stderr.strip()
            hint = " (polkit refuses a remote or sessionless login: run it from the desktop session)" if "nsufficient" in err or "uthori" in err else ""
            raise OSError(f"nmcli modify failed: {err}{hint}")
        if overrides:
            os.makedirs(os.path.dirname(NET_PENDING_STATE), exist_ok=True)
            write_atomic(NET_PENDING_STATE, json.dumps({"set": {
                "network.ipv4_method": spec["method"], "network.ipv4_address": spec["address"] or "",
                "network.ipv4_gateway": spec["gateway"] or "", "network.dns": spec["dns"]}}))
        elif os.path.exists(NET_PENDING_STATE):
            os.unlink(NET_PENDING_STATE)
        have = {f"{a['addr']}/{a['prefix']}" for a in up["ipv4"]}
        how = net_activate(iface, profile, spec, new_address=spec["method"] == "static" and spec["address"] not in have,
                           budget=int(deadline - time.time()) - 4)    # 3. apply it
        end = time.time() + 6                       # resolv.conf follows the reapply by a moment: the status below must show it
        while spec["dns"] and time.time() < end and net_dns_servers()["servers"][:len(spec["dns"])] != spec["dns"]:
            time.sleep(0.3)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        if net_token():          # it may have changed something: ask the guard to put it back now
            net_revert_now()
        return out(dict(doc, ok=False, error=str(e)), NET_EXIT["error"], f"hyprdeb: error: {e}; the old settings are being restored")
    st = net_status(args)
    doc.update(changed=True, applied_by=how, deadline=deadline, status=st)
    code = st["code"]
    if args.no_wait or not sys.stdin.isatty() or args.json:
        msg = "\n".join(st["lines"]) + f"\n\nApplied ({how}). Without `hyprdeb net confirm` it reverts by itself in {timeout} s."
        return out(doc, code, msg)
    print("\n".join(st["lines"]))
    print(f"\nApplied ({how}). " + ("A check FAILED: answer n (or just wait). " if code else "") + f"Keep it? [y/N] (reverts by itself in {timeout} s) ", end="", flush=True)
    import select
    ans = ""
    r, _, _ = select.select([sys.stdin], [], [], max(1, deadline - time.time() - 2))
    if r:
        ans = sys.stdin.readline().strip().lower()
    print()
    if ans in ("y", "yes"):
        return net_confirm(args, quiet=False) or code
    print("Reverting...")
    return net_revert(args) or 1


def net_confirm(args, quiet=False):
    """Keep the pending change: remove the token (the guard sees it and does nothing); write the values into settings.toml when
    they came from overrides. Exit 0 kept, 1 nothing pending, 3 error."""
    t = net_token()
    if not t:
        if os.path.exists(NET_PENDING_STATE):
            os.unlink(NET_PENDING_STATE)
        print("Nothing is waiting for confirmation (already confirmed, or it was reverted).", file=sys.stderr)
        return 1
    try:
        os.unlink(NET_TOKEN)
    except OSError as e:
        print(f"hyprdeb: error: cannot confirm: {e}", file=sys.stderr)
        return NET_EXIT["error"]
    msg = "Kept: the new network settings stay."
    if os.path.exists(NET_PENDING_STATE):
        try:
            with open(NET_PENDING_STATE) as f:
                sets = json.load(f)["set"]
            pairs = []
            try:
                known = load_validated(args)["network"]
            except SettingsError:
                known = {}
            for k, v in sets.items():
                if v in ("", []) and k not in known:     # nothing to clear: do not write an empty key
                    continue
                pairs += [k, ",".join(v) if isinstance(v, list) else v]
            st_path = getattr(args, "settings", None)
            cmd_set(argparse.Namespace(pairs=pairs, settings=os.path.abspath(st_path) if st_path else None, out=None, dry_run=False))
            msg += f" Saved in {SETTINGS_FRIENDLY}."
        except (SettingsError, OSError, ValueError, KeyError) as e:
            msg += f" (could not save them in settings.toml: {e})"
        finally:
            os.path.exists(NET_PENDING_STATE) and os.unlink(NET_PENDING_STATE)
    print(msg)
    return 0


def net_revert_now():
    """Move the token's deadline to now: the guard restores the old values at once. True when the token is gone afterwards."""
    t = net_token()
    if not t:
        return False
    t["deadline"] = int(time.time()) - 1
    try:
        net_token_write(t)
    except OSError:
        return False
    end = time.time() + 40
    while time.time() < end and os.path.exists(NET_TOKEN):
        time.sleep(0.3)
    return not os.path.exists(NET_TOKEN)


def net_revert(args):
    """Go back to the old settings now. Exit 0 reverted, 1 nothing pending, 3 error."""
    if not net_token():
        print("Nothing is waiting for confirmation (already confirmed, or it was reverted).", file=sys.stderr)
        return 1
    if os.path.exists(NET_PENDING_STATE):
        os.unlink(NET_PENDING_STATE)
    if net_revert_now():
        print("Reverted: the previous network settings are back.")
        return 0
    print("hyprdeb: error: the guard did not finish the revert in 40 s: journalctl -u hyprdeb-net-guard", file=sys.stderr)
    return NET_EXIT["error"]


# ---------------------------------------------------------------- do not disturb

def cmd_dnd(args):
    """hyprdeb dnd on|off|toggle|status|sync|waybar. on/off/toggle go through `set` (settings.toml keeps the value, mako's
    mode follows at once); status prints the live mode; sync re-applies settings.toml's value (run at login, because
    mako forgets its modes when it restarts); waybar prints the JSON for the custom/dnd module."""
    act = args.action
    if act == "waybar":
        live = live_dnd()
        if live:
            print(json.dumps({"text": (icon("dnd") + " " if icon("dnd") else "") + "DND", "class": "dnd",
                              "tooltip": "Do not disturb is on (SUPER+ALT+N)"}))
        else:
            print(json.dumps({"text": "", "class": "off", "tooltip": ""}))
        return 0
    if act == "status":
        live = live_dnd()
        if live is None:
            print("mako is not running", file=sys.stderr)
            return 1
        print("on" if live else "off")
        return 0
    if act == "sync":
        # mako starts a moment after the compositor: wait for it (the login autostart runs this).
        deadline = time.time() + 10
        while live_dnd() is None and time.time() < deadline:
            time.sleep(0.5)
        st = load_validated(args)
        msg = sync_dnd(st["notifications"]["dnd"])
        signal_waybar_dnd()
        if msg:
            print(msg)
        return 0
    live = live_dnd()
    if live is None:
        raise SettingsError("mako is not running")
    want = {"on": True, "off": False, "toggle": not live}[act]
    args.pairs, args.dry_run, args.out = ["notifications.dnd", "true" if want else "false"], False, None
    return cmd_set(args)


def cmd_restore(args):
    """Bring back the last dismissed/expired notification. Plain `makoctl restore` segfaults mako 1.10.0 when that
    notification was created while do-not-disturb hid it and the mode is off by now (reproduced in an isolated mako).
    Restoring while the mode is on is safe, and turning the mode off afterwards shows it normally, so for exactly those
    (ids recorded when the mode went off) do that; everything else is a plain restore."""
    live = live_dnd()
    if live is None:
        raise SettingsError("mako is not running")
    if live:
        raise SettingsError("do not disturb is on: turn it off first (SUPER+ALT+N), then restore")
    hist = mako_ids("history")
    st = dnd_state()
    top = hist[0] if hist else None
    hidden = top is not None and top in st.get("hidden", []) and top not in st.get("done", [])
    if hidden:
        makoctl("mode", "-a", DND_MODE)
        try:
            rc, out = makoctl("restore")
        finally:
            makoctl("mode", "-r", DND_MODE)
        if rc == 0:
            st["done"] = st.get("done", []) + [top]
            try:
                write_atomic(DND_STATE, json.dumps(st))
            except OSError:
                pass
    else:
        rc, out = makoctl("restore")
    time.sleep(0.4)   # the segfault can come just after makoctl got its reply
    if rc != 0 or live_dnd() is None:
        # mako is started again by D-Bus activation (the next makoctl call) but forgets its modes: put them back.
        deadline = time.time() + 5
        while live_dnd() is None and time.time() < deadline:
            time.sleep(0.3)
        try:
            sync_dnd(load_validated(args)["notifications"]["dnd"])
        except SettingsError:
            pass
        notify("hyprdeb: restore crashed mako", "mako 1.10.0 crashed restoring that notification (a known mako restore bug); "
               "it was restarted and do-not-disturb re-applied.", critical=True)
        raise SettingsError(f"makoctl restore failed: {out}")
    return 0


# ---------------------------------------------------------------- quick menu (fuzzel)

MENU_DURATIONS = ("5m", "10m", "15m", "30m", "off")


def notify(title, body, critical=False):
    cmd = ["notify-send", "-a", "hyprdeb"] + (["-u", "critical"] if critical else []) + [title, body]
    if shutil.which("notify-send"):
        subprocess.run(cmd, capture_output=True)
    else:
        print(f"{title}: {body}", file=sys.stderr)


def fuzzel_pick(prompt, items, icons=None):
    """Show `items` in fuzzel (dmenu mode); return the chosen item, or None on Esc / error.
    icons: {item: meaning from ICONS} puts that glyph in front of the line (only when the icon font is installed; the font is then
    named explicitly in --font). HYPRDEB_FUZZEL overrides the command (test hook)."""
    base = shlex.split(os.environ.get("HYPRDEB_FUZZEL", "fuzzel"))
    lines = {}
    for it in items:
        g = icon(icons[it]) if icons and it in icons else ""
        lines[(g + "  " + it) if g else it] = it
    font = ["--font", "monospace," + ICON_FONT_FC] if any(l != i for l, i in lines.items()) else []
    argv = base + ["--dmenu", "--prompt", prompt + " ", "--lines", str(min(len(items), 12)), "--width", "34"] + font
    try:
        r = subprocess.run(argv, input="\n".join(lines) + "\n", capture_output=True, text=True)
    except FileNotFoundError:
        notify("hyprdeb menu", f"{base[0]} is not installed", critical=True)
        return None
    if r.returncode != 0:
        return None
    return lines.get(r.stdout.rstrip("\n"))


def menu_run(argv, wait=False):
    """Run a command detached, or only print it when HYPRDEB_MENU_DRY is set. wait=True is for quick commands
    (systemctl, the log-out dispatch): their failure (e.g. polkit refusing from a non-local session) is shown as a
    notification instead of being lost."""
    if os.environ.get("HYPRDEB_MENU_DRY"):
        print("DRY: " + shlex.join(argv))
        return
    if wait:
        try:
            r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=15)
        except subprocess.TimeoutExpired:
            return  # e.g. `systemctl suspend` only returns after the machine woke up again
        except FileNotFoundError:
            notify(f"hyprdeb: {argv[0]} not found", shlex.join(argv), critical=True)
            return
        out = (r.stdout + r.stderr).strip()
        if r.returncode != 0 or (argv[0] == "hyprctl" and out and out != "ok"):
            notify(f"hyprdeb: {argv[0]} failed", out[:300] or f"exit code {r.returncode}", critical=True)
        return
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def menu_set(key, value):
    """`hyprdeb set KEY VALUE` as a child process; the result (or the error) goes to a notification."""
    argv = [sys.executable, os.path.abspath(sys.argv[0]), "set", key, value]
    if os.environ.get("HYPRDEB_MENU_DRY"):
        print("DRY: " + shlex.join(argv))
        return
    r = subprocess.run(argv, capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode == 0:
        notify("hyprdeb", f"{key} = {value}")
    else:
        lines = [l for l in out.splitlines() if l.strip()]
        err = next((l for l in lines if "error" in l), lines[-1] if lines else "failed")
        notify(f"hyprdeb: {key} not changed", err.replace("hyprdeb: error: ", ""), critical=True)


def menu_confirm(label):
    return fuzzel_pick(f"{label}?", ["Cancel", f"Yes, {label}"]) == f"Yes, {label}"


def wallpaper_candidates():
    """(folder, image names): ~/Pictures/Wallpapers, or ~/Pictures when that folder is missing or has no usable images.
    If neither has images, the first folder that exists (with no names); (None, []) when neither exists."""
    first_existing = None
    for d in (os.path.join(HOME, "Pictures", "Wallpapers"), os.path.join(HOME, "Pictures")):
        if os.path.isdir(d):
            first_existing = first_existing or d
            names = sorted(n for n in os.listdir(d)
                           if n.lower().endswith(WALLPAPER_EXTS) and os.path.isfile(os.path.join(d, n))
                           and not any(c in n for c in "#$\r\n"))
            if names:
                return d, names
    return first_existing, []


def menu_settings():
    try:
        eff = effective(validate(load(DEFAULT_SETTINGS, False)))
    except SettingsError as e:
        notify("hyprdeb: settings.toml is invalid", str(e), critical=True)
        return
    wall = os.path.basename(eff["wallpaper.path"])
    labels = {
        f"Lock after: {eff['idle.lock_after']}": "idle.lock_after",
        f"Screen off after: {eff['idle.screen_off_after']}": "idle.screen_off_after",
        f"Wallpaper: {wall}": "wallpaper.path",
        f"Keyboard toggle: {eff['keyboard.toggle']}": "keyboard.toggle",
    }
    label_icons = dict(zip(labels, ("lock", "monitor-off", "wallpaper", "keyboard")), **{"Settings app\u2026": "settings", "Shortcuts\u2026": "keyboard", "Back": "back"})
    choice = fuzzel_pick("Settings", ["Settings app\u2026", "Shortcuts\u2026"] + list(labels) + ["Back"], label_icons)
    if choice is None:
        return
    if choice == "Back":
        return menu_main()
    if choice == "Settings app\u2026":
        if os.environ.get("HYPRDEB_MENU_DRY"):
            print("DRY: " + shlex.join([sys.executable, os.path.abspath(sys.argv[0]), "gui"]))
            return
        try:
            cmd_gui(None)
        except SettingsError as e:   # the menu runs detached: stderr would be invisible
            notify("hyprdeb: settings window did not open", str(e), critical=True)
        return
    if choice == "Shortcuts\u2026":
        if os.environ.get("HYPRDEB_MENU_DRY"):
            print("DRY: " + shlex.join([sys.executable, os.path.abspath(sys.argv[0]), "gui", "--page", "shortcuts"]))
            return
        try:
            cmd_gui(argparse.Namespace(page="shortcuts"))
        except SettingsError as e:
            notify("hyprdeb: shortcuts window did not open", str(e), critical=True)
        return
    key = labels[choice]
    if key in ("idle.lock_after", "idle.screen_off_after"):
        cur = eff[key]
        items = [d + (" (current)" if d == cur else "") for d in MENU_DURATIONS]
        pick = fuzzel_pick(choice.split(":")[0], items)
        if pick:
            menu_set(key, pick.replace(" (current)", ""))
    elif key == "keyboard.toggle":
        cur = eff[key]
        items = [t + (" (current)" if t == cur else "") for t in TOGGLES]
        pick = fuzzel_pick("Keyboard toggle", items)
        if pick:
            menu_set(key, pick.replace(" (current)", ""))
    else:
        d, names = wallpaper_candidates()
        default = DEFAULTS["wallpaper.path"]
        items = ["Default wallpaper"] + names
        if d is None:
            notify("hyprdeb", "no ~/Pictures folder: only the default wallpaper is offered")
        pick = fuzzel_pick("Wallpaper", items)
        if pick == "Default wallpaper":
            menu_set(key, default)
        elif pick:
            menu_set(key, os.path.join(d, pick))


def menu_main():
    lock = os.path.join(HOME, ".local", "bin", "hyprdeb-lock")
    # Same logic as Debian's default SUPER+M bind: hyprshutdown when installed, else the Lua exit dispatcher.
    logout = ["hyprshutdown"] if shutil.which("hyprshutdown") else ["hyprctl", "dispatch", "hl.dsp.exit()"]
    items = {
        "Lock": lambda: menu_run([lock]),
        "Suspend": lambda: menu_run(["systemctl", "suspend"], wait=True),
        "Log out": lambda: menu_confirm("Log out") and menu_run(logout, wait=True),
        "Reboot": lambda: menu_confirm("Reboot") and menu_run(["systemctl", "reboot"], wait=True),
        "Power off": lambda: menu_confirm("Power off") and menu_run(["systemctl", "poweroff"], wait=True),
        "Bluetooth": lambda: menu_run(["blueman-manager"]),
        "Audio": lambda: menu_run(["pavucontrol"]),
        "Settings \u25b8": menu_settings,
    }
    dnd = live_dnd()
    if dnd is not None:
        items = {f"Do not disturb: {'turn off' if dnd else 'turn on'}":
                 lambda: menu_set("notifications.dnd", "false" if dnd else "true"), **items}
    try:
        vp = vpn_profiles()
    except VpnError:
        vp = []
    if vp:   # only when a profile has been imported
        on = any(p["active"] for p in vp)
        label = f"VPN: {'turn off' if on else 'turn on'}"     # `vpn on` without a name uses [vpn] default (chosen in the settings window) or the only profile
        items = {label: lambda: menu_run([sys.executable, os.path.abspath(sys.argv[0]), "vpn", "off" if on else "on", "--notify"]), **items}
    menu_icons = {"Lock": "lock", "Suspend": "sleep", "Log out": "logout", "Reboot": "reboot", "Power off": "power",
                  "Bluetooth": "bluetooth", "Audio": "volume", "Settings \u25b8": "settings"}
    menu_icons.update({k: "dnd" for k in items if k.startswith("Do not disturb")})
    menu_icons.update({k: "vpn" for k in items if k.startswith("VPN:")})
    choice = fuzzel_pick("hyprdeb", list(items), menu_icons)
    if choice:
        items[choice]()


def cmd_menu(args):
    menu_main()
    return 0


# Keyboard shortcuts: `hyprdeb keys` lists the live binds from `hyprctl binds -j`. On 0.55.2 every Lua bind reports the
# dispatcher "__lua" (arg is only an internal index), so the live data says what the key is, never what it does. The text comes
# from the bind's own description (hl.bind(..., { description = "Group: text" }), used by every bind of our fragments) or, for
# Debian's default binds, from DEFAULT_KEYS below, keyed by "MODS|key". Anything else is still listed, as "(no description)".
KEY_GROUPS = (("Windows", "window"), ("Workspaces", "workspace"), ("Apps", "apps"), ("System", "power"),
              ("Clipboard", "clipboard"), ("Notifications", "bell"), ("Screenshots", "camera"), ("Other", "other"))
MOD_BITS = (("SUPER", 64), ("CTRL", 4), ("ALT", 8), ("SHIFT", 1))
KEY_LABELS = {"slash": "/", "Escape": "Esc", "left": "Left", "right": "Right", "up": "Up", "down": "Down",
              "mouse_down": "Scroll down", "mouse_up": "Scroll up", "mouse:272": "Left mouse button",
              "mouse:273": "Right mouse button", "mouse:274": "Middle mouse button",
              "XF86AudioRaiseVolume": "Volume Up key", "XF86AudioLowerVolume": "Volume Down key", "XF86AudioMute": "Mute key",
              "XF86AudioMicMute": "Mic Mute key", "XF86MonBrightnessUp": "Brightness Up key",
              "XF86MonBrightnessDown": "Brightness Down key", "XF86AudioNext": "Media Next key",
              "XF86AudioPrev": "Media Previous key", "XF86AudioPlay": "Media Play key", "XF86AudioPause": "Media Pause key"}
DEFAULT_KEYS = {
    "SUPER|Q": ("Apps", "Open the terminal"), "SUPER|E": ("Apps", "Open the file manager"),
    "SUPER|R": ("Apps", "Open the app launcher"),
    "SUPER|C": ("Windows", "Close the window"), "SUPER|P": ("Windows", "Pseudo-tile the window"),
    "SUPER|J": ("Windows", "Switch the split direction"), "SUPER|M": ("System", "Quit Hyprland (log out)"),
    "SUPER|left": ("Windows", "Focus the window on the left"), "SUPER|right": ("Windows", "Focus the window on the right"),
    "SUPER|up": ("Windows", "Focus the window above"), "SUPER|down": ("Windows", "Focus the window below"),
    "SUPER|S": ("Workspaces", "Show or hide the scratchpad"), "SUPER+SHIFT|S": ("Workspaces", "Move the window to the scratchpad"),
    "SUPER|mouse_down": ("Workspaces", "Next workspace"), "SUPER|mouse_up": ("Workspaces", "Previous workspace"),
    "SUPER|mouse:272": ("Windows", "Move the window (drag)"), "SUPER|mouse:273": ("Windows", "Resize the window (drag)"),
    "|XF86AudioRaiseVolume": ("System", "Raise the volume"), "|XF86AudioLowerVolume": ("System", "Lower the volume"),
    "|XF86AudioMute": ("System", "Mute or unmute the speakers"), "|XF86AudioMicMute": ("System", "Mute or unmute the microphone"),
    "|XF86MonBrightnessUp": ("System", "Screen brightness up"), "|XF86MonBrightnessDown": ("System", "Screen brightness down"),
    "|XF86AudioNext": ("System", "Next track"), "|XF86AudioPrev": ("System", "Previous track"),
    "|XF86AudioPlay": ("System", "Play or pause"), "|XF86AudioPause": ("System", "Play or pause"),
}
for _n in range(10):
    DEFAULT_KEYS[f"SUPER|{_n}"] = ("Workspaces", f"Go to workspace {_n or 10}")
    DEFAULT_KEYS[f"SUPER+SHIFT|{_n}"] = ("Workspaces", f"Move the window to workspace {_n or 10}")


def key_list():
    """Every live bind as a dict, grouped. Each bind appears exactly once; unknown ones are kept, never hidden."""
    try:
        binds = json.loads(hyprctl("binds", "-j") or "[]")
    except ValueError as e:
        raise SettingsError(f"hyprctl binds -j did not return JSON: {e}")
    names = [g for g, _ in KEY_GROUPS]
    out = []
    for b in binds:
        mods = [n for n, bit in MOD_BITS if b.get("modmask", 0) & bit]
        key = b.get("key") or (f"code:{b['keycode']}" if b.get("keycode") else "?")
        group, text, source = "Other", "(no description)", "none"
        desc = (b.get("description") or "").strip()
        if desc:
            head, sep, rest = desc.partition(": ")
            if sep and head in names:
                group, text = head, rest
            else:
                text = desc
            source = "description"
        elif f"{'+'.join(mods)}|{key}" in DEFAULT_KEYS:
            group, text = DEFAULT_KEYS[f"{'+'.join(mods)}|{key}"]
            source = "map"
        label = KEY_LABELS.get(key, key.upper() if len(key) == 1 else key)
        flags = [n for n in ("locked", "repeat", "release", "longPress") if b.get(n)]
        out.append({"keys": " + ".join(mods + [label]), "mods": mods, "key": key, "text": text, "group": group,
                    "source": source, "mouse": bool(b.get("mouse")) or key.startswith("mouse"), "submap": b.get("submap") or "",
                    "flags": flags})
    return out


def layout_char_map(layouts, variants):
    """{character typed with another layout: Latin character on the same physical key}, derived from the installed xkb data
    through libxkbcommon (the same keymap Hyprland builds from [keyboard]), never typed by hand. The first layout is the Latin
    one (validated in settings). Used by the shortcuts search so Persian letters typed by mistake still find the Latin text."""
    import ctypes
    import ctypes.util
    lib = ctypes.CDLL(ctypes.util.find_library("xkbcommon") or "libxkbcommon.so.0")

    class Names(ctypes.Structure):
        _fields_ = [(n, ctypes.c_char_p) for n in ("rules", "model", "layout", "variant", "options")]

    lib.xkb_context_new.restype = ctypes.c_void_p
    lib.xkb_keymap_new_from_names.restype = ctypes.c_void_p
    lib.xkb_keymap_new_from_names.argtypes = [ctypes.c_void_p, ctypes.POINTER(Names), ctypes.c_int]
    lib.xkb_keymap_min_keycode.argtypes = lib.xkb_keymap_max_keycode.argtypes = [ctypes.c_void_p]
    lib.xkb_keymap_num_layouts.argtypes = [ctypes.c_void_p]
    lib.xkb_keymap_key_get_syms_by_level.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32,
                                                     ctypes.POINTER(ctypes.POINTER(ctypes.c_uint32))]
    lib.xkb_keysym_to_utf32.restype = ctypes.c_uint32
    ctx = lib.xkb_context_new(0)
    names = Names(None, None, ",".join(layouts).encode(), ",".join(variants).encode(), None)
    km = lib.xkb_keymap_new_from_names(ctypes.c_void_p(ctx), ctypes.byref(names), 0)
    if not km:
        return {}
    km = ctypes.c_void_p(km)

    def char(code, layout, level):
        syms = ctypes.POINTER(ctypes.c_uint32)()
        if lib.xkb_keymap_key_get_syms_by_level(km, code, layout, level, ctypes.byref(syms)) != 1:
            return ""
        cp = lib.xkb_keysym_to_utf32(syms[0])
        return chr(cp) if cp and chr(cp).isprintable() else ""

    out = {}
    for lay in range(1, lib.xkb_keymap_num_layouts(km)):
        for code in range(lib.xkb_keymap_min_keycode(km), lib.xkb_keymap_max_keycode(km) + 1):
            for level in (0, 1):
                other, latin = char(code, lay, level), char(code, 0, level)
                if other and latin and ord(other) > 127 and other != latin and other not in out:   # ASCII stays as typed
                    out[other] = latin
    return out


def cmd_keys(args):
    if not in_hyprland():
        raise SettingsError("not inside a running Hyprland session")
    binds = key_list()
    groups = []
    for name, ic in KEY_GROUPS:
        items = [{k: v for k, v in b.items() if k != "group"} for b in binds if b["group"] == name]
        if items:
            groups.append({"name": name, "icon": icon(ic), "binds": items})
    if args.json:
        try:
            eff = effective(load_validated(args))
            lmap = layout_char_map(eff["keyboard.layouts"], eff["keyboard.variants"])
        except (SettingsError, OSError, ValueError, AttributeError):
            lmap = {}   # the search still works with the typed text; only the other-layout mapping is lost
        print(json.dumps({"ok": True, "count": len(binds), "groups": groups, "search_icon": icon("search"),
                          "layout_map": lmap}, ensure_ascii=False))
        return 0
    for g in groups:
        print(f"{g['name']}")
        width = max(len(b["keys"]) for b in g["binds"])
        for b in g["binds"]:
            print(f"  {b['keys']:<{width}}  {b['text']}")
        print()
    print(f"{len(binds)} shortcuts")
    return 0



GUI_QML = os.path.join(HOME, ".local", "share", "hyprdeb", "gui", "shell.qml")
GUI_TITLE = "hyprdeb settings"
KEYS_QML = os.path.join(HOME, ".local", "share", "hyprdeb", "gui", "keys.qml")
KEYS_TITLE = "hyprdeb shortcuts"
GUI_SECTIONS = ("network", "vpn", "nas", "printers", "monitors", "wallpaper", "idle", "keyboard", "mouse", "notifications", "fonts")   # sidebar order
GUI_PAGES = {"settings": (GUI_QML, GUI_TITLE), "shortcuts": (KEYS_QML, KEYS_TITLE), **{s: (GUI_QML, GUI_TITLE) for s in GUI_SECTIONS}}
GUI_PAGE_FILE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "hyprdeb", "gui-page")


def gui_last_page():
    """The page the settings window had when it was last used (a line in GUI_PAGE_FILE), or None: unknown, missing or unreadable."""
    try:
        name = open(GUI_PAGE_FILE, encoding="utf-8").read().strip()
    except OSError:
        return None
    return name if name in GUI_SECTIONS else None


def cmd_gui(args):
    """Open the settings window (Quickshell), or with --page shortcuts the shortcuts list. --page NAME (a section: network, vpn, ...)
    opens the settings window on that page, or switches an open one (qs ipc); without it a new window opens on the last page used.
    Single instance per window: an open window is focused instead of a second one (`qs -n` is the backstop for two quick starts)."""
    page = getattr(args, "page", None) or "settings"
    gui_qml, gui_title = GUI_PAGES[page]
    qs = shutil.which("qs") or shutil.which("quickshell")
    if not qs:
        raise SettingsError("quickshell is not installed (sudo apt install -t trixie-backports quickshell)")
    if not os.path.isfile(gui_qml):
        raise SettingsError(f"{gui_qml} is missing; run: install.sh --config-only")
    if not in_hyprland():
        raise SettingsError("not inside a running Hyprland session")

    def find_window():
        for c in json.loads(hyprctl("clients", "-j") or "[]"):
            if c.get("class") == "org.quickshell" and c.get("title") == gui_title:
                return c
        return None

    # `qs -n` alone is not enough: two starts at the same moment both got a window (its instance record appears late).
    # So: hold a lock while checking and starting, until the new window exists; a second caller then finds it and focuses.
    import fcntl
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "hyprdeb-gui-shortcuts.lock" if page == "shortcuts" else "hyprdeb-gui.lock"), "w")
    deadline = time.time() + 15
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() > deadline:
                raise SettingsError("another `hyprdeb gui` is still starting")
            time.sleep(0.1)
    w = find_window()
    if w:
        if page in GUI_SECTIONS:     # switch the open window to that page
            hint = ("hyprdeb: this settings window is older than the installed version and cannot switch pages: close it and open it again "
                    f"(wanted page: {page})")
            try:
                r = subprocess.run([qs, "ipc", "-p", gui_qml, "call", "gui", "page", page], capture_output=True, text=True, timeout=5)
                failed = r.returncode != 0 or bool(r.stdout.strip())    # qs ipc exits 0 and prints "Target not found." when the window has no handler; page() prints nothing
            except subprocess.TimeoutExpired:     # a hung qs must not hang the caller (a waybar click)
                failed = True
            if failed:
                print(hint, file=sys.stderr)
        print(hyprctl("dispatch", f'hl.dsp.focus({{ window = "address:{w["address"]}" }})'))
        print(f"{'shortcuts' if page == 'shortcuts' else 'settings'} window already open: focused it")
        return 0
    env = dict(os.environ, HYPRDEB_BIN=os.path.abspath(sys.argv[0]))
    if gui_qml == GUI_QML:
        start = page if page in GUI_SECTIONS else gui_last_page()
        if start:
            env["HYPRDEB_PAGE"] = start
        os.makedirs(os.path.dirname(GUI_PAGE_FILE), exist_ok=True)    # the window writes the page it ends on here
        if page in GUI_SECTIONS:      # an explicit page counts as the last page used
            try:
                with open(GUI_PAGE_FILE, "w", encoding="utf-8") as f:
                    f.write(page + "\n")
            except OSError:
                pass
    proc = subprocess.Popen([qs, "-n", "-p", gui_qml], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.time() + 8
    while time.time() < deadline and not find_window():
        if proc.poll() not in (None, 0):
            raise SettingsError(f"quickshell exited with status {proc.returncode} before the window appeared "
                                f"(see: qs log -p {gui_qml})")
        time.sleep(0.2)
    return 0


def main():
    p = argparse.ArgumentParser(prog="hyprdeb", description="hyprdeb settings")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, out=False):
        sp.add_argument("--settings", help="settings file (default: " + SETTINGS_FRIENDLY + ")")
        if out:
            sp.add_argument("--out", help="generated Lua file; the other generated files go next to it "
                                          "(default: ~/.config/hypr/hyprdeb-settings.lua)")

    c = sub.add_parser("check", help="validate settings.toml and print what would be generated")
    common(c, True)
    c.set_defaults(fn=cmd_check)
    a = sub.add_parser("apply", help="generate the config files and reload Hyprland / restart hypridle, hyprpaper")
    a.add_argument("--dry-run", action="store_true", help="print a diff, write nothing")
    common(a, True)
    a.set_defaults(fn=cmd_apply)
    sh = sub.add_parser("show", help="effective settings (defaults filled in)")
    sh.add_argument("--json", action="store_true", help="one JSON object: settings, choices, wallpaper candidates, warnings")
    common(sh)
    sh.set_defaults(fn=cmd_show)
    g = sub.add_parser("get", help="print one effective value")
    g.add_argument("key")
    common(g)
    g.set_defaults(fn=cmd_get)
    nc = sub.add_parser("nas", help="NAS shares: status/mount/unmount/open [NAME] (status exit 0 mounted, 1 not mounted, 2 not set up, 3 error); "
                                    "add/edit/remove/test/migrate/list: manage them through the root helper (password: no-echo prompt or one stdin line)")
    nc.add_argument("action", choices=["status", "mount", "unmount", "open", *NAS_MANAGE_ACTIONS])
    nc.add_argument("name", nargs="?", help="the share (a-z 0-9 -, mounted on /mnt/NAME); default: the first one")
    nc.add_argument("--json", action="store_true", help="status/list/add/edit/remove/test: one JSON object")
    nc.add_argument("--server", help="add/edit/test: IPv4 address or host name")
    nc.add_argument("--share", help="add/edit/test: share name on the server")
    nc.add_argument("--username", help="add/edit/test: user name")
    nc.add_argument("--idle", help='add/edit: disconnect after this idle time ("10m", "1h", or "off"; default 10m)')
    nc.add_argument("--yes", action="store_true", help="remove: do not ask")
    nc.add_argument("--dry-run", action="store_true", help="add/edit/remove/install: say what would happen, change nothing")
    common(nc)
    nc.set_defaults(fn=cmd_nas_ctl)
    ne = sub.add_parser("net", help="network: status (read-only; exit 0 all checks OK, 1 a check failed, 3 error), apply the [network] IPv4 settings "
                                    "with an automatic revert, confirm, revert")
    ne.add_argument("action", choices=["status", "apply", "confirm", "revert"])
    ne.add_argument("--json", action="store_true", help="one JSON object")
    ne.add_argument("--dry-run", action="store_true", help="apply: show old -> new, change nothing")
    ne.add_argument("--timeout", type=int, help="apply: seconds until the automatic revert (10-300, default 60)")
    ne.add_argument("--no-wait", action="store_true", help="apply: do not ask here; confirm later with `net confirm` (used by the settings window)")
    ne.add_argument("--method", choices=["dhcp", "static"], help="apply: use this instead of settings.toml (saved there only when confirmed)")
    ne.add_argument("--address", help="apply: a.b.c.d/nn (static)")
    ne.add_argument("--gateway", help="apply: a.b.c.d (static)")
    ne.add_argument("--dns", help="apply: comma-separated DNS servers")
    common(ne)
    ne.set_defaults(fn=cmd_net)
    pr = sub.add_parser("print", help="printing: status of the [printing] queue (read-only; exit 0 fine, 1 a check failed, 3 error), jobs, cancel ID, testpage --yes, config (for install.sh)")
    pr.add_argument("action", choices=["status", "config", "jobs", "cancel", "testpage"])
    pr.add_argument("arg", nargs="?", help="cancel: the job number")
    pr.add_argument("--json", action="store_true", help="status, jobs: one JSON object")
    pr.add_argument("--yes", action="store_true", help="testpage: confirm that one sheet of paper is used")
    common(pr)
    pr.set_defaults(fn=cmd_print)
    vp = sub.add_parser("vpn", help="WireGuard through NetworkManager: import a .conf once, then on / off / status / list / remove (never at boot)")
    vp.add_argument("action", choices=["import", "pick-file", "rename", "on", "off", "status", "list", "remove", "waybar", "watch"])
    vp.add_argument("arg", nargs="?", help="import: the .conf file, or - for the text on stdin (needs --name); on, off, remove: the profile name")
    vp.add_argument("arg2", nargs="?", help="rename: the new name")
    vp.add_argument("--name", help="import: the profile name (1-11 characters a-z 0-9 -); default: from the file name")
    vp.add_argument("--replace", action="store_true", help="import: replace an existing profile of that name")
    vp.add_argument("--scrub-clipboard", action="store_true", help="import: afterwards remove the configuration from the clipboard history and clear the clipboard if it still holds it")
    vp.add_argument("--keep", action="store_true", help="on: leave the tunnel on even when no traffic gets through")
    vp.add_argument("--yes", action="store_true", help="remove: do not ask")
    vp.add_argument("--follow", action="store_true", help="waybar: keep running and print a line whenever the tunnel changes (the module's continuous exec)")
    vp.add_argument("--json", action="store_true", help="status: one JSON object")
    vp.add_argument("--notify", action="store_true", help="on, off: show the result as a notification (quick menu)")
    common(vp)
    vp.set_defaults(fn=cmd_vpn)
    dn = sub.add_parser("dnd", help="do not disturb (mako): on, off, toggle, status, sync, waybar")
    dn.add_argument("action", choices=["on", "off", "toggle", "status", "sync", "waybar"])
    common(dn)
    dn.set_defaults(fn=cmd_dnd)
    rs = sub.add_parser("restore", help="restore the last dismissed notification (safe around do-not-disturb)")
    common(rs)
    rs.set_defaults(fn=cmd_restore)
    mn = sub.add_parser("menu", help="fuzzel quick menu (power, apps, settings)")
    mn.set_defaults(fn=cmd_menu)
    gu = sub.add_parser("gui", help="open the settings window (Quickshell); focuses it if already open")
    gu.add_argument("--page", choices=["settings", "shortcuts", *GUI_SECTIONS], default="settings",
                    help="settings (default: the window, on the page last used), shortcuts (the keyboard shortcuts list), or a settings page: "
                         + ", ".join(GUI_SECTIONS))
    gu.set_defaults(fn=cmd_gui)
    ke = sub.add_parser("keys", help="list the keyboard shortcuts (live from hyprctl binds), grouped")
    ke.add_argument("--json", action="store_true", help="one JSON object: count, groups of binds, layout_map for the search")
    common(ke)
    ke.set_defaults(fn=cmd_keys)
    wl = sub.add_parser("wallpaper", help="wallpaper helpers: pick file|folder (desktop file chooser; exit 5 cancelled, 3 unavailable), "
                                         "monitor set MATCH [--path P --fit F --interval I] | monitor clear MATCH (per-monitor wallpaper)")
    wls = wl.add_subparsers(dest="action", required=True)
    wp_ = wls.add_parser("pick")
    wp_.add_argument("kind", choices=["file", "folder"])
    wm = wls.add_parser("monitor")
    wm.add_argument("op", choices=["set", "clear"])
    wm.add_argument("match", help='"desc:<description>" or an output name like DP-1')
    wm.add_argument("--path")
    wm.add_argument("--fit")
    wm.add_argument("--interval")
    wm.add_argument("--dry-run", action="store_true", help="show the diffs, write nothing")
    common(wm, True)
    wl.set_defaults(fn=cmd_wallpaper)
    s = sub.add_parser("set", help="change settings in settings.toml (comments kept), then apply")
    s.add_argument("--dry-run", action="store_true", help="show the diffs, write nothing")
    s.add_argument("pairs", nargs="+", metavar="KEY VALUE", help="e.g. idle.lock_after 10m  |  keyboard.layouts us,ir")
    common(s, True)
    s.set_defaults(fn=cmd_set)
    args = p.parse_args()
    try:
        return args.fn(args)
    except SettingsError as e:
        print(f"hyprdeb: error: {e}", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("hyprdeb: error: hyprctl timed out", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
